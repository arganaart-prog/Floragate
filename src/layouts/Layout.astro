---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import CustomerGallery from '../components/CustomerGallery.astro';
import { withBase } from '../utils/paths';
import { SITE_DOMAIN, WHATSAPP_NUMBER, INSTAGRAM_URL } from '../data/constants';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'product';
  schema?: Record<string, any>;
  robots?: string;
  showTestimonials?: boolean;
}

const { title, description, keywords, image, type = 'website', schema, robots, showTestimonials = true } = Astro.props;

// Default Schema: Florist di Malang
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "Florist",
  "name": "Floragate",
  "alternateName": ["Floragate Malang", "Toko Bunga Malang Murah dan Berkualitas", "Toko Bunga Murah Malang"],
  "description": "Floragate adalah toko bunga Malang murah dan berkualitas untuk bunga papan, standing flower, hand bouquet, dan rangkaian bunga segar dengan layanan cepat.",
  "slogan": "The Gateway to Meaningful Moments",
  "image": `${SITE_DOMAIN}/images/logo/logo%20Floragate%201.png`,
  "@id": `${SITE_DOMAIN}/#florist`,
  "url": SITE_DOMAIN,
  "telephone": `+${WHATSAPP_NUMBER}`,
  "priceRange": "Rp 250.000 - Rp 1.500.000",
  "areaServed": [
    { "@type": "City", "name": "Kota Malang" },
    { "@type": "AdministrativeArea", "name": "Kabupaten Malang" },
    { "@type": "City", "name": "Kota Batu" }
  ],
  "keywords": "Floragate, Floragate Malang, toko bunga Floragate, toko bunga Malang murah, toko bunga Malang berkualitas, florist Malang murah, karangan bunga Malang murah berkualitas",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Kota Malang, Jawa Timur",
    "addressLocality": "Malang",
    "addressRegion": "Jawa Timur",
    "postalCode": "65100",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -7.96662,
    "longitude": 112.63263
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
    ],
    "opens": "09:00",
    "closes": "23:00"
  },
  "sameAs": [
    INSTAGRAM_URL
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Katalog bunga murah dan berkualitas Floragate",
    "itemListElement": [
      { "@type": "OfferCatalog", "name": "Bunga papan Malang" },
      { "@type": "OfferCatalog", "name": "Standing flower Malang" },
      { "@type": "OfferCatalog", "name": "Hand bouquet Malang" },
      { "@type": "OfferCatalog", "name": "Bunga meja Malang" },
      { "@type": "OfferCatalog", "name": "Tanbulampot & pohon ucapan tanaman Malang" }
    ]
  }
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="id">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BK1L7D9N5D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BK1L7D9N5D');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={withBase('/favicon-transparent.png')} />
    <link rel="apple-touch-icon" href={withBase('/favicon-transparent.png')} />
    <meta name="generator" content={Astro.generator} />

    <SEOHead
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      type={type}
      schema={finalSchema}
      robots={robots}
    />
    <!-- Critical Anti-FOUC CSS: guarantees SVGs and icons remain strictly bounded on hard refresh before external styles finish parsing -->
    <style is:inline>
      svg {
        box-sizing: border-box;
        max-width: 100%;
        vertical-align: middle;
      }
      /* Pre-apply common utility sizes immediately upon first paint */
      svg.h-3, svg.w-3 { width: 0.75rem !important; height: 0.75rem !important; }
      svg.h-3\.5, svg.w-3\.5 { width: 0.875rem !important; height: 0.875rem !important; }
      svg.h-4, svg.w-4 { width: 1rem !important; height: 1rem !important; }
      svg.h-5, svg.w-5 { width: 1.25rem !important; height: 1.25rem !important; }
      svg.h-6, svg.w-6 { width: 1.5rem !important; height: 1.5rem !important; }
      svg.h-7, svg.w-7 { width: 1.75rem !important; height: 1.75rem !important; }
      svg.h-8, svg.w-8 { width: 2rem !important; height: 2rem !important; }
      svg.h-9, svg.w-9 { width: 2.25rem !important; height: 2.25rem !important; }
      svg.h-10, svg.w-10 { width: 2.5rem !important; height: 2.5rem !important; }
      svg.h-12, svg.w-12 { width: 3rem !important; height: 3rem !important; }
      svg.h-16, svg.w-16 { width: 4rem !important; height: 4rem !important; }

      /* Safe bounds for standalone button and link icons */
      a > svg:not([width]):not(#logo-shield svg),
      button > svg:not([width]):not(#logo-shield svg) {
        max-width: 1.5rem;
        max-height: 1.5rem;
      }

      /* Keep brand logo shield stable */
      #logo-shield svg {
        width: 100% !important;
        height: 100% !important;
      }
    </style>
    <noscript>
      <style>
        [data-image-loader] { opacity: 1 !important; transform: none !important; }
        .image-skeleton { display: none !important; }
      </style>
    </noscript>
  </head>
  <body class="flex flex-col min-h-screen bg-clean-ivory text-slate-800">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    {showTestimonials && <Testimonials />}
    {showTestimonials && <CustomerGallery />}
    <Footer />
    <script>
      function initImageLoaders() {
        document.querySelectorAll('[data-image-loader]').forEach(function(image) {
          if (!(image instanceof HTMLImageElement)) return;
          var frame = image.closest('[data-image-frame]');
          if (!frame) return;

          /** @param {string} className */
          function markReady(className) {
            frame.classList.remove('is-loading');
            frame.classList.add(className);
          }

          frame.classList.add('is-loading');

          if (image.complete && image.naturalWidth > 0) {
            markReady('is-loaded');
            return;
          }

          image.addEventListener('load', function() {
            markReady('is-loaded');
          }, { once: true });

          image.addEventListener('error', function() {
            markReady('is-error');
          }, { once: true });
        });
      }

      initImageLoaders();
      document.addEventListener('astro:page-load', initImageLoaders);
    </script>
  </body>
</html>

---
// ProductCard.astro
import type { Product } from '../data/products';
import { withBase } from '../utils/paths';
import { getProductDisplayName, isProductPopular } from '../utils/productHelpers';

interface Props {
  product: Product;
  variant?: 'modern' | 'classic';
  priority?: boolean;
}

const { product, variant = 'modern', priority = false } = Astro.props;
const productUrl = withBase(`/produk/${product.slug}/`);
const imageUrl = withBase(product.image);
const imageLoading = priority ? 'eager' : 'lazy';
const imageFetchPriority = priority ? 'high' : 'low';
const imageSizes = variant === 'classic'
  ? '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'
  : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
const displayName = getProductDisplayName(product);
const isPopular = isProductPopular(product);
---

{variant === 'classic' ? (
  <div class="classic-product-card product-card-shell group bg-white rounded-[20px] border border-soft-cream/60 overflow-hidden hover-gold-grow">
    <!-- Image Wrapper -->
    <a href={productUrl} class="classic-product-image image-load-shell block relative aspect-[20/19] bg-slate-100 overflow-hidden premium-image-hover" data-image-frame>
      <span class="image-skeleton" aria-hidden="true"></span>
      <img
        src={imageUrl}
        alt={`Foto ${displayName} Florist Malang`}
        width={product.imageWidth}
        height={product.imageHeight}
        loading={imageLoading}
        decoding="async"
        fetchpriority={imageFetchPriority}
        sizes={imageSizes}
        data-image-loader="true"
        class="relative z-0 object-cover object-top w-full h-full"
      />
      {isPopular && (
        <div class="classic-product-badges absolute top-3 left-3 z-10 flex gap-2">
          <span class="bg-secondary text-primary-dark text-[10px] tracking-wider uppercase font-semibold px-2.5 py-1 rounded-xs shadow-xs">
            Terpopuler
          </span>
        </div>
      )}
    </a>

    <!-- Info Wrapper -->
    <div class="classic-product-info p-5 flex flex-col justify-between h-[190px]">
      <div>
        <p class="classic-product-category text-[11px] font-semibold tracking-wider text-slate-400 uppercase mb-1">{product.categoryName}</p>
        <h3 class="classic-product-title font-serif text-lg font-bold text-slate-800 line-clamp-2 leading-snug group-hover:text-primary transition-colors duration-200">
          <a href={productUrl}>{displayName}</a>
        </h3>
      </div>

      <div class="classic-product-price-wrap pt-4">
        <div class="classic-product-price-box rounded-md border border-soft-cream/70 bg-accent-bg/70 p-3">
          <p class="classic-product-price-label text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">Harga</p>
          <div class="classic-product-price-row mt-1.5 flex items-center justify-between gap-3">
            <p class="classic-product-price font-sans text-xl font-extrabold leading-none text-primary">{product.priceLabel}</p>
            <a
              href={productUrl}
              class="classic-product-detail inline-flex shrink-0 items-center justify-center rounded-full bg-primary px-3.5 py-2 text-[11px] font-bold text-white shadow-[0_10px_24px_rgba(85,101,75,0.18)] transition-colors duration-300 hover:bg-secondary hover:text-primary-dark"
            >
              Detail
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
) : (
  <article class="product-card-shell group relative h-full overflow-hidden rounded-[20px] border border-soft-cream/70 bg-white shadow-[0_14px_38px_rgba(15,23,42,0.06)] transition-all duration-300 hover:-translate-y-1 hover:border-secondary/70 hover:shadow-[0_24px_60px_rgba(85,101,75,0.15)]">
    <a href={productUrl} class="block h-full no-underline">
      <div class="image-load-shell relative -mx-px -mt-px aspect-4/3 overflow-hidden bg-clean-ivory premium-image-hover" data-image-frame>
        <span class="image-skeleton" aria-hidden="true"></span>
        <img
          src={imageUrl}
          alt={`Foto ${displayName} Florist Malang`}
          width={product.imageWidth}
          height={product.imageHeight}
          loading={imageLoading}
          decoding="async"
          fetchpriority={imageFetchPriority}
          sizes={imageSizes}
          data-image-loader="true"
          class="relative z-0 block h-full w-full object-cover object-top"
        />

        <div class="absolute inset-x-0 bottom-0 z-10 h-20 bg-gradient-to-t from-primary-dark/35 via-primary-dark/5 to-transparent"></div>


        <span class="absolute bottom-3 right-3 z-10 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/95 text-primary shadow-[0_10px_24px_rgba(15,23,42,0.16)] transition-colors duration-300 group-hover:bg-primary group-hover:text-white" aria-hidden="true">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" />
          </svg>
        </span>
      </div>

      <div class="flex min-h-[218px] flex-col p-5">
        <div>
          <p class="line-clamp-1 text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">{product.categoryName}</p>
          <h3 class="mt-2 font-serif text-xl font-bold leading-snug text-slate-800 line-clamp-2 transition-colors duration-200 group-hover:text-primary">
            {displayName}
          </h3>
        </div>

        <div class="mt-auto pt-5">
          <div class="rounded-md border border-soft-cream/70 bg-accent-bg/70 p-3">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">Harga</p>
            <div class="mt-1.5 flex items-end justify-between gap-3">
              <p class="font-sans text-xl font-extrabold leading-none text-primary">{product.priceLabel}</p>
              <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-primary px-3.5 py-2 text-[11px] font-bold text-white shadow-[0_10px_24px_rgba(85,101,75,0.2)] transition-colors duration-300 group-hover:bg-secondary group-hover:text-primary-dark">
                Detail
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </div>
        </div>
      </div>
    </a>
  </article>
)}

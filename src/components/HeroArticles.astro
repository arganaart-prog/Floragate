---
import { ARTICLES } from '../data/articles';
import { withBase } from '../utils/paths';

const articlesPair1 = ARTICLES.slice(0, 2);
const articlesPair2 = ARTICLES.slice(2, 4);
---

<div class="aw-root" id="hero-articles-widget">

  <!-- Header: two rows — label+heading | tabs -->
  <div class="aw-header">
    <div class="aw-header-top">
      <div class="aw-header-left">
        <span class="aw-eyebrow">Artikel Florist</span>
        <h3 class="aw-heading">Tips & Wawasan</h3>
      </div>
      <nav class="aw-nav" role="tablist" aria-label="Pilih topik artikel">
      <button type="button" role="tab" aria-selected="true" class="aw-tab is-active" data-tab="pair-1" id="tab-articles-1">Panduan</button>
      <button type="button" role="tab" aria-selected="false" class="aw-tab" data-tab="pair-2" id="tab-articles-2">Inspirasi</button>
      <a href={withBase('/artikel/')} class="aw-all-link" aria-label="Semua artikel">
        Semua
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
      </nav>
    </div>
  </div>

  <!-- Divider -->
  <div class="aw-divider" aria-hidden="true"></div>

  <!-- Article Panels -->
  <div class="aw-panels">

    <!-- Panel 1 -->
    <div class="aw-panel is-active" id="panel-pair-1" role="tabpanel" aria-labelledby="tab-articles-1">
      {articlesPair1.map((article, i) => (
        <a
          href={withBase(`/artikel/${article.slug}/`)}
          class="aw-item"
          aria-label={`Baca: ${article.title}`}
        >
          <!-- Thumbnail -->
          <div class="aw-thumb">
            <img
              src={withBase(article.image)}
              alt=""
              class="aw-thumb-img"
              loading="lazy"
              decoding="async"
              width="200"
              height="150"
              aria-hidden="true"
            />
            <span class="aw-read-time">{article.readTime}</span>
          </div>

          <!-- Content -->
          <div class="aw-content">
            <div class="aw-meta">
              <span class="aw-cat">{article.category}</span>
              <time class="aw-date">{article.date}</time>
            </div>
            <p class="aw-title">{article.title}</p>
            <p class="aw-excerpt">{article.excerpt}</p>
            <span class="aw-read-link">Baca artikel <span class="aw-arrow">→</span></span>
          </div>
        </a>

      ))}
    </div>

    <!-- Panel 2 -->
    <div class="aw-panel" id="panel-pair-2" role="tabpanel" aria-labelledby="tab-articles-2">
      {articlesPair2.map((article, i) => (
        <a
          href={withBase(`/artikel/${article.slug}/`)}
          class="aw-item"
          aria-label={`Baca: ${article.title}`}
        >
          <div class="aw-thumb">
            <img
              src={withBase(article.image)}
              alt=""
              class="aw-thumb-img"
              loading="lazy"
              decoding="async"
              width="200"
              height="150"
              aria-hidden="true"
            />
            <span class="aw-read-time">{article.readTime}</span>
          </div>
          <div class="aw-content">
            <div class="aw-meta">
              <span class="aw-cat">{article.category}</span>
              <time class="aw-date">{article.date}</time>
            </div>
            <p class="aw-title">{article.title}</p>
            <p class="aw-excerpt">{article.excerpt}</p>
            <span class="aw-read-link">Baca artikel <span class="aw-arrow">→</span></span>
          </div>
        </a>
      ))}
    </div>

  </div>
</div>

<style>
  /* ─── Root ─────────────────────────────────────────── */
  .aw-root {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  /* ─── Header ─────────────────────────────────────── */
  .aw-header {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex-shrink: 0;
  }

  .aw-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .aw-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .aw-eyebrow {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a89a8a;
    line-height: 1;
  }

  .aw-heading {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: 1rem;
    font-weight: 700;
    color: #18211b;
    margin: 0;
    line-height: 1.2;
  }

  /* ─── Nav Tabs ────────────────────────────────────── */
  .aw-nav {
    display: flex;
    align-items: center;
    gap: 0;
    flex-shrink: 0;
  }

  .aw-tab {
    border: none;
    background: transparent;
    font-size: 0.7rem;
    font-weight: 500;
    color: #8c8273;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition: color 0.15s;
    letter-spacing: 0.01em;
    position: relative;
  }

  .aw-tab::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0.5rem;
    right: 0.5rem;
    height: 1.5px;
    background: #9b1b30;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .aw-tab:hover {
    color: #18211b;
  }

  .aw-tab.is-active {
    color: #9b1b30;
    font-weight: 700;
  }

  .aw-tab.is-active::after {
    transform: scaleX(1);
  }

  .aw-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: #556056;
    text-decoration: none;
    padding: 0.25rem 0.4rem 0.25rem 0.55rem;
    border-left: 1px solid rgba(0,0,0,0.1);
    margin-left: 0.2rem;
    transition: color 0.15s;
  }

  .aw-all-link:hover {
    color: #9b1b30;
  }

  /* ─── Divider ─────────────────────────────────────── */
  .aw-divider {
    height: 1px;
    background: rgba(226, 218, 206, 0.7);
    margin: 0.5rem 0 0.6rem;
    flex-shrink: 0;
  }

  /* ─── Panels ──────────────────────────────────────── */
  .aw-panels {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    position: relative;
  }

  .aw-panel {
    display: none;
    flex-direction: column;
    gap: 0;
    height: 100%;
    flex: 1;
  }

  .aw-panel.is-active {
    display: flex;
  }

  /* ─── Individual Item ─────────────────────────────── */
  .aw-item {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.65rem 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid rgba(226, 218, 206, 0.55);
    flex: 1;
    min-height: 0;
    transition: opacity 0.15s;
  }

  .aw-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .aw-item:hover {
    opacity: 0.82;
  }

  /* ─── Thumbnail ───────────────────────────────────── */
  .aw-thumb {
    position: relative;
    width: 96px;
    min-width: 96px;
    border-radius: 7px;
    overflow: hidden;
    background: #f4ede3;
    flex-shrink: 0;
  }

  .aw-thumb-img {
    display: block;
    width: 100%;
    height: 76px;
    object-fit: cover;
    object-position: center;
  }

  .aw-read-time {
    position: absolute;
    bottom: 4px;
    left: 5px;
    font-size: 0.55rem;
    font-weight: 600;
    color: rgba(255,255,255,0.95);
    background: rgba(0,0,0,0.48);
    padding: 0.07rem 0.32rem;
    border-radius: 3px;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  /* ─── Content ─────────────────────────────────────── */
  .aw-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.15rem;
  }

  .aw-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .aw-cat {
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #9b1b30;
    white-space: nowrap;
  }

  .aw-date {
    font-size: 0.58rem;
    color: #a89a8a;
    font-weight: 400;
    white-space: nowrap;
  }

  .aw-title {
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.28;
    color: #18211b;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .aw-excerpt {
    font-size: 0.67rem;
    line-height: 1.38;
    color: #6b7a6d;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .aw-read-link {
    font-size: 0.63rem;
    font-weight: 600;
    color: #8c8273;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    transition: color 0.15s;
    margin-top: 0.1rem;
  }

  .aw-item:hover .aw-read-link {
    color: #9b1b30;
  }

  .aw-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
    font-style: normal;
  }

  .aw-item:hover .aw-arrow {
    transform: translateX(3px);
  }

  /* ─── Wider screens ───────────────────────────────── */
  @media (min-width: 1280px) {
    .aw-title {
      font-size: 0.83rem;
    }
    .aw-thumb {
      width: 104px;
      min-width: 104px;
    }
    .aw-thumb-img {
      height: 82px;
    }
  }
</style>

<script>
  function initArticlesWidget() {
    const tabs = document.querySelectorAll('.aw-tab');
    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetTab = tab.getAttribute('data-tab');
        if (!targetTab) return;

        tabs.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        const panel1 = document.getElementById('panel-pair-1');
        const panel2 = document.getElementById('panel-pair-2');

        if (panel1 && panel2) {
          if (targetTab === 'pair-1') {
            panel1.classList.add('is-active');
            panel2.classList.remove('is-active');
          } else {
            panel2.classList.add('is-active');
            panel1.classList.remove('is-active');
          }
        }
      });
    });
  }

  initArticlesWidget();
  document.addEventListener('astro:page-load', initArticlesWidget);
</script>

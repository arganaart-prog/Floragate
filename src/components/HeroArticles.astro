---
import { ARTICLES } from '../data/articles';
import { withBase } from '../utils/paths';

// Kelompokkan berdasarkan kategori
const panduan = ARTICLES.filter(a =>
  a.category === 'Panduan Florist' || a.category === 'Tips Perawatan'
);
const inspirasi = ARTICLES.filter(a =>
  a.category === 'Inspirasi Bunga' || a.category === 'Tren Florist'
);
---

<div class="aw-root" id="hero-articles-widget">

  <!-- Header -->
  <div class="aw-header">
    <div class="aw-header-top">
      <div class="aw-header-left">
        <span class="aw-eyebrow">Artikel Florist</span>
        <h3 class="aw-heading">Tips & Wawasan</h3>
      </div>
      <div class="aw-nav">
        <div role="tablist" aria-label="Pilih topik artikel" class="aw-tabs-wrap">
          <button type="button" role="tab" aria-selected="true" class="aw-tab is-active" data-tab="pair-1" id="tab-articles-1" aria-controls="panel-pair-1">Panduan</button>
          <button type="button" role="tab" aria-selected="false" class="aw-tab" data-tab="pair-2" id="tab-articles-2" aria-controls="panel-pair-2">Inspirasi</button>
        </div>
        <a href={withBase('/artikel/')} class="aw-all-link" aria-label="Semua artikel">
          Semua
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="aw-divider" aria-hidden="true"></div>

  <!-- Article Panels -->
  <div class="aw-panels">

    <!-- Panel Panduan -->
    <div class="aw-panel is-active" id="panel-pair-1" role="tabpanel" aria-labelledby="tab-articles-1">
      {panduan.map((article) => (
        <a
          href={withBase(`/artikel/${article.slug}/`)}
          class="aw-item"
          aria-label={`Baca: ${article.title}`}
        >
          <div class="aw-thumb">
            <img
              src={withBase(article.image)}
              alt=""
              class="aw-thumb-img"
              loading="lazy"
              decoding="async"
              width="200"
              height="150"
              aria-hidden="true"
            />
          </div>
          <div class="aw-content">
            <div class="aw-meta">
              <span class="aw-cat">{article.category}</span>
              <span class="aw-meta-dot" aria-hidden="true">·</span>
              <time class="aw-date">{article.date}</time>
            </div>
            <p class="aw-title">{article.title}</p>
            <p class="aw-excerpt">{article.excerpt}</p>
            <span class="aw-read-link">Baca artikel <span class="aw-arrow">→</span></span>
          </div>
        </a>
      ))}
    </div>

    <!-- Panel Inspirasi -->
    <div class="aw-panel" id="panel-pair-2" role="tabpanel" aria-labelledby="tab-articles-2">
      {inspirasi.map((article) => (
        <a
          href={withBase(`/artikel/${article.slug}/`)}
          class="aw-item"
          aria-label={`Baca: ${article.title}`}
        >
          <div class="aw-thumb">
            <img
              src={withBase(article.image)}
              alt=""
              class="aw-thumb-img"
              loading="lazy"
              decoding="async"
              width="200"
              height="150"
              aria-hidden="true"
            />
          </div>
          <div class="aw-content">
            <div class="aw-meta">
              <span class="aw-cat">{article.category}</span>
              <span class="aw-meta-dot" aria-hidden="true">·</span>
              <time class="aw-date">{article.date}</time>
            </div>
            <p class="aw-title">{article.title}</p>
            <p class="aw-excerpt">{article.excerpt}</p>
            <span class="aw-read-link">Baca artikel <span class="aw-arrow">→</span></span>
          </div>
        </a>
      ))}
    </div>

  </div>
</div>

<style>
  /* ─── Root ─────────────────────────────────────────── */
  .aw-root {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: 0;
  }

  /* ─── Header ─────────────────────────────────────── */
  .aw-header {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex-shrink: 0;
  }

  .aw-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .aw-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .aw-eyebrow {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #55654B;
    line-height: 1;
  }

  .aw-heading {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: 1rem;
    font-weight: 700;
    color: #18211b;
    margin: 0;
    line-height: 1.2;
  }

  /* ─── Nav Tabs ────────────────────────────────────── */
  .aw-nav {
    display: flex;
    align-items: center;
    gap: 0;
    flex-shrink: 0;
  }

  .aw-tabs-wrap {
    display: flex;
    align-items: center;
  }

  .aw-tab {
    border: none;
    background: transparent;
    font-size: 0.69rem;
    font-weight: 600;
    color: #556056;
    padding: 0.25rem 0.5rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    transition: color 0.15s;
    letter-spacing: 0.01em;
    position: relative;
  }

  .aw-tab::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0.5rem;
    right: 0.5rem;
    height: 1.5px;
    background: #9b1b30;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .aw-tab:hover { color: #18211b; }

  .aw-tab.is-active {
    color: #9b1b30;
    font-weight: 700;
  }

  .aw-tab.is-active::after {
    transform: scaleX(1);
  }

  .aw-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.67rem;
    font-weight: 600;
    color: #556056;
    text-decoration: none;
    min-height: 44px;
    padding: 0.25rem 0.4rem 0.25rem 0.55rem;
    border-left: 1px solid rgba(0,0,0,0.1);
    margin-left: 0.2rem;
    transition: color 0.15s;
  }

  .aw-all-link:hover { color: #9b1b30; }

  /* ─── Divider ─────────────────────────────────────── */
  .aw-divider {
    height: 1px;
    background: rgba(226, 218, 206, 0.8);
    margin: 0.45rem 0 0;
    flex-shrink: 0;
  }

  /* ─── Panels — scrollable list ────────────────────── */
  .aw-panels {
    flex: 1;
    min-height: 0;
    position: relative;
    overflow: hidden;
  }

  .aw-panel {
    display: none;
    flex-direction: column;
    gap: 0;
    /* Kunci scroll: panel mengisi sisa tinggi container lalu bisa di-scroll */
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    /* Scrollbar minimal */
    scrollbar-width: thin;
    scrollbar-color: rgba(168, 154, 138, 0.35) transparent;
    padding-right: 2px;
  }

  .aw-panel::-webkit-scrollbar {
    width: 3px;
  }
  .aw-panel::-webkit-scrollbar-track {
    background: transparent;
  }
  .aw-panel::-webkit-scrollbar-thumb {
    background: rgba(168, 154, 138, 0.4);
    border-radius: 2px;
  }
  .aw-panel::-webkit-scrollbar-thumb:hover {
    background: rgba(168, 154, 138, 0.65);
  }

  .aw-panel.is-active {
    display: flex;
  }

  /* ─── Individual Item ─────────────────────────────── */
  .aw-item {
    display: flex;
    align-items: flex-start;
    gap: 0.72rem;
    padding: 0.72rem 0.4rem 0.72rem 0.55rem;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid rgba(226, 218, 206, 0.65);
    position: relative;
    transition: background 0.18s;
    border-radius: 4px;
    flex-shrink: 0;
  }

  /* Left accent bar — editorial feel */
  .aw-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 14%;
    bottom: 14%;
    width: 2px;
    background: #9b1b30;
    border-radius: 0 2px 2px 0;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.22s ease;
  }

  .aw-item:last-child {
    border-bottom: none;
  }

  .aw-item:hover {
    background: rgba(245, 240, 234, 0.6);
  }

  .aw-item:hover::before {
    transform: scaleY(1);
  }

  .aw-item:hover .aw-title {
    color: #8b1728;
  }

  /* ─── Thumbnail ───────────────────────────────────── */
  .aw-thumb {
    position: relative;
    width: 82px;
    min-width: 82px;
    border-radius: 5px;
    overflow: hidden;
    background: #f0e9e1;
    flex-shrink: 0;
  }

  .aw-thumb-img {
    display: block;
    width: 100%;
    height: 66px;
    object-fit: cover;
    object-position: center;
    transition: transform 0.32s ease;
  }

  .aw-item:hover .aw-thumb-img {
    transform: scale(1.05);
  }

  /* ─── Content ─────────────────────────────────────── */
  .aw-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.1rem;
    padding-top: 0.02rem;
  }

  .aw-meta {
    display: flex;
    align-items: center;
    gap: 0.28rem;
    flex-wrap: nowrap;
    overflow: hidden;
    margin-bottom: 0.06rem;
  }

  .aw-cat {
    font-size: 0.54rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #9b1b30;
    white-space: nowrap;
  }

  .aw-meta-dot {
    font-size: 0.6rem;
    color: #c4b8ae;
    line-height: 1;
    flex-shrink: 0;
  }

  .aw-date {
    font-size: 0.54rem;
    color: #556056;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .aw-title {
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.3;
    color: #1a2218;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    transition: color 0.15s;
  }

  .aw-excerpt {
    font-size: 0.63rem;
    line-height: 1.42;
    color: #4b584d;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .aw-read-link {
    font-size: 0.6rem;
    font-weight: 600;
    color: #55654B;
    display: flex;
    align-items: center;
    gap: 0.18rem;
    margin-top: 0.15rem;
    transition: color 0.15s;
  }

  .aw-item:hover .aw-read-link {
    color: #9b1b30;
  }

  .aw-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
    font-style: normal;
  }

  .aw-item:hover .aw-arrow {
    transform: translateX(3px);
  }

  /* ─── Wider screens ───────────────────────────────── */
  @media (min-width: 1280px) {
    .aw-title {
      font-size: 0.79rem;
    }
    .aw-thumb {
      width: 90px;
      min-width: 90px;
    }
    .aw-thumb-img {
      height: 72px;
    }
    .aw-item {
      padding: 0.78rem 0.4rem 0.78rem 0.55rem;
    }
  }
</style>

<script>
  function initArticlesWidget() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.aw-tab');
    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetTab = tab.getAttribute('data-tab');
        if (!targetTab) return;

        tabs.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        const panel1 = document.getElementById('panel-pair-1');
        const panel2 = document.getElementById('panel-pair-2');

        if (panel1 && panel2) {
          if (targetTab === 'pair-1') {
            panel1.classList.add('is-active');
            panel2.classList.remove('is-active');
            panel1.scrollTop = 0;
          } else {
            panel2.classList.add('is-active');
            panel1.classList.remove('is-active');
            panel2.scrollTop = 0;
          }
        }
      });
    });
  }

  initArticlesWidget();
  document.addEventListener('astro:page-load', initArticlesWidget);
</script>

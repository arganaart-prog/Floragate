---
import { PRODUCTS } from '../data/products';
import HomeOrderProductCard from './HomeOrderProductCard.astro';
import { withBase } from '../utils/paths';
import { getDailyShuffledProducts } from '../utils/rotatingProducts';

const categorySlug = 'paper-flower-malang';
const paperFlowerProducts = getDailyShuffledProducts(
  PRODUCTS.filter((p) => p.categorySlug === categorySlug),
  categorySlug
);

const categoryHref = '/kategori/paper-flower-malang/';
---

<section class="py-20 bg-accent-bg/55 border-y border-soft-cream/60" id="paper-flower-malang">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Paper Flower Malang</h2>
      <p class="text-slate-500 text-sm mt-3 leading-relaxed">
        Bunga kertas handmade yang tahan lama untuk dekorasi, kado wisuda, lamaran, dan pajangan cantik.
      </p>
    </div>

    <div
      class="daily-rotate-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 max-w-4xl mx-auto lg:max-w-none"
      data-daily-rotate-category={categorySlug}
    >
      {paperFlowerProducts.map((product, index) => (
        <div class="daily-product-item h-full" data-product-slug={product.slug}>
          <HomeOrderProductCard product={product} priority={index < 2} />
        </div>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href={withBase(categoryHref)}
        class="inline-flex items-center text-sm font-semibold text-primary hover:text-secondary transition-colors group"
      >
        Lihat Semua Paper Flower
        <svg class="h-4 w-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>


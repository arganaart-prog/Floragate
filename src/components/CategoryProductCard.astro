---
import type { Product } from '../data/products';
import { withBase } from '../utils/paths';
import { getProductDisplayName } from '../utils/productHelpers';

interface Props {
  product: Product;
  aspect?: string;
  priority?: boolean;
}

const { product, aspect = 'aspect-[4/5]', priority = false } = Astro.props;
const productUrl = withBase(`/produk/${product.slug}/`);
const imageLoading = priority ? 'eager' : 'lazy';
const imageFetchPriority = priority ? 'high' : 'low';
const displayName = getProductDisplayName(product);
const isBungaPapan = product.categorySlug.startsWith('bunga-papan') || product.categoryName.toLowerCase().includes('bunga papan');
---

<a
  href={productUrl}
  class="category-product-card product-card-shell group flex h-full flex-col overflow-hidden rounded-[14px] border border-soft-cream/70 bg-white text-left no-underline shadow-[0_2px_10px_rgba(15,23,42,0.035)] transition-all duration-300 hover:-translate-y-1 hover:border-secondary/80 hover:shadow-[0_12px_28px_rgba(15,23,42,0.08)]"
>
  <div class={`image-load-shell relative ${aspect} overflow-hidden bg-clean-ivory`} data-image-frame>
    <span class="image-skeleton" aria-hidden="true"></span>

    <img
      src={withBase(product.image)}
      alt={`Foto ${displayName} Floragate Malang`}
      width={product.imageWidth}
      height={product.imageHeight}
      loading={imageLoading}
      decoding="async"
      fetchpriority={imageFetchPriority}
      sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
      data-image-loader="true"
      class="relative z-0 block h-full w-full object-cover object-top transition-transform duration-600 ease-out group-hover:scale-[1.03]"
    />

    <div class="absolute inset-x-0 bottom-0 z-10 h-24 bg-gradient-to-t from-primary-dark/45 via-primary-dark/10 to-transparent"></div>
  </div>

  <div class="flex min-h-[150px] flex-1 flex-col px-3.5 py-4 sm:min-h-[168px] sm:px-4 sm:py-4.5">
    <h3 class={`font-serif font-bold leading-snug text-slate-800 line-clamp-2 transition-colors duration-200 group-hover:text-primary ${isBungaPapan ? 'text-[0.875rem] sm:text-base' : 'text-[0.98rem] sm:text-lg'}`}>
      {displayName}
    </h3>

    <div class="mt-auto pt-4">
      <div class="rounded-md border border-soft-cream/70 bg-accent-bg/70 px-3 py-2.5">
        <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-secondary-dark sm:text-[10px]">Harga</p>
        <div class="mt-1 flex items-end justify-between gap-2">
          <p class="font-sans text-[1.05rem] font-extrabold leading-none text-primary sm:text-xl">{product.priceLabel}</p>
          <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-white shadow-xs transition-all duration-200 group-hover:bg-primary-dark group-hover:shadow-[0_4px_12px_rgba(63,75,55,0.25)]" aria-hidden="true">
            <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </div>
</a>

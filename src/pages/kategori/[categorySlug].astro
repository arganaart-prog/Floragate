---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { CATEGORIES, PRODUCTS } from '../../data/products';
import { WHATSAPP_NUMBER, SITE_DOMAIN } from '../../data/constants';
import { withBase } from '../../utils/paths';
import { isBungaPapanCategory } from '../../utils/productHelpers';

export async function getStaticPaths() {
  return CATEGORIES.map(category => {
    const filteredProducts = PRODUCTS.filter(p => p.categorySlug === category.slug);
    return {
      params: { categorySlug: category.slug },
      props: { category, products: filteredProducts }
    };
  });
}

const { category, products } = Astro.props;
const isTanbulampot = category.slug === 'tanbulampot-malang';
const isHandBouquet = category.slug === 'hand-bouquet-malang';
const isDukaCita = category.slug === 'bunga-papan-duka-cita-malang';
const isBungaPapan = isBungaPapanCategory(category.slug);

const fastOrderText = encodeURIComponent(
  isDukaCita
    ? `Halo Floragate, saya butuh kirim Bunga Papan Duka Cita cepat hari ini di Malang. Mohon info pilihan yang bisa segera dirangkai & dikirim.`
    : `Halo Floragate, saya butuh kirim ${category.name} cepat hari ini di Malang. Mohon info rekomendasi yang bisa segera diproses.`
);

const categoryBannerImage = category.bannerImage || (products.length > 0 ? products[0].image : category.image);

// Pick two showcase images for duka cita hero (first two distinct products)
const heroShowcaseImages = isDukaCita && products.length >= 2
  ? [products[0].image, products[1].image]
  : [categoryBannerImage];

// Structured Schema untuk Kategori & FAQ
const categoryUrl = `${SITE_DOMAIN}/kategori/${category.slug}/`;
const customCategorySchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": category.seoTitle,
  "description": category.seoDescription,
  "url": categoryUrl,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": products.map((prod, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `${SITE_DOMAIN}/produk/${prod.slug}/`,
      "name": prod.name
    }))
  },
  ...(isTanbulampot ? {
    "hasPart": {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa itu bunga ucapan tanaman dan pohon ucapan (tanbulampot)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bunga ucapan tanaman atau pohon ucapan adalah kreasi ucapan selamat & sukses menggunakan tanaman hidup dan bibit pohon buah dalam pot (tanbulampot) yang dirangkai estetis lengkap dengan pita satin mewah serta kartu ucapan kustom sebagai alternatif karangan bunga konvensional yang ramah lingkungan."
          }
        },
        {
          "@type": "Question",
          "name": "Mengapa memilih ucapan bibit pohon & buah dibanding karangan bunga biasa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ucapan bibit pohon & buah tidak mudah layu karena tanaman tetap hidup, dapat dirawat, tumbuh subur, dan menghasilkan buah. Hal ini menjadikannya simbol keberkahan dan doa pertumbuhan bisnis yang berkesan untuk jangka panjang."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah bisa custom karangan bibit tanaman untuk grand opening di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya, Floragate menyediakan custom karangan bibit tanaman dan bunga ucapan tanaman hidup dengan pilihan jenis bibit buah (jeruk nagami, tin, dsb.), ukuran pot keramik eksklusif, serta ucapan kustom untuk pengiriman ke seluruh Malang Raya dan Kota Batu."
          }
        }
      ]
    }
  } : {}),
  ...(isDukaCita ? {
    "hasPart": {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Berapa harga bunga papan duka cita di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Harga bunga papan duka cita di Floragate Malang mulai dari Rp 400.000 hingga Rp 1.500.000, tergantung ukuran papan dan jenis rangkaian bunga yang dipilih. Semua harga sudah termasuk papan, rangkaian bunga segar, tata huruf rapi, dan pengiriman gratis ke area Kota Malang."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama pengerjaan bunga papan duka cita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pengerjaan bunga papan duka cita di Floragate membutuhkan waktu sekitar 3 jam sejak pesanan dikonfirmasi. Cocok untuk kebutuhan mendesak karena kami memahami momen duka cita sering datang tanpa perencanaan."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah bisa pesan bunga papan duka cita mendadak hari ini di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bisa. Floragate menerima pesanan dadakan bunga papan duka cita dengan pengerjaan cepat 3 jam. Hubungi kami via WhatsApp, konfirmasi desain dan ucapan, lalu bunga papan akan disiapkan dan dikirim hari itu juga ke seluruh Kota Malang."
          }
        },
        {
          "@type": "Question",
          "name": "Apa saja warna bunga yang cocok untuk papan duka cita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Warna bunga yang umum digunakan untuk papan duka cita adalah putih, kuning gading, ungu tua, dan merah marun. Warna-warna teduh ini menyimbolkan rasa hormat, belasungkawa, dan penghormatan terakhir kepada almarhum/almarhumah."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah ada layanan gratis ongkir untuk bunga papan duka cita di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya, Floragate memberikan gratis ongkir pengiriman bunga papan duka cita ke seluruh area Kota Malang. Untuk pengiriman ke Kabupaten Malang dan Kota Batu, silakan konsultasikan biaya kirim melalui WhatsApp."
          }
        }
      ]
    }
  } : {})
};
---

<Layout
  title={category.seoTitle}
  description={category.seoDescription}
  keywords={category.seoKeywords}
  schema={customCategorySchema}
>
  {/* Preload hero images — direct children of Layout so Astro injects into <slot name="head" /> */}
  {isDukaCita && (
    <link
      slot="head"
      rel="preload"
      as="image"
      type="image/webp"
      href={withBase('/images/banner/kategori/spanduk-bunga-duka-cita-floragate-mobile.webp')}
      media="(max-width: 1023px)"
      fetchpriority="high"
    />
  )}
  {isDukaCita && (
    <link
      slot="head"
      rel="preload"
      as="image"
      type="image/webp"
      href={withBase('/images/banner/kategori/spanduk-bunga-duka-cita-floragate.webp')}
      media="(min-width: 1024px)"
      fetchpriority="high"
    />
  )}
  {!isDukaCita && products.length > 0 && (
    <link
      slot="head"
      rel="preload"
      as="image"
      type="image/webp"
      href={withBase(categoryBannerImage)}
      fetchpriority="high"
    />
  )}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    
    <!-- Breadcrumb -->
    <Breadcrumb 
      items={[
        { label: 'Katalog', href: '/katalog/' },
        { label: category.name }
      ]} 
    />

    {/* ═══════════════════════════════════════════════════
        HERO BANNER — Duka Cita (dark solemn theme)
        vs. default (light card) for other categories
    ═══════════════════════════════════════════════════ */}

    {isDukaCita ? (
      <section class="mt-4 mb-10 rounded-2xl overflow-hidden" aria-label="Banner Bunga Papan Duka Cita Malang">

        {/* ── MOBILE LAYOUT ── */}
        <div class="lg:hidden">
          <div class="rounded-2xl overflow-hidden border border-soft-cream/60 shadow-sm bg-white">
            {/* Banner image — clickable */}
            <a
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=${fastOrderText}`}
              target="_blank"
              rel="noopener noreferrer"
              class="block"
              aria-label="Pesan Bunga Papan Duka Cita via WhatsApp"
            >
              <img
                src={withBase('/images/banner/kategori/spanduk-bunga-duka-cita-floragate-mobile.webp')}
                alt="Bunga Papan Duka Cita Malang 24 Jam - Floragate Florist"
                class="w-full h-auto block"
                loading="eager"
                decoding="sync"
                fetchpriority="high"
                width="750"
                height="422"
              />
            </a>

            {/* Info section below banner */}
            <div class="px-4 pt-4 pb-5">
              <h1 class="font-serif text-lg font-bold text-primary-dark leading-snug mb-3">
                Bunga Papan Duka Cita Malang <span class="text-secondary">24 Jam</span>
              </h1>

              {/* Trust indicators — compact row */}
              <div class="flex items-center gap-3 mb-4 text-[11px] text-slate-500 font-medium">
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  3 Jam Selesai
                </span>
                <span class="w-px h-3 bg-soft-cream"></span>
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  Difoto Dulu
                </span>
                <span class="w-px h-3 bg-soft-cream"></span>
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                  Gratis Ongkir
                </span>
              </div>

              {/* CTA + price */}
              <a
                href={`https://wa.me/${WHATSAPP_NUMBER}?text=${fastOrderText}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-primary hover:bg-primary-dark text-white rounded-xl text-sm font-bold shadow-md transition-all cursor-pointer"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.588 2.02 14.12 1.022 11.5 1.022c-5.438 0-9.863 4.372-9.867 9.802-.001 1.73.473 3.42 1.37 4.947l-.994 3.63 3.734-.967c1.554.84 3.123 1.282 4.304 1.282zm11.304-6.858c-.31-.155-1.838-.895-2.122-.997-.284-.102-.49-.153-.696.155-.205.308-.796.997-.975 1.199-.179.203-.359.227-.669.073-.31-.155-1.31-.476-2.494-1.516-.922-.811-1.545-1.812-1.725-2.12-.179-.31-.018-.478.137-.631.14-.139.31-.359.464-.539.155-.179.206-.308.31-.513.102-.206.051-.385-.026-.539-.077-.154-.696-1.649-.953-2.263-.25-.596-.503-.515-.69-.525l-.59-.01c-.206 0-.54.077-.822.385-.282.308-1.079 1.052-1.079 2.565 0 1.513 1.103 2.977 1.257 3.182.155.206 2.17 3.267 5.257 4.569.735.31 1.307.495 1.753.634.739.231 1.412.197 1.944.119.593-.087 1.838-.739 2.095-1.453.258-.713.258-1.325.18-1.453-.077-.128-.283-.205-.593-.36z" />
                </svg>
                Pesan Sekarang via WhatsApp
              </a>
              <p class="text-[11px] text-slate-400 mt-2 text-center">Mulai <span class="font-bold text-primary-dark">Rp 400.000</span> · Bunga segar · Pengiriman Kota Malang</p>
            </div>
          </div>
        </div>

        {/* ── DESKTOP LAYOUT: banner image with side info panel ── */}
        <div class="hidden lg:grid lg:grid-cols-12 lg:gap-0 rounded-2xl overflow-hidden border border-soft-cream/60 shadow-sm bg-white">
          {/* Banner image — takes 8 columns */}
          <div class="lg:col-span-8">
            <a
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=${fastOrderText}`}
              target="_blank"
              rel="noopener noreferrer"
              class="block h-full"
              aria-label="Pesan Bunga Papan Duka Cita via WhatsApp"
            >
              <img
                src={withBase('/images/banner/kategori/spanduk-bunga-duka-cita-floragate.webp')}
                alt="Bunga Papan Duka Cita Malang 24 Jam - Floragate Florist"
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
                width="1080"
                height="608"
              />
            </a>
          </div>

          {/* Info panel — 4 columns, cream background */}
          <div class="lg:col-span-4 flex flex-col justify-center px-7 py-8 bg-accent-bg">
            <span class="text-secondary-dark text-[11px] font-bold uppercase tracking-[0.15em] mb-3">Floragate · Malang</span>

            <h1 class="font-serif text-2xl xl:text-3xl font-bold text-primary-dark leading-snug mb-4">
              Bunga Papan<br /> Duka Cita Malang <span class="text-secondary">24 Jam</span>
            </h1>

            <ul class="space-y-2.5 mb-6 text-[13px] text-slate-600">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Selesai 3 jam, kirim hari ini
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Difoto sebelum dikirim
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                Gratis ongkir Kota Malang
              </li>
            </ul>

            <a
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=${fastOrderText}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-primary hover:bg-primary-dark text-white rounded-xl text-sm font-bold shadow-md transition-all cursor-pointer"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.588 2.02 14.12 1.022 11.5 1.022c-5.438 0-9.863 4.372-9.867 9.802-.001 1.73.473 3.42 1.37 4.947l-.994 3.63 3.734-.967c1.554.84 3.123 1.282 4.304 1.282zm11.304-6.858c-.31-.155-1.838-.895-2.122-.997-.284-.102-.49-.153-.696.155-.205.308-.796.997-.975 1.199-.179.203-.359.227-.669.073-.31-.155-1.31-.476-2.494-1.516-.922-.811-1.545-1.812-1.725-2.12-.179-.31-.018-.478.137-.631.14-.139.31-.359.464-.539.155-.179.206-.308.31-.513.102-.206.051-.385-.026-.539-.077-.154-.696-1.649-.953-2.263-.25-.596-.503-.515-.69-.525l-.59-.01c-.206 0-.54.077-.822.385-.282.308-1.079 1.052-1.079 2.565 0 1.513 1.103 2.977 1.257 3.182.155.206 2.17 3.267 5.257 4.569.735.31 1.307.495 1.753.634.739.231 1.412.197 1.944.119.593-.087 1.838-.739 2.095-1.453.258-.713.258-1.325.18-1.453-.077-.128-.283-.205-.593-.36z" />
              </svg>
              Pesan Sekarang
            </a>

            <p class="text-xs text-slate-500 mt-3 text-center">Mulai <span class="font-bold text-primary-dark">Rp 400.000</span></p>
          </div>
        </div>

      </section>
    ) : (
      <section class="mt-4 mb-12 bg-white rounded-3xl border border-soft-cream/90 shadow-sm p-6 sm:p-8 lg:p-10 relative overflow-hidden" aria-label={`Banner Kategori ${category.name}`}>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-7 flex flex-col justify-center">
            <span class="text-xs font-bold text-secondary-dark uppercase tracking-widest block mb-2.5">
              {isTanbulampot ? 'KATEGORI EKSKLUSIF · ECO-FRIENDLY' : 'BUNGA PAPAN · FLORAGATE MALANG'}
            </span>
            
            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight mb-4">
              {`${category.name} di Malang`}
            </h1>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-5 max-w-xl">
              {category.description}
            </p>

            <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-700 mb-6 font-medium">
              <span>Khusus Pengiriman ke area</span>
              <span class="font-bold text-primary bg-primary/10 px-2.5 py-0.5 rounded-md">Kota Malang &amp; Sekitarnya</span>
            </div>

            <div class="flex flex-wrap items-center gap-3.5 pt-1">
              <a
                href={`https://wa.me/${WHATSAPP_NUMBER}?text=${fastOrderText}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-sm font-bold shadow-md hover:shadow-lg transition-all cursor-pointer group"
              >
                <svg class="w-4 h-4 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.588 2.02 14.12 1.022 11.5 1.022c-5.438 0-9.863 4.372-9.867 9.802-.001 1.73.473 3.42 1.37 4.947l-.994 3.63 3.734-.967c1.554.84 3.123 1.282 4.304 1.282zm11.304-6.858c-.31-.155-1.838-.895-2.122-.997-.284-.102-.49-.153-.696.155-.205.308-.796.997-.975 1.199-.179.203-.359.227-.669.073-.31-.155-1.31-.476-2.494-1.516-.922-.811-1.545-1.812-1.725-2.12-.179-.31-.018-.478.137-.631.14-.139.31-.359.464-.539.155-.179.206-.308.31-.513.102-.206.051-.385-.026-.539-.077-.154-.696-1.649-.953-2.263-.25-.596-.503-.515-.69-.525l-.59-.01c-.206 0-.54.077-.822.385-.282.308-1.079 1.052-1.079 2.565 0 1.513 1.103 2.977 1.257 3.182.155.206 2.17 3.267 5.257 4.569.735.31 1.307.495 1.753.634.739.231 1.412.197 1.944.119.593-.087 1.838-.739 2.095-1.453.258-.713.258-1.325.18-1.453-.077-.128-.283-.205-.593-.36z" />
                </svg>
                <span>Pesan via WhatsApp</span>
              </a>

              <div class="inline-flex items-center gap-2 text-xs font-semibold text-slate-700 bg-clean-ivory px-3.5 py-3 rounded-xl border border-soft-cream">
                <span class="text-base">🚚</span>
                <span>Bisa Kirim Cepat (3 Jam Selesai)</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="relative rounded-2xl overflow-hidden aspect-[4/3] lg:aspect-[16/12] bg-slate-100 shadow-sm border border-soft-cream/80 group">
              <img
                src={withBase(categoryBannerImage)}
                alt={`${category.name} di Malang - Floragate Florist`}
                class="w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-500"
                loading="eager"
                fetchpriority="high"
                width="800"
                height="600"

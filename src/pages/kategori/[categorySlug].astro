<script>
  function initCategoryPagination() {
    const items = document.querySelectorAll('.category-product-item');
    const nav = document.getElementById('cat-pagination-nav');
    const info = document.getElementById('cat-pagination-info');
    if (!items.length || !nav || !info) return;

    const isMobile = window.innerWidth < 640;
    const ITEMS_PER_PAGE = isMobile ? 8 : 9;
    const totalItems = items.length;
    if (totalItems <= ITEMS_PER_PAGE) return;

    const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
    let currentPage = 1;

    function render() {
      const start = (currentPage - 1) * ITEMS_PER_PAGE;
      const end = start + ITEMS_PER_PAGE;

      items.forEach((item, idx) => {
        if (item instanceof HTMLElement) {
          if (idx >= start && idx < end) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        }
      });

      const startIdx = start + 1;
      const endIdx = Math.min(end, totalItems);
      info.textContent = `Menampilkan ${startIdx}-${endIdx} dari ${totalItems} produk`;

      let html = '';
      html += `<button type="button" class="cat-page-btn px-3.5 h-10 flex items-center justify-center rounded-lg border border-soft-cream/80 bg-white text-slate-700 font-semibold text-xs transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shadow-xs" data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''} aria-label="Halaman sebelumnya">
        <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg> Sebelumnya
      </button>`;

      for (let p = 1; p <= totalPages; p++) {
        const isActive = p === currentPage;
        html += `<button type="button" class="cat-page-btn min-w-[40px] h-10 px-3 flex items-center justify-center rounded-lg border text-xs font-bold transition-colors cursor-pointer shadow-xs ${isActive ? 'border-primary bg-primary text-white' : 'border-soft-cream/80 bg-white text-slate-700 hover:border-primary hover:text-primary'}" data-page="${p}" aria-current="${isActive ? 'page' : 'false'}" aria-label="Halaman ${p}">
          ${p}
        </button>`;
      }

      html += `<button type="button" class="cat-page-btn px-3.5 h-10 flex items-center justify-center rounded-lg border border-soft-cream/80 bg-white text-slate-700 font-semibold text-xs transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shadow-xs" data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''} aria-label="Halaman berikutnya">
        Berikutnya <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>`;

      nav.innerHTML = html;

      nav.querySelectorAll('.cat-page-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetPage = parseInt((btn as HTMLElement).getAttribute('data-page') || '1', 10);
          if (targetPage && targetPage !== currentPage && targetPage >= 1 && targetPage <= totalPages) {
            currentPage = targetPage;
            render();
            const grid = document.getElementById('category-products-grid');
            if (grid) {
              const offset = grid.getBoundingClientRect().top + window.scrollY - 100;
              window.scrollTo({ top: Math.max(0, offset), behavior: 'smooth' });
            }
          }
        });
      });
    }

    render();
  }

  initCategoryPagination();
  document.addEventListener('astro:page-load', initCategoryPagination);
</script>

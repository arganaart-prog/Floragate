---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { CATEGORIES, PRODUCTS } from '../../data/products';
import { WHATSAPP_NUMBER, SITE_DOMAIN } from '../../data/constants';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  return CATEGORIES.map(category => {
    const filteredProducts = PRODUCTS.filter(p => p.categorySlug === category.slug);
    return {
      params: { categorySlug: category.slug },
      props: { category, products: filteredProducts }
    };
  });
}

const { category, products } = Astro.props;
const isTanbulampot = category.slug === 'tanbulampot-malang';
const isHandBouquet = category.slug === 'hand-bouquet-malang';
const isDukaCita = category.slug === 'bunga-papan-duka-cita-malang';

const fastOrderText = encodeURIComponent(
  isDukaCita
    ? `Halo Floragate, saya butuh kirim Bunga Papan Duka Cita cepat hari ini di Malang. Mohon info pilihan yang bisa segera dirangkai & dikirim.`
    : `Halo Floragate, saya butuh kirim ${category.name} cepat hari ini di Malang. Mohon info rekomendasi yang bisa segera diproses.`
);

// Structured Schema untuk Kategori & FAQ
const categoryUrl = `${SITE_DOMAIN}/kategori/${category.slug}/`;
const customCategorySchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": category.seoTitle,
  "description": category.seoDescription,
  "url": categoryUrl,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": products.map((prod, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `${SITE_DOMAIN}/produk/${prod.slug}/`,
      "name": prod.name
    }))
  },
  ...(isTanbulampot ? {
    "hasPart": {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa itu bunga ucapan tanaman dan pohon ucapan (tanbulampot)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bunga ucapan tanaman atau pohon ucapan adalah kreasi ucapan selamat & sukses menggunakan tanaman hidup dan bibit pohon buah dalam pot (tanbulampot) yang dirangkai estetis lengkap dengan pita satin mewah serta kartu ucapan kustom sebagai alternatif karangan bunga konvensional yang ramah lingkungan."
          }
        },
        {
          "@type": "Question",
          "name": "Mengapa memilih ucapan bibit pohon & buah dibanding karangan bunga biasa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ucapan bibit pohon & buah tidak mudah layu karena tanaman tetap hidup, dapat dirawat, tumbuh subur, dan menghasilkan buah. Hal ini menjadikannya simbol keberkahan dan doa pertumbuhan bisnis yang berkesan untuk jangka panjang."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah bisa custom karangan bibit tanaman untuk grand opening di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya, Floragate menyediakan custom karangan bibit tanaman dan bunga ucapan tanaman hidup dengan pilihan jenis bibit buah (jeruk nagami, tin, dsb.), ukuran pot keramik eksklusif, serta ucapan kustom untuk pengiriman ke seluruh Malang Raya dan Kota Batu."
          }
        }
      ]
    }
  } : {}),
  ...(isDukaCita ? {
    "hasPart": {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Berapa harga bunga papan duka cita di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Harga bunga papan duka cita di Floragate Malang mulai dari Rp 400.000 hingga Rp 1.500.000, tergantung ukuran papan dan jenis rangkaian bunga yang dipilih. Semua harga sudah termasuk papan, rangkaian bunga segar, tata huruf rapi, dan pengiriman gratis ke area Kota Malang."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama pengerjaan bunga papan duka cita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pengerjaan bunga papan duka cita di Floragate membutuhkan waktu sekitar 3 jam sejak pesanan dikonfirmasi. Cocok untuk kebutuhan mendesak karena kami memahami momen duka cita sering datang tanpa perencanaan."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah bisa pesan bunga papan duka cita mendadak hari ini di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bisa. Floragate menerima pesanan dadakan bunga papan duka cita dengan pengerjaan cepat 3 jam. Hubungi kami via WhatsApp, konfirmasi desain dan ucapan, lalu bunga papan akan disiapkan dan dikirim hari itu juga ke seluruh Kota Malang."
          }
        },
        {
          "@type": "Question",
          "name": "Apa saja warna bunga yang cocok untuk papan duka cita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Warna bunga yang umum digunakan untuk papan duka cita adalah putih, kuning gading, ungu tua, dan merah marun. Warna-warna teduh ini menyimbolkan rasa hormat, belasungkawa, dan penghormatan terakhir kepada almarhum/almarhumah."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah ada layanan gratis ongkir untuk bunga papan duka cita di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya, Floragate memberikan gratis ongkir pengiriman bunga papan duka cita ke seluruh area Kota Malang. Untuk pengiriman ke Kabupaten Malang dan Kota Batu, silakan konsultasikan biaya kirim melalui WhatsApp."
          }
        }
      ]
    }
  } : {})
};
---

<Layout
  title={category.seoTitle}
  description={category.seoDescription}
  keywords={category.seoKeywords}
  schema={customCategorySchema}
>
  {products.length > 0 && (
    <link
      slot="head"
      rel="preload"
      as="image"
      type="image/webp"
      href={withBase(products[0].image)}
      fetchpriority="high"
    />
  )}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb -->
    <Breadcrumb 
      items={[
        { label: 'Katalog', href: '/katalog/' },
        { label: category.name }
      ]} 
    />

    <!-- Category Header -->
    <div class="mt-6 mb-8 max-w-3xl">
      <span class="text-xs font-semibold text-secondary uppercase tracking-widest block mb-2">
        {isTanbulampot ? 'Kategori Eksklusif Eco-Friendly' : 'Kategori Pilihan'}
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800 leading-tight">
        {isTanbulampot ? 'Bunga Ucapan Tanaman & Pohon Ucapan (Tanbulampot) Malang' : isDukaCita ? 'Bunga Papan Duka Cita Malang 24 Jam & Berkualitas' : `Jual ${category.name} Malang`}
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-3 leading-relaxed">
        {category.description}
      </p>

      {isTanbulampot && (
        <!-- Quick Keyword Badges for Crawlers & Visitors -->
        <div class="mt-4 flex flex-wrap gap-2 pt-2">
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Bunga Ucapan Tanaman
          </span>
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Pohon Ucapan
          </span>
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Ucapan Bibit Pohon & Buah
          </span>
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Karangan Bibit Tanaman
          </span>
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Bunga Ucapan Tanaman Hidup
          </span>
        </div>
      )}
    </div>

    <!-- Express Urgency Hook Banner (Solusi Cepat untuk Pelanggan Mendesak) -->
    <section class="mb-12 p-5 sm:p-7 rounded-2xl bg-gradient-to-br from-white via-[#faf7f2] to-[#f4ede3] border border-secondary/40 shadow-sm relative overflow-hidden" aria-label="Layanan Pesanan Kilat">
      <!-- Decorative radial ambient glow -->
      <div class="absolute -right-10 -bottom-10 w-44 h-44 bg-primary/10 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
        <div class="max-w-2xl space-y-3.5">
          <!-- Urgency Live Pulse Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold tracking-wide shadow-2xs">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
            </span>
            <span>{isDukaCita ? 'LAYANAN KILAT DUKA CITA 24 JAM · FAST RESPONSE' : 'LAYANAN PESAN KILAT 24 JAM · SIAGA HARI INI'}</span>
          </div>

          <!-- Main Hook Headline -->
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
            {isDukaCita 
              ? 'Butuh Kirim Bunga Papan Duka Cita Cepat Sampai Hari Ini?' 
              : `Pesanan Mendadak? Siap Rangkai & Kirim ${category.name} Hari Ini!`}
          </h2>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            {isDukaCita
              ? 'Kabar duka sering datang tiba-tiba. Tim perangkai Floragate siaga merangkai bunga papan rapi dalam 3 jam, difoto sebelum dikirim, dan diantar langsung gratis ke rumah duka atau rumah duka cita se-Malang Kota.'
              : 'Acara penting mendadak? Tim Floragate siap memproses pesanan kilat dengan rangkaian bunga segar terbaik, pengerjaan 3 jam selesai, difoto sebelum dikirim, dan gratis ongkir area Kota Malang.'}
          </p>

          <!-- 3 Value Proposition Chips -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
            <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-white/90 border border-soft-cream/80 text-xs text-slate-700 font-medium shadow-2xs">
              <span class="flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-amber-700 text-sm font-bold shrink-0">⚡</span>
              <div>
                <strong class="block text-slate-800">3 Jam Jadi</strong>
                <span class="text-[0.68rem] text-slate-500">Bisa order dadakan</span>
              </div>
            </div>
            <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-white/90 border border-soft-cream/80 text-xs text-slate-700 font-medium shadow-2xs">
              <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-700 text-sm font-bold shrink-0">📸</span>
              <div>
                <strong class="block text-slate-800">Difoto Sebelum Kirim</strong>
                <span class="text-[0.68rem] text-slate-500">Cek tulisan via WA</span>
              </div>
            </div>
            <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-white/90 border border-soft-cream/80 text-xs text-slate-700 font-medium shadow-2xs">
              <span class="flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 text-sm font-bold shrink-0">🚚</span>
              <div>
                <strong class="block text-slate-800">Gratis Ongkir</strong>
                <span class="text-[0.68rem] text-slate-500">Khusus Kota Malang</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Card -->
        <div class="flex flex-col items-stretch sm:items-center lg:items-end justify-center gap-2 shrink-0 lg:min-w-[250px] pt-2 lg:pt-0 border-t lg:border-t-0 border-soft-cream/80">
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=${fastOrderText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm tracking-wide shadow-md hover:shadow-lg transition-all duration-200 group text-center cursor-pointer w-full sm:w-auto"
          >
            <!-- WhatsApp SVG Icon -->
            <svg class="w-5 h-5 fill-current shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.588 2.02 14.12 1.022 11.5 1.022c-5.438 0-9.863 4.372-9.867 9.802-.001 1.73.473 3.42 1.37 4.947l-.994 3.63 3.734-.967c1.554.84 3.123 1.282 4.304 1.282zm11.304-6.858c-.31-.155-1.838-.895-2.122-.997-.284-.102-.49-.153-.696.155-.205.308-.796.997-.975 1.199-.179.203-.359.227-.669.073-.31-.155-1.31-.476-2.494-1.516-.922-.811-1.545-1.812-1.725-2.12-.179-.31-.018-.478.137-.631.14-.139.31-.359.464-.539.155-.179.206-.308.31-.513.102-.206.051-.385-.026-.539-.077-.154-.696-1.649-.953-2.263-.25-.596-.503-.515-.69-.525l-.59-.01c-.206 0-.54.077-.822.385-.282.308-1.079 1.052-1.079 2.565 0 1.513 1.103 2.977 1.257 3.182.155.206 2.17 3.267 5.257 4.569.735.31 1.307.495 1.753.634.739.231 1.412.197 1.944.119.593-.087 1.838-.739 2.095-1.453.258-.713.258-1.325.18-1.453-.077-.128-.283-.205-.593-.36z" />
            </svg>
            <span>Pesan Kilat via WhatsApp</span>
          </a>
          <span class="text-[0.72rem] text-slate-500 text-center flex items-center justify-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
            Siaga 24 Jam &bull; Respon Cepat &bull; Bebas Antre
          </span>
        </div>
      </div>
    </section>

    <!-- Section Heading for Catalog Products -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-6 border-b border-soft-cream/80">
      <div>
        <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-800">
          Pilihan Desain &amp; Model {category.name}
        </h3>
        <p class="text-xs text-slate-500 mt-0.5">
          Tersedia {products.length} model rangkaian bunga segar &bull; Pengerjaan 3 jam selesai &bull; Foto sebelum kirim
        </p>
      </div>
      <div class="inline-flex items-center gap-1.5 text-xs text-emerald-800 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200 font-semibold self-start sm:self-auto shadow-2xs">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Semua Produk Siap Dikerjakan
      </div>
    </div>

    <!-- Products Grid -->
    {products.length > 0 ? (
      <>
        <div class={`grid ${isHandBouquet ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8'}`} id="category-products-grid">
          {products.map((product, index) => (
            <div class="category-product-item">
              <ProductCard
                product={product}
                priority={index === 0}
                aspect={isHandBouquet ? 'aspect-[4/5]' : undefined}
              />
            </div>
          ))}
        </div>

        <!-- Pagination Controls -->
        {products.length > 9 && (
          <div id="cat-pagination-wrapper" class="mt-12 flex flex-col items-center gap-3">
            <nav id="cat-pagination-nav" class="flex flex-wrap justify-center items-center gap-2" aria-label="Navigasi Halaman Produk Kategori">
              <!-- Injected by script -->
            </nav>
            <p id="cat-pagination-info" class="text-xs text-slate-500 font-medium"></p>
          </div>
        )}
      </>
    ) : (
      <div class="text-center py-20 bg-white rounded-lg border border-soft-cream/60 space-y-4">
        <svg width="64" height="64" class="h-16 w-16 text-slate-300 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h3 class="font-serif font-bold text-lg text-slate-700">Belum Ada Produk</h3>
        <p class="text-sm text-slate-500 max-w-sm mx-auto">Katalog produk pada kategori ini sedang diperbarui. Hubungi admin via WhatsApp untuk menanyakan stok dan pilihan model yang tersedia.</p>
        <a 
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=Halo%20Floragate,%20saya%20ingin%20tanya%20mengenai%20katalog%20bunga%20papan%20atau%20standing%20flower%20lainnya.`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex justify-center px-5 py-2.5 bg-primary text-white font-semibold text-xs rounded-md"
        >
          Tanya Admin via WhatsApp
        </a>
      </div>
    )}

    <!-- Dedicated SEO Rich Content Section for Tanbulampot -->
    {isTanbulampot && (
      <section class="mt-20 pt-16 border-t border-soft-cream/80">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <span class="text-secondary font-semibold text-xs tracking-widest uppercase block mb-2">Tren Hadiah Ramah Lingkungan</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-800">
              Mengenal Bunga Ucapan Tanaman &amp; Pohon Ucapan (Tanbulampot)
            </h2>
            <p class="text-slate-500 text-sm mt-3 leading-relaxed">
              Tanaman buah produktif dan tanaman hias dalam pot sebagai pilihan ucapan selamat yang tahan lama dan dapat terus dirawat.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <div class="p-6 rounded-2xl bg-white border border-soft-cream/70 shadow-xs">
              <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold mb-4">
                🌱
              </div>
              <h3 class="font-serif font-bold text-slate-800 text-base mb-2">Bunga Ucapan Tanaman Hidup</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Tanaman hidup dalam pot dapat dipajang dan dirawat dalam jangka panjang di kantor maupun rumah penerima sebagai kenang-kenangan yang tetap bertumbuh.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-soft-cream/70 shadow-xs">
              <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold mb-4">
                🍊
              </div>
              <h3 class="font-serif font-bold text-slate-800 text-base mb-2">Ucapan Bibit Pohon &amp; Buah</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Bibit tanaman buah dalam pot, seperti jeruk nagami atau jeruk kimkit yang sudah berbuah, melambangkan pertumbuhan usaha dan rezeki yang terus berbuah.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-soft-cream/70 shadow-xs">
              <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold mb-4">
                🎀
              </div>
              <h3 class="font-serif font-bold text-slate-800 text-base mb-2">Karangan Bibit Tanaman Rapi</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Setiap tanaman ditata rapi dalam pot keramik dengan hiasan pita satin dan kartu ucapan kustom, siap dikirim ke lokasi acara di Malang Raya.
              </p>
            </div>
          </div>

          <!-- Editorial Paragraphs for Search Engines & Visitors -->
          <div class="prose prose-slate max-w-none text-xs sm:text-sm leading-relaxed text-slate-600 space-y-4 bg-accent-bg/40 p-8 rounded-2xl border border-soft-cream/70">
            <h3 class="font-serif text-lg font-bold text-slate-800">
              Pilihan Pohon Ucapan &amp; Bibit Tanaman di Malang
            </h3>
            <p>
              Untuk Anda yang mencari alternatif selain bunga potong, Floragate menyediakan <strong>bunga ucapan tanaman</strong> dan <strong>pohon ucapan</strong> buah dalam pot (tanbulampot). Tanaman hidup lebih tahan lama, ramah lingkungan, dan dapat dirawat oleh penerima setelah acara selesai.
            </p>
            <p>
              Setiap <strong>karangan bibit tanaman</strong> dipilih dari tanaman yang sehat dan siap pajang. Dilengkapi kartu ucapan eksklusif berisi nama pengirim dan pesan selamat, paket <strong>karangan bunga tanaman</strong> ini cocok untuk ucapan peresmian toko baru, pembukaan kantor cabang, serah terima jabatan, hingga kado kelulusan di Kota Malang, Kabupaten Malang, dan Kota Batu.
            </p>
          </div>

          <!-- FAQ Accordion / Cards -->
          <div class="mt-12 space-y-4">
            <h3 class="font-serif text-xl font-bold text-slate-800 mb-6 text-center">
              Pertanyaan Umum Seputar Pohon Ucapan &amp; Tanbulampot
            </h3>

            <div class="p-5 rounded-xl bg-white border border-soft-cream/80">
              <h4 class="font-bold text-sm text-slate-800 mb-1">
                Apakah jenis bibit pohon dan buah bisa dipilih sesuai permintaan?
              </h4>
              <p class="text-xs text-slate-500 leading-relaxed">
                Bisa. Anda dapat berkonsultasi via WhatsApp untuk memilih jenis bibit yang siap kirim, seperti pohon jeruk hias, tin, jambu, atau tanaman hias daun tropis.
              </p>
            </div>


---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CATEGORIES, PRODUCTS } from '../data/products';
import { getProductDisplayName } from '../utils/productHelpers';
import { withBase } from '../utils/paths';

// SEO Meta
const title = "Katalog Karangan Bunga Floragate — Toko Bunga Malang";
const description = "Bunga papan, hand bouquet, standing flower, dan tanaman ucapan di Malang. Pengerjaan 3 jam, difoto sebelum dikirim. Pilih model dan pesan via WhatsApp.";
---

<Layout title={title} description={description}>
  {PRODUCTS.length > 0 && (
    <link
      slot="head"
      rel="preload"
      as="image"
      type="image/webp"
      href={withBase(PRODUCTS[0].image)}
      fetchpriority="high"
    />
  )}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb -->
    <Breadcrumb items={[{ label: 'Katalog Produk' }]} />

    <!-- Page Header -->
    <div class="text-center max-w-2xl mx-auto mt-6 mb-12">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Katalog Karangan Bunga &amp; Tanaman Malang</h1>
      <p class="text-slate-500 text-sm mt-3 leading-relaxed">
        Pilihan karangan bunga papan, buket, standing flower, bunga meja, dan tanaman ucapan. Pilih model yang Anda butuhkan dan konfirmasikan via WhatsApp; pesanan selalu kami fotokan sebelum diantar ke lokasi.
      </p>
    </div>

    <!-- Filter Buttons (Client-side interactivity) -->
    <div class="flex flex-wrap justify-center gap-2 mb-10" id="filter-container">
      <button 
        type="button"
        data-filter="all"
        class="filter-btn px-4 py-2 text-xs font-semibold rounded-full border border-primary bg-primary text-white transition-colors duration-200 cursor-pointer shadow-xs"
      >
        Semua Kategori
      </button>
      
      {CATEGORIES.map(category => (
        <button
          type="button"
          data-filter={category.slug}
          class="filter-btn px-4 py-2 text-xs font-semibold rounded-full border border-soft-cream bg-white text-slate-600 hover:border-primary hover:text-primary transition-colors duration-200 cursor-pointer shadow-xs"
        >
          {category.name}
        </button>
      ))}
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="products-grid">
      {PRODUCTS.map((product, index) => (
        <div 
          class="product-item-wrapper" 
          data-category={product.categorySlug}
          data-name={getProductDisplayName(product).toLowerCase()}
          data-description={product.description.toLowerCase()}
        >
          <ProductCard product={product} priority={index === 0} />
        </div>
      ))}
    </div>
    
    <!-- Pagination Controls -->
    <div id="pagination-wrapper" class="mt-12 flex flex-col items-center gap-3">
      <nav id="pagination-nav" class="flex flex-wrap justify-center items-center gap-2" aria-label="Navigasi Halaman Produk">
        <!-- Buttons injected by script -->
      </nav>
      <p id="pagination-info" class="text-xs text-slate-500 font-medium"></p>
    </div>
    
    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-20 space-y-4">
      <svg class="h-16 w-16 text-slate-300 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 115.314-3.078 5.625 5.625 0 01-5.6 5.6H6.75A4.5 4.5 0 002.25 15z" />
      </svg>
      <h3 class="font-serif font-bold text-lg text-slate-700">Produk Tidak Ditemukan</h3>
      <p class="text-sm text-slate-500 max-w-sm mx-auto">Tidak ada produk yang cocok dengan kata kunci pencarian. Silakan coba kata kunci lain seperti &ldquo;duka cita&rdquo;, &ldquo;wedding&rdquo;, atau pilih salah satu kategori di atas.</p>
    </div>

  </div>
</Layout>

<script>
  // Filter & Search Logic with Pagination
  const buttons = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.product-item-wrapper');
  const emptyState = document.getElementById('empty-state');
  const ITEMS_PER_PAGE = 12;
  let currentPage = 1;
  let matchingItems: HTMLElement[] = [];

  // Read URL query parameters
  const urlParams = new URLSearchParams(window.location.search);
  const searchParam = (urlParams.get('search') || '').toLowerCase().slice(0, 80);

  // Store active filters state
  let currentCategory = 'all';
  let currentSearch = searchParam;

  // Sync navbar search fields and listen for live input
  const searchInputs = document.querySelectorAll('.search-input-field');
  searchInputs.forEach(input => {
    if (input instanceof HTMLInputElement) {
      input.value = currentSearch;

      input.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        currentSearch = target.value.toLowerCase().slice(0, 80);
        
        searchInputs.forEach(otherInput => {
          if (otherInput !== target && otherInput instanceof HTMLInputElement) {
            otherInput.value = target.value;
          }
        });

        const newUrl = new URL(window.location.href);
        if (currentSearch) {
          newUrl.searchParams.set('search', currentSearch);
        } else {
          newUrl.searchParams.delete('search');
        }
        window.history.replaceState({}, '', newUrl.toString());

        applyFilters();
      });
    }
  });

  const searchForms = document.querySelectorAll('form[action$="/katalog/"]');
  searchForms.forEach(form => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      applyFilters();
    });
  });

  function renderPagination(totalPages: number, totalItems: number) {
    const nav = document.getElementById('pagination-nav');
    const info = document.getElementById('pagination-info');
    if (!nav || !info) return;

    if (totalItems <= ITEMS_PER_PAGE) {
      nav.innerHTML = '';
      info.textContent = totalItems > 0 ? `Menampilkan ${totalItems} produk` : '';
      return;
    }

    const startIdx = (currentPage - 1) * ITEMS_PER_PAGE + 1;
    const endIdx = Math.min(currentPage * ITEMS_PER_PAGE, totalItems);
    info.textContent = `Menampilkan ${startIdx}-${endIdx} dari ${totalItems} produk`;

    let html = '';

    html += `<button type="button" class="pagination-btn px-3.5 h-10 flex items-center justify-center rounded-lg border border-soft-cream/80 bg-white text-slate-700 font-semibold text-xs transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shadow-xs" data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''} aria-label="Halaman sebelumnya">
      <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg> Sebelumnya
    </button>`;

    for (let p = 1; p <= totalPages; p++) {
      const isActive = p === currentPage;
      if (
        p === 1 ||
        p === totalPages ||
        (p >= currentPage - 1 && p <= currentPage + 1)
      ) {
        html += `<button type="button" class="pagination-btn min-w-[40px] h-10 px-3 flex items-center justify-center rounded-lg border text-xs font-bold transition-colors cursor-pointer shadow-xs ${isActive ? 'border-primary bg-primary text-white' : 'border-soft-cream/80 bg-white text-slate-700 hover:border-primary hover:text-primary'}" data-page="${p}" aria-current="${isActive ? 'page' : 'false'}" aria-label="Halaman ${p}">
          ${p}
        </button>`;
      } else if (
        (p === currentPage - 2 && p > 1) ||
        (p === currentPage + 2 && p < totalPages)
      ) {
        html += `<span class="px-2 text-slate-400 select-none">...</span>`;
      }
    }

    html += `<button type="button" class="pagination-btn px-3.5 h-10 flex items-center justify-center rounded-lg border border-soft-cream/80 bg-white text-slate-700 font-semibold text-xs transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shadow-xs" data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''} aria-label="Halaman berikutnya">
      Berikutnya <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </button>`;

    nav.innerHTML = html;

    nav.querySelectorAll('.pagination-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetPage = parseInt((btn as HTMLElement).getAttribute('data-page') || '1', 10);
        if (targetPage && targetPage !== currentPage && targetPage >= 1 && targetPage <= totalPages) {
          currentPage = targetPage;
          updatePageItems();
          const grid = document.getElementById('products-grid');
          if (grid) {
            const offset = grid.getBoundingClientRect().top + window.scrollY - 100;
            window.scrollTo({ top: Math.max(0, offset), behavior: 'smooth' });
          }
        }
      });
    });
  }

  function updatePageItems() {
    const totalPages = Math.ceil(matchingItems.length / ITEMS_PER_PAGE) || 1;
    if (currentPage > totalPages) currentPage = 1;

    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const end = start + ITEMS_PER_PAGE;

    items.forEach(item => {
      if (item instanceof HTMLElement) item.classList.add('hidden');
    });

    matchingItems.forEach((item, idx) => {
      if (idx >= start && idx < end) {
        item.classList.remove('hidden');
      }
    });

    renderPagination(totalPages, matchingItems.length);
  }

  function applyFilters() {
    matchingItems = [];

    items.forEach(item => {
      if (!(item instanceof HTMLElement)) return;

      const itemCategory = item.getAttribute('data-category') || '';
      const itemName = item.getAttribute('data-name') || '';
      const itemDesc = item.getAttribute('data-description') || '';

      const matchesCategory = currentCategory === 'all' || itemCategory === currentCategory;
      const matchesSearch = currentSearch === '' || 
                            itemName.includes(currentSearch) || 
                            itemDesc.includes(currentSearch);

      if (matchesCategory && matchesSearch) {
        matchingItems.push(item);
      }
    });

    if (emptyState) {
      if (matchingItems.length === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    currentPage = 1;
    updatePageItems();
  }

  // Initial Run
  applyFilters();

  // Category filter buttons click handlers
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      buttons.forEach(btn => {
        btn.classList.remove('bg-primary', 'text-white', 'border-primary');
        btn.classList.add('bg-white', 'text-slate-600', 'border-soft-cream');
      });
      button.classList.remove('bg-white', 'text-slate-600', 'border-soft-cream');
      button.classList.add('bg-primary', 'text-white', 'border-primary');

      currentCategory = button.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });
</script>



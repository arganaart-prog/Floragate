---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { WHATSAPP_NUMBER } from '../data/constants';
import { withBase } from '../utils/paths';

const title = "Tentang Floragate - Toko Bunga Malang";
const description = "Floragate adalah toko bunga di Malang yang menyediakan berbagai karangan bunga papan, buket, standing flower, bunga meja, paper flower, dan tanaman buah dalam pot (tanbulampot) berkualitas.";

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Halo Floragate, saya ingin berkonsultasi dan memesan karangan bunga/tanaman dari Floragate di Malang.')}`;

const process = [
  {
    num: '01',
    title: 'Pilih & Konsultasi',
    body: 'Pilih model bunga di katalog atau kirimkan foto referensi yang Anda miliki via WhatsApp, lengkap dengan teks ucapan dan alamat tujuan.'
  },
  {
    num: '02',
    title: 'Konfirmasi Pesanan',
    body: 'Admin mengonfirmasi ketersediaan stok bunga segar hari ini, memastikan nuansa warna sesuai permintaan, dan memberi tahu estimasi waktu selesai.'
  },
  {
    num: '03',
    title: 'Proses Perangkaian',
    body: 'Pesanan dirangkai langsung di tempat oleh tim florist Floragate dengan susunan rapi dan teks ucapan yang jelas terbaca.'
  },
  {
    num: '04',
    title: 'Foto Hasil & Pengiriman',
    body: 'Sebelum berangkat, kami mengirimkan foto hasil jadi ke WhatsApp Anda untuk dicek. Setelah disetujui, kurir langsung mengantar ke lokasi tujuan.'
  }
];
---

<Layout title={title} description={description}>
<div class="ta-page">

  <!-- BREADCRUMB -->
  <div class="ta-breadcrumb">
    <Breadcrumb items={[{ label: 'Tentang Kami' }]} />
  </div>

  <!-- HERO: asymmetric split -->
  <section class="ta-hero">
    <div class="ta-hero-text">
      <p class="ta-label">Toko Bunga Malang</p>
      <h1 class="ta-hero-title">
        Melayani pemesanan kerajinan bunga di Malang untuk ucapan duka cita, pernikahan, dan peresmian.
      </h1>
      <div class="ta-hero-body">
        <p>
          Floragate melayani pemesanan kerajinan bunga di Malang, mulai dari karangan bunga papan, buket bunga segar, standing flower, 
          bunga meja, paper flower, hingga tanaman pohon ucapan.
        </p>
        <p>
          Setiap pesanan dirangkai menggunakan bunga segar pilihan dengan pengerjaan rata-rata 3 hingga 4 jam. 
          Sebelum pesanan diberangkatkan, kami selalu mengirimkan foto hasil jadi ke WhatsApp Anda untuk memastikan 
          ejaan nama, kalimat ucapan, dan kerapian susunan bunga sudah tepat sebelum tiba di lokasi.
        </p>
      </div>
      <div class="ta-hero-stats">
        <div class="ta-stat">
          <span class="ta-stat-n">500+</span>
          <span class="ta-stat-l">Pesanan terkirim</span>
        </div>
        <div class="ta-stat-sep" aria-hidden="true"></div>
        <div class="ta-stat">
          <span class="ta-stat-n">3&ndash;4 jam</span>
          <span class="ta-stat-l">Pengerjaan cepat</span>
        </div>
        <div class="ta-stat-sep" aria-hidden="true"></div>
        <div class="ta-stat">
          <span class="ta-stat-n">Malang Raya</span>
          <span class="ta-stat-l">Jangkauan kirim</span>
        </div>
      </div>
    </div>

    <div class="ta-hero-visual">
      <div class="ta-hero-img-wrap image-load-shell" data-image-frame>
        <span class="image-skeleton" aria-hidden="true"></span>
        <img
          src={withBase('/images/produk/tanbulampot/875.webp')}
          alt="Tanaman buah dalam pot (tanbulampot) berkualitas dari Floragate Malang"
          width="640"
          height="800"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          sizes="(min-width: 1024px) 42vw, 100vw"
          data-image-loader="true"
          class="relative z-0 w-full h-full object-cover object-center"
        />
      </div>
      <!-- Offset accent block -->
      <div class="ta-hero-accent" aria-hidden="true">
        <span class="ta-hero-accent-num">Floragate</span>
        <span class="ta-hero-accent-sub">Malang &middot; Est. 2022</span>
      </div>
    </div>
  </section>

  <!-- VALUES: 3-column editorial grid -->
  <section class="ta-values">
    <div class="ta-values-head">
      <p class="ta-label">Standar Pengerjaan</p>
      <h2 class="ta-values-title">Komitmen layanan pemesanan bunga di Floragate</h2>
    </div>

    <div class="ta-values-grid">

      <div class="ta-val">
        <div class="ta-val-num" aria-hidden="true">01</div>
        <h3 class="ta-val-title">Bunga Segar Pilihan</h3>
        <p class="ta-val-body">
          Bunga potong baru dirangkai pada hari pengiriman agar tetap segar selama acara berlangsung. 
          Kami selalu mengirimkan foto hasil jadi sebelum pesanan diberangkatkan.
        </p>
      </div>

      <div class="ta-val">
        <div class="ta-val-num" aria-hidden="true">02</div>
        <h3 class="ta-val-title">Rangkaian Tertata Rapi</h3>
        <p class="ta-val-body">
          Setiap karangan bunga dirangkai dengan teliti dan cermat, memastikan kerapian tata letak huruf ucapan dan keserasian kombinasi warna bunga terjaga dengan baik.
        </p>
      </div>

      <div class="ta-val">
        <div class="ta-val-num" aria-hidden="true">03</div>
        <h3 class="ta-val-title">Pengantaran Langsung oleh Kurir</h3>
        <p class="ta-val-body">
          Pesanan diantar langsung oleh kurir internal menggunakan kendaraan yang disesuaikan, 
          menjaga papan bunga atau buket tetap aman dari terpaan angin hingga sampai di lokasi.
        </p>
      </div>

    </div>
  </section>

  <!-- PROCESS: horizontal numbered steps -->
  <section class="ta-process">
    <div class="ta-process-head">
      <p class="ta-label">Alur Pemesanan</p>
      <h2 class="ta-process-title">Alur pesan praktis hingga bunga tiba di lokasi tujuan</h2>
    </div>

    <div class="ta-steps">
      {process.map((step, i) => (
        <div class="ta-step">
          <div class="ta-step-num" aria-hidden="true">{step.num}</div>
          {i < process.length - 1 && (
            <div class="ta-step-connector" aria-hidden="true"></div>
          )}
          <h3 class="ta-step-title">{step.title}</h3>
          <p class="ta-step-body">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PHOTOS: tanbulampot evidence -->
  <section class="ta-photos">
    <div class="ta-photo-wrap">
      <div class="ta-photo image-load-shell is-loaded" data-image-frame>
        <span class="image-skeleton" aria-hidden="true"></span>
        <img
          src={withBase('/images/produk/tanbulampot/1165.webp')}
          alt="Tanaman buah dalam pot (tanbulampot) berbuah lebat dari Floragate Malang"
          width="520" height="680"
          loading="eager" decoding="async"
          data-image-loader="true"
          onload="this.closest('[data-image-frame]')?.classList.add('is-loaded')"
          class="relative z-0 w-full h-full object-cover"
        />
      </div>
      <div class="ta-photo ta-photo--offset image-load-shell is-loaded" data-image-frame>
        <span class="image-skeleton" aria-hidden="true"></span>
        <img
          src={withBase('/images/produk/tanbulampot/845.webp')}
          alt="Pohon buah tanbulampot berkualitas dari Floragate Malang"
          width="520" height="680"
          loading="eager" decoding="async"
          data-image-loader="true"
          onload="this.closest('[data-image-frame]')?.classList.add('is-loaded')"
          class="relative z-0 w-full h-full object-cover"
        />
      </div>
    </div>
    <div class="ta-photo-caption">
      <p class="ta-label">Dokumentasi Produk</p>
      <p class="ta-photo-body">
        Semua foto produk di website ini adalah dokumentasi asli dari pesanan yang dibuat dan dikirimkan oleh Floragate di wilayah Malang Raya dan Batu.
      </p>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="ta-cta-link" id="tentang-wa-cta">
        Konsultasi & Pesan Sekarang
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </section>

</div>
</Layout>

<style>
  /* --------------------------------------------------------------------------
     Page wrapper
     -------------------------------------------------------------------------- */
  .ta-page {
    background: #f8f4ee;
    min-height: 100vh;
  }

  .ta-breadcrumb {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 2rem 0;
  }

  /* Shared eyebrow label */
  .ta-label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8aab6e;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .ta-label::before {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    flex-shrink: 0;
  }

  /* --------------------------------------------------------------------------
     HERO
     -------------------------------------------------------------------------- */
  .ta-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    max-width: 100%;
    min-height: 90vh;
    border-bottom: 1px solid #e2d8c8;
  }

  .ta-hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 3.5rem 5rem 6%;
    max-width: 640px;
    margin-left: auto;
    box-sizing: border-box;
  }

  .ta-hero-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.65rem, 2.8vw, 2.5rem);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: #1a2810;
    margin: 0 0 1.75rem;
  }

  .ta-hero-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .ta-hero-body p {
    font-size: 0.895rem;
    line-height: 1.78;
    color: #5a6348;
    margin: 0;
  }

  /* Stats */
  .ta-hero-stats {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid #ddd4c0;
  }

  .ta-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ta-stat-n {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: #2c3d20;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ta-stat-l {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9aab88;
    white-space: nowrap;
  }

  .ta-stat-sep {
    width: 1px;
    height: 34px;
    background: #d5c9b5;
    flex-shrink: 0;
  }

  /* Right visual column */
  .ta-hero-visual {
    position: relative;
    background: #ede8dc;
    overflow: hidden;
  }

  .ta-hero-img-wrap {
    position: absolute;
    inset: 0;
  }

  .ta-hero-accent {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    background: rgba(26, 40, 16, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 10px;
    padding: 1rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ta-hero-accent-num {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .ta-hero-accent-sub {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9aab88;
  }

  /* --------------------------------------------------------------------------
     VALUES
     -------------------------------------------------------------------------- */
  .ta-values {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 2rem;
    border-bottom: 1px solid #e2d8c8;
  }

  .ta-values-head {
    margin-bottom: 3.5rem;
  }

  .ta-values-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.022em;
    color: #1a2810;
    margin: 0;
    max-width: 560px;
  }

  .ta-values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid #e2d8c8;
    border-radius: 12px;
    overflow: hidden;
  }

  .ta-val {
    padding: 2.5rem 2rem;
    border-right: 1px solid #e2d8c8;
    background: #fff;
  }

  .ta-val:last-child {
    border-right: none;
  }

  .ta-val-num {
    font-size: 1.4rem;
    color: #8aab6e;
    font-weight: 700;
    font-family: var(--font-serif, Georgia, serif);
    margin-bottom: 1.1rem;
    line-height: 1;
  }

  .ta-val-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: #1a2810;
    margin: 0 0 0.85rem;
    line-height: 1.3;
  }

  .ta-val-body {
    font-size: 0.855rem;
    line-height: 1.72;
    color: #617058;
    margin: 0;
  }

  /* --------------------------------------------------------------------------
     PROCESS
     -------------------------------------------------------------------------- */
  .ta-process {
    background: #1a2810;
    padding: 5rem 2rem;
  }

  .ta-process-head {
    max-width: 1200px;
    margin: 0 auto 3.5rem;
  }

  .ta-process-head .ta-label {
    color: #8aab6e;
  }

  .ta-process-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.022em;
    color: #f5f0e8;
    margin: 0;
    max-width: 560px;
  }

  .ta-steps {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
  }

  .ta-step {
    position: relative;
    padding: 0 2rem 0 0;
  }

  .ta-step-num {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 3rem;
    font-weight: 700;
    color: rgba(138, 171, 110, 0.25);
    line-height: 1;
    margin-bottom: 1.25rem;
    letter-spacing: -0.04em;
  }

  /* Horizontal connector line */
  .ta-step-connector {
    position: absolute;
    top: 1.35rem; /* aligns with mid-height of the number */
    right: 0;
    width: calc(100% - 2.5rem);
    height: 1px;
    background: linear-gradient(to right, rgba(138,171,110,0.3), rgba(138,171,110,0.05));
    transform: translateX(50%);
  }

  .ta-step-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1rem;
    font-weight: 700;
    color: #f5f0e8;
    margin: 0 0 0.65rem;
    line-height: 1.3;
  }

  .ta-step-body {
    font-size: 0.83rem;
    line-height: 1.72;
    color: #8a9e78;
    margin: 0;
  }

  /* --------------------------------------------------------------------------
     PHOTOS
     -------------------------------------------------------------------------- */
  .ta-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid #e2d8c8;
    min-height: 600px;
  }

  .ta-photo-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 8px;
    background: #ede8dc;
  }

  .ta-photo {
    border-radius: 8px;
    overflow: hidden;
    background: #ddd6c8;
    aspect-ratio: 3 / 4;
  }

  .ta-photo--offset {
    margin-top: 3rem;
    margin-bottom: -3rem;
  }

  .ta-photo-caption {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 3.5rem 4rem 4rem;
    background: #f8f4ee;
  }

  .ta-photo-body {
    font-size: 0.9rem;
    line-height: 1.75;
    color: #5a6348;
    max-width: 420px;
    margin: 0 0 2.25rem;
  }

  .ta-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #3d4e36;
    text-decoration: none;
    border-bottom: 1.5px solid #3d4e36;
    padding-bottom: 2px;
    width: fit-content;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .ta-cta-link:hover {
    color: #1a2810;
    border-color: #1a2810;
  }

  .ta-cta-link svg {
    width: 14px;
    height: 14px;
    transition: transform 0.15s ease;
  }

  .ta-cta-link:hover svg {
    transform: translateX(3px);
  }

  /* --------------------------------------------------------------------------
     RESPONSIVE
     -------------------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .ta-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .ta-hero-visual {
      height: 55vw;
      max-height: 440px;
      min-height: 280px;
    }

    .ta-hero-text {
      max-width: 100%;
      padding: 3rem 1.5rem;
    }

    .ta-steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    .ta-step-connector {
      display: none;
    }

    .ta-photos {
      grid-template-columns: 1fr;
    }

    .ta-photo-wrap {
      min-height: 400px;
    }

    .ta-photo-caption {
      padding: 2.5rem 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .ta-breadcrumb {
      padding: 1.25rem 1.25rem 0;
    }

    .ta-values {
      padding: 3.5rem 1.25rem;
    }

    .ta-values-grid {
      grid-template-columns: 1fr;
    }

    .ta-val {
      border-right: none;
      border-bottom: 1px solid #e2d8c8;
    }

    .ta-val:last-child {
      border-bottom: none;
    }

    .ta-process {
      padding: 3.5rem 1.25rem;
    }

    .ta-steps {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .ta-photo-wrap {
      grid-template-columns: 1fr 1fr;
    }

    .ta-photo--offset {
      margin-top: 1.5rem;
      margin-bottom: -1.5rem;
    }

    .ta-hero-stats {
      flex-wrap: wrap;
      gap: 1rem 1.5rem;
    }

    .ta-stat-sep {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .ta-photo-wrap {
      grid-template-columns: 1fr;
    }

    .ta-photo--offset {
      margin: 0;
    }
  }
</style>

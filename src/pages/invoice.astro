---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';
import { withBase } from '../utils/paths';
import { getProductDisplayName } from '../utils/productHelpers';

const title = 'Invoice Generator Internal | Floragate';
const description = 'Halaman internal pembuatan invoice pesanan Floragate Malang.';

const catalogItems = PRODUCTS.map((p) => ({
  slug: p.slug,
  name: getProductDisplayName(p),
  category: p.categoryName,
  price: p.priceFrom,
}));
---

<Layout
  title={title}
  description={description}
  robots="noindex, nofollow"
  showTestimonials={false}
  showGallery={false}
>
  <div class="invoice-page-wrap max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- ==================== LOGIN GATE ==================== -->
    <section
      id="invoice-login-gate"
      class="no-print max-w-md mx-auto my-8 sm:my-14 rounded-2xl border border-soft-cream bg-white p-7 sm:p-9 shadow-[0_20px_50px_rgba(63,75,55,0.08)]"
      aria-labelledby="login-heading"
    >
      <div class="text-center mb-7">
        <div class="mx-auto mb-4 flex h-20 w-16 items-center justify-center rounded-t-full rounded-b-md border border-secondary/70 bg-accent-bg p-2 shadow-xs">
          <img
            src={withBase('/images/logo/logo.webp')}
            alt="Logo Floragate"
            class="h-12 w-auto object-contain"
            width="64"
            height="62"
          />
        </div>
        <span class="text-[11px] font-bold uppercase tracking-[0.22em] text-secondary-dark">Admin Floragate</span>
        <h1 id="login-heading" class="mt-1.5 font-serif text-2xl sm:text-3xl font-bold text-primary-dark">
          Login Pembuat Invoice
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-slate-500">
          Masuk dengan akun admin untuk membuat, mengatur status bayar, dan mencetak invoice pelanggan.
        </p>
      </div>

      <form id="invoice-login-form" class="space-y-4" novalidate>
        <div>
          <label for="login-email" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Email Admin
          </label>
          <input
            id="login-email"
            type="email"
            required
            autocomplete="username"
            placeholder="nama@gmail.com"
            class="w-full rounded-xl border border-soft-cream bg-clean-ivory/40 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
        </div>

        <div>
          <label for="login-password" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Kata Sandi
          </label>
          <div class="relative">
            <input
              id="login-password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="Masukkan kata sandi"
              class="w-full rounded-xl border border-soft-cream bg-clean-ivory/40 px-4 py-3 pr-11 text-sm text-slate-800 placeholder:text-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
            <button
              type="button"
              id="toggle-password-btn"
              class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 text-slate-400 hover:text-primary cursor-pointer"
              aria-label="Tampilkan atau sembunyikan kata sandi"
            >
              <svg id="eye-open-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <svg id="eye-closed-icon" class="hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
              </svg>
            </button>
          </div>
        </div>

        <label class="flex items-center gap-2.5 text-xs text-slate-600 cursor-pointer select-none">
          <input
            id="login-remember"
            type="checkbox"
            checked
            class="h-4 w-4 rounded border-soft-cream text-primary focus:ring-primary/30"
          />
          <span>Tetap masuk di browser ini</span>
        </label>

        <p id="login-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-medium text-red-700" role="alert"></p>

        <button
          type="submit"
          class="w-full rounded-xl bg-primary hover:bg-primary-dark px-5 py-3.5 text-sm font-bold text-white shadow-md transition-colors cursor-pointer"
        >
          Masuk ke Invoice Builder
        </button>
      </form>
    </section>

    <!-- ==================== INVOICE BUILDER WORKSPACE ==================== -->
    <section id="invoice-workspace" class="hidden" aria-label="Workspace Pembuat Invoice">
      <!-- Top Action Bar -->
      <div class="no-print mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border border-soft-cream bg-white p-4 sm:px-6 shadow-xs">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-secondary-dark">Floragate Billing</span>
          <h1 class="font-serif text-xl sm:text-2xl font-bold text-primary-dark">Pembuat Invoice Pelanggan</h1>
          <p id="active-user-label" class="text-xs text-slate-500 mt-0.5"></p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            id="btn-new-invoice"
            class="inline-flex items-center gap-1.5 rounded-xl border border-soft-cream bg-accent-bg px-3.5 py-2.5 text-xs font-bold text-primary-dark hover:border-secondary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Invoice Baru
          </button>

          <button
            type="button"
            id="btn-download-pdf"
            class="inline-flex items-center gap-2 rounded-xl bg-primary hover:bg-primary-dark px-4 py-2.5 text-xs font-bold text-white shadow-sm transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Simpan / Unduh PDF
          </button>

          <button
            type="button"
            id="btn-print-invoice"
            class="inline-flex items-center gap-2 rounded-xl border border-soft-cream bg-white hover:bg-clean-ivory/60 px-3.5 py-2.5 text-xs font-bold text-slate-700 transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Cetak (Print)
          </button>

          <button
            type="button"
            id="btn-create-kwitansi"
            class="inline-flex items-center gap-1.5 rounded-xl border border-amber-300 bg-amber-50 hover:bg-amber-100 px-3.5 py-2.5 text-xs font-bold text-amber-900 transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Buat Kwitansi
          </button>

          <button
            type="button"
            id="btn-open-excel-modal"
            class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-300 bg-emerald-50 hover:bg-emerald-100 px-3.5 py-2.5 text-xs font-bold text-emerald-800 transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Data Excel (<span id="excel-count-badge">0</span>)
          </button>

          <button
            type="button"
            id="btn-logout"
            class="inline-flex items-center gap-1.5 rounded-xl border border-red-200 bg-red-50/70 hover:bg-red-100 px-3 py-2.5 text-xs font-bold text-red-700 transition-colors cursor-pointer"
          >
            Keluar
          </button>
        </div>
      </div>

      <!-- Mobile Tab Switcher (Edit Form vs Preview) -->
      <div class="no-print xl:hidden grid grid-cols-2 gap-2 mb-5 rounded-2xl border border-soft-cream bg-white p-1.5 shadow-sm sticky top-3 z-30">
        <button
          type="button"
          id="mobile-tab-edit"
          class="rounded-xl py-2.5 text-xs font-bold bg-primary text-white shadow-xs transition-colors cursor-pointer"
        >
          ✏️ 1. Isi Data Invoice
        </button>
        <button
          type="button"
          id="mobile-tab-preview"
          class="rounded-xl py-2.5 text-xs font-bold text-slate-600 hover:text-primary transition-colors cursor-pointer"
        >
          📄 2. Lihat Invoice &amp; PDF
        </button>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-12 gap-7 items-start">
        <!-- ========== LEFT COLUMN: EDITOR FORM ========== -->
        <aside id="editor-panel" class="no-print xl:col-span-5 space-y-5">
          <div id="invoice-editor-cards" class="space-y-5">
          <!-- Card 1: Info Invoice & Status Pembayaran -->
          <div class="rounded-2xl border border-soft-cream bg-white p-5 shadow-xs space-y-4">
            <h2 class="font-serif text-base font-bold text-primary-dark border-b border-soft-cream/70 pb-2.5">
              1. Nomor &amp; Status Pembayaran
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="f-invoice-no" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Invoice No.</label>
                <input id="f-invoice-no" type="text" class="inv-input" />
              </div>
              <div>
                <label for="f-po-number" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">PO Number (Opsional)</label>
                <input id="f-po-number" type="text" placeholder="Mis: PO-2026-001" class="inv-input" />
              </div>
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label for="f-issue-date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">Tanggal Terbit</label>
                  <button type="button" id="btn-issue-today" class="text-[10px] font-bold text-primary hover:underline cursor-pointer">Set Hari Ini</button>
                </div>
                <input id="f-issue-date" type="date" class="inv-input bg-white cursor-pointer" />
              </div>
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label for="f-due-date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">Jatuh Tempo</label>
                  <div class="flex items-center gap-1.5 text-[10px]">
                    <button type="button" data-due-offset="0" class="due-preset-btn font-bold text-primary hover:underline cursor-pointer">Hari Ini</button>
                    <span class="text-slate-300">&bull;</span>
                    <button type="button" data-due-offset="1" class="due-preset-btn font-bold text-primary hover:underline cursor-pointer">+1 Hari</button>
                  </div>
                </div>
                <input id="f-due-date" type="date" class="inv-input bg-white cursor-pointer" />
              </div>
              <div class="sm:col-span-2 space-y-1.5">
                <label for="f-payment-terms" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">Payment Terms (Syarat Pembayaran)</label>
                <input id="f-payment-terms" type="text" placeholder="Mis: Transfer / Lunas Sebelum Kirim" class="inv-input" />
                <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                  <span class="text-[10px] font-bold text-slate-500">Pilih Cepat:</span>
                  <button type="button" data-terms-preset="Transfer / Lunas Sebelum Kirim" class="terms-preset-btn rounded-md border border-soft-cream bg-clean-ivory/40 px-2 py-0.5 text-[10px] font-bold text-primary-dark hover:border-primary cursor-pointer">Lunas Sebelum Kirim</button>
                  <button type="button" data-terms-preset="DP 50% & Pelunasan Sebelum Kirim" class="terms-preset-btn rounded-md border border-soft-cream bg-clean-ivory/40 px-2 py-0.5 text-[10px] font-bold text-primary-dark hover:border-primary cursor-pointer">DP 50%</button>
                  <button type="button" data-terms-preset="Net 7 Days" class="terms-preset-btn rounded-md border border-soft-cream bg-clean-ivory/40 px-2 py-0.5 text-[10px] font-bold text-primary-dark hover:border-primary cursor-pointer">Net 7 Days</button>
                  <button type="button" data-terms-preset="Net 14 Days" class="terms-preset-btn rounded-md border border-soft-cream bg-clean-ivory/40 px-2 py-0.5 text-[10px] font-bold text-primary-dark hover:border-primary cursor-pointer">Net 14 Days</button>
                </div>
              </div>
            </div>

            <!-- Status Pembayaran: Sudah Dibayar / DP / Belum Dibayar -->
            <div>
              <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Status Pembayaran</span>
              <div class="grid grid-cols-3 gap-2" role="radiogroup" aria-label="Pilih status pembayaran">
                <button
                  type="button"
                  data-status-btn="paid"
                  class="status-choice-btn rounded-xl border border-soft-cream bg-clean-ivory/40 px-2.5 py-2.5 text-center text-xs font-bold text-slate-700 transition-all cursor-pointer"
                >
                  Sudah Dibayar
                </button>
                <button
                  type="button"
                  data-status-btn="dp"
                  class="status-choice-btn rounded-xl border border-soft-cream bg-clean-ivory/40 px-2.5 py-2.5 text-center text-xs font-bold text-slate-700 transition-all cursor-pointer"
                >
                  DP (Uang Muka)
                </button>
                <button
                  type="button"
                  data-status-btn="unpaid"
                  class="status-choice-btn rounded-xl border border-soft-cream bg-clean-ivory/40 px-2.5 py-2.5 text-center text-xs font-bold text-slate-700 transition-all cursor-pointer"
                >
                  Belum Dibayar
                </button>
              </div>
            </div>

            <!-- DP Nominal Input (hanya muncul jika status DP dipilih) -->
            <div id="dp-input-wrap" class="hidden rounded-xl border border-secondary/50 bg-accent-bg/70 p-3.5 space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <label for="f-dp-amount" class="text-xs font-bold text-secondary-dark">Nominal DP Diterima (Rp)</label>
                <div class="flex items-center gap-1.5">
                  <button type="button" data-dp-percent="30" class="dp-preset-btn rounded-md bg-white px-2 py-1 text-[10px] font-bold text-primary-dark border border-soft-cream hover:border-primary cursor-pointer">DP 30%</button>
                  <button type="button" data-dp-percent="50" class="dp-preset-btn rounded-md bg-white px-2 py-1 text-[10px] font-bold text-primary-dark border border-soft-cream hover:border-primary cursor-pointer">DP 50%</button>
                </div>
              </div>
              <input id="f-dp-amount" type="number" min="0" step="5000" placeholder="Contoh: 350000" class="inv-input bg-white" />
              <p class="text-[11px] text-slate-500">Sisa tagihan otomatis dihitung di rincian invoice.</p>
            </div>
          </div>

          <!-- Card 2: Data Pemesan (Billed To) & Pengiriman (Delivery Details) -->
          <div class="rounded-2xl border border-soft-cream bg-white p-5 shadow-xs space-y-4">
            <h2 class="font-serif text-base font-bold text-primary-dark border-b border-soft-cream/70 pb-2.5">
              2. Data Pemesan &amp; Pengiriman
            </h2>

            <div class="space-y-3">
              <p class="text-[11px] font-bold uppercase tracking-widest text-primary">Billed To (Pemesan)</p>
              <input id="f-client-name" type="text" placeholder="Nama pemesan / perusahaan" class="inv-input" />
              <input id="f-client-contact" type="text" placeholder="No. WhatsApp / Email pemesan" class="inv-input" />
              <input id="f-client-address" type="text" placeholder="Alamat pemesan / kota" class="inv-input" />
            </div>

            <div class="pt-2 border-t border-soft-cream/50 space-y-3">
              <p class="text-[11px] font-bold uppercase tracking-widest text-primary">Delivery Details (Pengiriman)</p>
              <input id="f-recipient-name" type="text" placeholder="Nama penerima / keluarga / instansi" class="inv-input" />
              
              <!-- Fitur Set Jadwal Pengiriman (Pilih Tanggal & Jam Tanpa Ngetik Manual) -->
              <div class="rounded-xl border border-soft-cream/90 bg-clean-ivory/35 p-3 space-y-2.5">
                <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-600">
                  Set Jadwal Pengiriman (Tinggal Pilih)
                </span>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  <div>
                    <label for="f-delivery-date" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">
                      Pilih Tanggal Kirim
                    </label>
                    <input id="f-delivery-date" type="date" class="inv-input bg-white cursor-pointer" />
                  </div>
                  <div>
                    <label for="f-delivery-time" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">
                      Pilih Jam Kirim (WIB)
                    </label>
                    <input id="f-delivery-time" type="time" value="09:00" class="inv-input bg-white cursor-pointer" />
                  </div>
                </div>

                <!-- Tombol Cepat Tanggal & Jam -->
                <div class="flex flex-wrap items-center justify-between gap-2 pt-1 border-t border-soft-cream/60">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[10px] font-bold text-slate-500">Pilih Tanggal:</span>
                    <button type="button" data-deliv-date-offset="0" class="deliv-date-preset rounded-md border border-soft-cream bg-white px-2 py-0.5 text-[10px] font-bold text-primary-dark hover:border-primary cursor-pointer">Hari Ini</button>
                    <button type="button" data-deliv-date-offset="1" class="deliv-date-preset rounded-md border border-soft-cream bg-white px-2 py-0.5 text-[10px] font-bold text-primary-dark hover:border-primary cursor-pointer">Besok</button>
                    <button type="button" data-deliv-date-offset="2" class="deliv-date-preset rounded-md border border-soft-cream bg-white px-2 py-0.5 text-[10px] font-bold text-primary-dark hover:border-primary cursor-pointer">Lusa</button>
                  </div>

                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[10px] font-bold text-slate-500">Pilih Jam:</span>
                    <button type="button" data-deliv-time="09:00" class="deliv-time-preset rounded-md border border-soft-cream bg-white px-1.5 py-0.5 text-[10px] font-bold text-slate-700 hover:border-primary cursor-pointer">09.00</button>
                    <button type="button" data-deliv-time="13:00" class="deliv-time-preset rounded-md border border-soft-cream bg-white px-1.5 py-0.5 text-[10px] font-bold text-slate-700 hover:border-primary cursor-pointer">13.00</button>
                    <button type="button" data-deliv-time="15:00" class="deliv-time-preset rounded-md border border-soft-cream bg-white px-1.5 py-0.5 text-[10px] font-bold text-slate-700 hover:border-primary cursor-pointer">15.00</button>
                    <button type="button" data-deliv-time="19:00" class="deliv-time-preset rounded-md border border-soft-cream bg-white px-1.5 py-0.5 text-[10px] font-bold text-slate-700 hover:border-primary cursor-pointer">19.00</button>
                  </div>
                </div>
              </div>

              <input id="f-delivery-address" type="text" placeholder="Alamat lengkap pengiriman di Malang" class="inv-input" />
            </div>
          </div>

          <!-- Card 3: Daftar Produk (Nama Produk, Harga, Jumlah) -->
          <div class="rounded-2xl border border-soft-cream bg-white p-5 shadow-xs space-y-4">
            <div class="flex items-center justify-between gap-2 border-b border-soft-cream/70 pb-2.5">
              <h2 class="font-serif text-base font-bold text-primary-dark">
                3. Produk &amp; Ongkir
              </h2>
              <button
                type="button"
                id="btn-add-item"
                class="inline-flex items-center gap-1 rounded-lg bg-primary hover:bg-primary-dark px-3 py-1.5 text-xs font-bold text-white transition-colors cursor-pointer"
              >
                + Tambah Produk
              </button>
            </div>

            <!-- Quick Pick from Catalog -->
            <div class="rounded-xl border border-soft-cream/80 bg-accent-bg/50 p-3 space-y-2">
              <label for="catalog-quick-select" class="block text-[11px] font-bold text-secondary-dark">
                Pilih Cepat dari Katalog (Opsional)
              </label>
              <div class="flex gap-2">
                <select id="catalog-quick-select" class="inv-input bg-white text-xs">
                  <option value="">-- Pilih produk katalog --</option>
                  {catalogItems.map((item) => (
                    <option value={item.slug} data-name={item.name} data-price={item.price}>
                      {item.name} — Rp {item.price.toLocaleString('id-ID')}
                    </option>
                  ))}
                </select>
                <button
                  type="button"
                  id="btn-insert-catalog"
                  class="shrink-0 rounded-lg border border-primary bg-white px-3 py-2 text-xs font-bold text-primary hover:bg-primary hover:text-white transition-colors cursor-pointer"
                >
                  Tambah
                </button>
              </div>
            </div>

            <!-- Dynamic Items Editor List -->
            <div id="items-editor-list" class="space-y-3"></div>

            <!-- Ongkir -->
            <div class="pt-2 border-t border-soft-cream/60 space-y-3">
              <div>
                <label for="f-shipping-fee" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">

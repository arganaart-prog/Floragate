    function escapeCsvCell(val: unknown): string {
      const str = String(val ?? '').replace(/\r?\n/g, ' ');
      return `"${str.replace(/"/g, '""')}"`;
    }

    function buildCsvContent(rows: InvoiceExcelRow[]): string {
      const headers = [
        'No',
        'No. Invoice',
        'PO Number',
        'Tanggal Invoice',
        'Jatuh Tempo',
        'Status Pembayaran',
        'Payment Terms',
        'Nama Pemesan',
        'Kontak Pemesan',
        'Alamat Pemesan',
        'Nama Penerima',
        'Jadwal Pengiriman',
        'Alamat Pengiriman',
        'Daftar Produk',
        'Subtotal (Rp)',
        'Ongkir Produk (Rp)',
        'Ongkir Invoice Fisik (Rp)',
        'Grand Total (Rp)',
        'DP Dibayar (Rp)',
        'Sisa Pembayaran (Rp)',
        'Rekening Dipilih',
        'Stempel Digital',
        'Waktu Dicatat',
      ];

      const csvLines = [
        'sep=;',
        headers.map(escapeCsvCell).join(';'),
        ...rows.map((r, i) =>
          [
            i + 1,
            r.invoiceNo,
            r.poNumber,
            r.issueDate,
            r.dueDate,
            r.statusLabel,
            r.paymentTerms,
            r.clientName,
            r.clientContact,
            r.clientAddress,
            r.recipientName,
            r.deliveryDatetime,
            r.deliveryAddress,
            r.itemsSummary,
            r.subtotal,
            r.shippingFee,
            r.physicalInvoiceShipping,
            r.grandTotal,
            r.dpAmount,
            r.balanceDue,
            r.accountsSummary,
            r.digitalStamp,
            r.recordedAt,
          ]
            .map(escapeCsvCell)
            .join(';')
        ),
      ];

      return '\uFEFF' + csvLines.join('\r\n');
    }

    function parseCsvLine(line: string, sep: string): string[] {
      const cells: string[] = [];
      let cur = '';
      let inQuotes = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') {
          if (inQuotes && line[i + 1] === '"') {
            cur += '"';
            i++;
          } else {
            inQuotes = !inQuotes;
          }
        } else if (ch === sep && !inQuotes) {
          cells.push(cur);
          cur = '';
        } else {
          cur += ch;
        }
      }
      cells.push(cur);
      return cells;
    }

    function importRowsFromCsvText(text: string): InvoiceExcelRow[] {
      const clean = text.replace(/^\uFEFF/, '');
      const lines = clean.split(/\r?\n/).filter((l) => l.trim().length > 0);
      if (lines.length === 0) return [];
      let sep = ';';
      let startIdx = 0;
      if (lines[0].toLowerCase().startsWith('sep=')) {
        sep = lines[0].slice(4, 5) || ';';
        startIdx = 1;
      } else if (lines[0].includes(',') && !lines[0].includes(';')) {
        sep = ',';
      }
      if (lines.length <= startIdx + 1) return [];
      const headerCols = parseCsvLine(lines[startIdx], sep).map((h) => h.trim().toLowerCase());
      // Local CSV has 'No' at col 0 and 'No. Invoice' at col 1; Google Sheet has 'No. Invoice' at col 0
      const offset = headerCols[0] === 'no' ? 1 : 0;

      const imported: InvoiceExcelRow[] = [];
      for (let i = startIdx + 1; i < lines.length; i++) {
        const c = parseCsvLine(lines[i], sep);
        const invNo = (c[0 + offset] || '').trim();
        if (!invNo || invNo === '-') continue;
        imported.push({
          invoiceNo: invNo,
          poNumber: c[1 + offset] || '-',
          issueDate: c[2 + offset] || todayISO,
          dueDate: c[3 + offset] || todayISO,
          statusLabel: c[4 + offset] || 'Belum Dibayar',
          paymentTerms: c[5 + offset] || '-',
          clientName: c[6 + offset] || '-',
          clientContact: c[7 + offset] || '-',
          clientAddress: c[8 + offset] || '-',
          recipientName: c[9 + offset] || '-',
          deliveryDatetime: c[10 + offset] || '-',
          deliveryAddress: c[11 + offset] || '-',
          itemsSummary: c[12 + offset] || '-',
          subtotal: Number(c[13 + offset]) || 0,
          shippingFee: Number(c[14 + offset]) || 0,
          physicalInvoiceShipping: Number(c[15 + offset]) || 0,
          grandTotal: Number(c[16 + offset]) || 0,
          dpAmount: Number(c[17 + offset]) || 0,
          balanceDue: Number(c[18 + offset]) || 0,
          accountsSummary: c[19 + offset] || '-',
          digitalStamp: c[20 + offset] || 'Ya',
          recordedAt: c[21 + offset] || '-',
        });
      }
      return imported;
    }

    // IndexedDB persistence for FileSystemFileHandle
    const FS_DB_NAME = 'fg_invoice_fs_db';
    const FS_STORE_NAME = 'handles';
    const FS_HANDLE_KEY = 'excelFileHandle';
    const GSHEET_KEY = 'fg_invoice_gsheet_url_v1';
    const GSHEET_ID = '1FlRef9VF0GTHWjtiwpGXiONv3xKPCRAMLf7KZMCl8TY';
    const DEFAULT_GSHEET_WEBHOOK = 'https://script.google.com/macros/s/AKfycbwPaMi4dmVdY_KvXv2-QQ07K8jFw_nlJ_HWFJseyKC7xzZRUl4gvYf1y4hGESUnQmdL/exec';
    let linkedFileHandle: any = null;

    function openFsDb(): Promise<IDBDatabase> {
      return new Promise((resolve, reject) => {
        const req = indexedDB.open(FS_DB_NAME, 1);
        req.onupgradeneeded = () => {
          if (!req.result.objectStoreNames.contains(FS_STORE_NAME)) {
            req.result.createObjectStore(FS_STORE_NAME);
          }
        };
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error);
      });
    }

    async function saveLinkedHandle(handle: any) {
      linkedFileHandle = handle;
      try {
        const db = await openFsDb();
        const tx = db.transaction(FS_STORE_NAME, 'readwrite');
        tx.objectStore(FS_STORE_NAME).put(handle, FS_HANDLE_KEY);
      } catch {
        // Ignore IDB errors
      }
      await updateLinkedFileUI();
    }

    async function clearLinkedHandle() {
      linkedFileHandle = null;
      try {
        const db = await openFsDb();
        const tx = db.transaction(FS_STORE_NAME, 'readwrite');
        tx.objectStore(FS_STORE_NAME).delete(FS_HANDLE_KEY);
      } catch {
        // Ignore
      }
      await updateLinkedFileUI();
    }

    async function restoreLinkedHandle() {
      if (typeof indexedDB === 'undefined') return;
      try {
        const db = await openFsDb();
        const tx = db.transaction(FS_STORE_NAME, 'readonly');
        const req = tx.objectStore(FS_STORE_NAME).get(FS_HANDLE_KEY);
        req.onsuccess = async () => {
          if (req.result) {
            linkedFileHandle = req.result;
          }
          await updateLinkedFileUI();
        };
      } catch {
        await updateLinkedFileUI();
      }
    }

    async function updateLinkedFileUI() {
      const statusEl = document.getElementById('excel-link-status');
      const permBtn = document.getElementById('btn-grant-excel-perm');
      const unlinkBtn = document.getElementById('btn-unlink-excel');
      const supportsFs = 'showSaveFilePicker' in window;

      if (!supportsFs) {
        if (statusEl) statusEl.textContent = 'Browser ini tidak mendukung koneksi file lokal langsung (gunakan Download Excel atau Google Sheets).';
        document.getElementById('btn-link-new-excel')?.classList.add('hidden');
        document.getElementById('btn-link-existing-excel')?.classList.add('hidden');
        permBtn?.classList.add('hidden');
        unlinkBtn?.classList.add('hidden');
        return;
      }

      if (!linkedFileHandle) {
        if (statusEl) statusEl.textContent = 'Belum terhubung (data tersimpan di browser)';
        permBtn?.classList.add('hidden');
        unlinkBtn?.classList.add('hidden');
        return;
      }

      unlinkBtn?.classList.remove('hidden');
      try {
        const perm = await linkedFileHandle.queryPermission({ mode: 'readwrite' });
        if (perm === 'granted') {
          if (statusEl) statusEl.innerHTML = `<span class="font-bold text-emerald-700">Aktif &amp; Terhubung ke: ${linkedFileHandle.name}</span>`;
          permBtn?.classList.add('hidden');
        } else {
          if (statusEl) statusEl.innerHTML = `<span class="font-bold text-amber-700">Terhubung ke ${linkedFileHandle.name} (klik Aktifkan Akses)</span>`;
          permBtn?.classList.remove('hidden');
        }
      } catch {
        if (statusEl) statusEl.textContent = `Terhubung ke ${linkedFileHandle.name}`;
      }
    }

    async function syncToLinkedExcelFile(rows: InvoiceExcelRow[], allowPrompt = false) {
      if (!linkedFileHandle) return;
      try {
        let perm = await linkedFileHandle.queryPermission({ mode: 'readwrite' });
        if (perm !== 'granted' && allowPrompt) {
          perm = await linkedFileHandle.requestPermission({ mode: 'readwrite' });
        }
        if (perm === 'granted') {
          const writable = await linkedFileHandle.createWritable();
          await writable.write(buildCsvContent(rows));
          await writable.close();
          await updateLinkedFileUI();
        }
      } catch (err) {
        console.error('Sync to linked Excel file failed:', err);
      }
    }

    async function syncRowToGoogleSheet(entry: InvoiceExcelRow) {
      const url = localStorage.getItem(GSHEET_KEY) || DEFAULT_GSHEET_WEBHOOK;
      if (!url) return;
      const statusEl = document.getElementById('gsheet-sync-status');
      try {
        await fetch(url, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(entry),
        });
        if (statusEl) statusEl.textContent = `✓ Terkirim: ${entry.invoiceNo} (${new Date().toLocaleTimeString('id-ID')})`;
      } catch {
        if (statusEl) statusEl.textContent = '✗ Gagal kirim. Periksa koneksi internet.';
      }
    }

    function advanceSeqFromRows(rows: InvoiceExcelRow[]) {
      const todayPrefix = generateInvoiceNumber(0).slice(0, -3); // e.g. INV-FG-20261128-
      let maxSeq = 0;
      rows.forEach((r) => {
        if (r.invoiceNo.startsWith(todayPrefix)) {
          const num = parseInt(r.invoiceNo.slice(todayPrefix.length), 10);
          if (!Number.isNaN(num) && num > maxSeq) maxSeq = num;
        }
      });
      if (maxSeq >= currentSeq) {
        currentSeq = maxSeq + 1;
        savePaymentPrefs();
        if (!fClientName.value.trim()) {
          fInvoiceNo.value = generateInvoiceNumber(currentSeq);
          renderPreview();
        }
      }
    }

    async function pullFromGoogleSheet(showFeedback = false) {
      const statusEl = document.getElementById('gsheet-sync-status');
      if (showFeedback && statusEl) {
        statusEl.textContent = '⏳ Menyinkronkan data dari Google Sheets...';
      }
      try {
        const csvUrl = `https://docs.google.com/spreadsheets/d/${GSHEET_ID}/gviz/tq?tqx=out:csv&t=${Date.now()}`;
        const res = await fetch(csvUrl);
        const text = await res.text();
        if (res.ok && text && !text.trim().startsWith('<')) {
          const remoteRows = importRowsFromCsvText(text);
          const localRows = loadExcelLog();
          const merged = [...remoteRows];
          localRows.forEach((lr) => {
            const idx = merged.findIndex((m) => m.invoiceNo === lr.invoiceNo);
            if (idx < 0) merged.push(lr);
          });
          saveExcelLog(merged);
          renderExcelModalTable();
          advanceSeqFromRows(merged);
          if (statusEl) {
            statusEl.textContent = `✓ Tersinkron (${merged.length} invoice) • ${new Date().toLocaleTimeString('id-ID')}`;
          }
          return;
        }
        if (showFeedback && statusEl) {
          statusEl.textContent = '⚠ Agar HP & Laptop saling baca data, atur Share Google Sheets ke "Siapa saja yang memiliki link (Viewer)".';
        }
      } catch {
        if (showFeedback && statusEl) {
          statusEl.textContent = '⚠ Tidak dapat membaca Google Sheets (periksa koneksi atau izin Share Viewer).';
        }
      }
    }

    async function recordCurrentInvoiceToExcelLog(allowFilePrompt = true) {
      const rows = loadExcelLog();
      const entry = buildCurrentExcelRow();
      const existingIdx = rows.findIndex((r) => r.invoiceNo === entry.invoiceNo);
      if (existingIdx >= 0) {
        rows[existingIdx] = entry;
      } else {
        rows.push(entry);
      }
      saveExcelLog(rows);
      renderExcelModalTable();
      await syncToLinkedExcelFile(rows, allowFilePrompt);
      syncRowToGoogleSheet(entry);
    }

    function exportExcelCsv() {
      const rows = loadExcelLog();
      if (rows.length === 0) {
        const entry = buildCurrentExcelRow();
        rows.push(entry);
        saveExcelLog(rows);
        renderExcelModalTable();
      }
      const latestRows = loadExcelLog();
      const csvContent = buildCsvContent(latestRows);
      const blob = new Blob([csvContent], {
        type: 'text/csv;charset=utf-8;',
      });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Rekap_Invoice_Floragate_${todayISO}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    document.getElementById('btn-link-new-excel')?.addEventListener('click', async () => {
      try {
        // @ts-ignore File System Access API
        const handle = await window.showSaveFilePicker({
          suggestedName: 'Rekap_Invoice_Floragate.csv',
          types: [{ description: 'Excel CSV File', accept: { 'text/csv': ['.csv'] } }],
        });
        await saveLinkedHandle(handle);
        const rows = loadExcelLog();
        await syncToLinkedExcelFile(rows, true);
      } catch {
        // User cancelled
      }
    });

    document.getElementById('btn-link-existing-excel')?.addEventListener('click', async () => {
      try {
        // @ts-ignore File System Access API
        const [handle] = await window.showOpenFilePicker({
          multiple: false,
          types: [{ description: 'Excel CSV File', accept: { 'text/csv': ['.csv'] } }],
        });
        const file = await handle.getFile();
        const text = await file.text();
        const imported = importRowsFromCsvText(text);
        const current = loadExcelLog();
        const merged = [...imported];
        current.forEach((row) => {
          const idx = merged.findIndex((m) => m.invoiceNo === row.invoiceNo);
          if (idx >= 0) merged[idx] = row;
          else merged.push(row);
        });
        saveExcelLog(merged);
        renderExcelModalTable();
        await saveLinkedHandle(handle);
        await syncToLinkedExcelFile(merged, true);
      } catch {
        // User cancelled
      }
    });

    document.getElementById('btn-grant-excel-perm')?.addEventListener('click', async () => {
      if (!linkedFileHandle) return;
      try {
        const perm = await linkedFileHandle.requestPermission({ mode: 'readwrite' });
        if (perm === 'granted') {
          await syncToLinkedExcelFile(loadExcelLog(), false);
        }
        await updateLinkedFileUI();
      } catch {
        // Ignore
      }
    });

    document.getElementById('btn-unlink-excel')?.addEventListener('click', clearLinkedHandle);

    const excelModal = document.getElementById('excel-modal');
    document.getElementById('btn-open-excel-modal')?.addEventListener('click', () => {
      renderExcelModalTable();
      excelModal?.classList.remove('hidden');
      pullFromGoogleSheet(true);
    });
    document.getElementById('btn-sync-gsheet-now')?.addEventListener('click', () => {
      pullFromGoogleSheet(true);
    });
    document.getElementById('btn-close-excel-modal')?.addEventListener('click', () => {
      excelModal?.classList.add('hidden');
    });
    excelModal?.addEventListener('click', (e) => {
      if (e.target === excelModal) excelModal.classList.add('hidden');
    });
    document.getElementById('btn-save-current-excel')?.addEventListener('click', () => {
      if (activeDocMode === 'kwitansi') {
        recordCurrentKwitansiToExcelLog();
      } else {
        recordCurrentInvoiceToExcelLog();
      }
    });
    document.getElementById('btn-export-excel-csv')?.addEventListener('click', exportExcelCsv);
    document.getElementById('btn-clear-excel-log')?.addEventListener('click', async () => {
      if (confirm('Hapus semua rekap data invoice yang tersimpan?')) {
        saveExcelLog([]);
        renderExcelModalTable();
        await syncToLinkedExcelFile([], true);
      }
    });

    // ========== KWITANSI INTEGRATION ==========
    const kNo = document.getElementById('k-no') as HTMLInputElement;
    const kRefInvoice = document.getElementById('k-ref-invoice') as HTMLInputElement;
    const kDate = document.getElementById('k-date') as HTMLInputElement;
    const kReceivedFrom = document.getElementById('k-received-from') as HTMLInputElement;
    const kAmount = document.getElementById('k-amount') as HTMLInputElement;
    const kTerbilang = document.getElementById('k-terbilang') as HTMLInputElement;
    const kPaymentFor = document.getElementById('k-payment-for') as HTMLTextAreaElement;
    const kShowStamp = document.getElementById('k-show-stamp') as HTMLInputElement;
    let kPaymentMethod = 'Transfer Bank';

    function updateKwitansiMethodUI() {
      document.querySelectorAll('.k-method-btn').forEach((btn) => {
        const active = btn.getAttribute('data-k-method') === kPaymentMethod;
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('border-soft-cream', !active);
        btn.classList.toggle('bg-clean-ivory/40', !active);
        btn.classList.toggle('text-slate-700', !active);
      });
    }

    function syncKwitansiFromInvoice() {
      const invNo = fInvoiceNo.value.trim() || generateInvoiceNumber(currentSeq);
      if (kNo) kNo.value = invNo.startsWith('INV-') ? invNo.replace(/^INV-/, 'KWT-') : `KWT-${invNo}`;
      if (kRefInvoice) kRefInvoice.value = invNo;
      if (kDate) kDate.value = fIssueDate.value || todayISO;
      if (kReceivedFrom) kReceivedFrom.value = fClientName.value.trim();

      const { grandTotal, dpAmount } = getTotals();
      const nominal = status === 'dp' && dpAmount > 0 ? dpAmount : grandTotal;
      if (kAmount) kAmount.value = String(nominal);
      if (kTerbilang) kTerbilang.value = terbilangRupiah(nominal);

      const itemDesc = items
        .map((it) => `${it.name.trim() || 'Karangan Bunga Floragate'} (${it.qty} pcs)`)
        .join(', ');
      const prefix =
        status === 'dp'
          ? `Uang Muka (DP) Invoice ${invNo}`
          : status === 'paid'
          ? `Pelunasan Pembayaran Invoice ${invNo}`
          : `Pembayaran Invoice ${invNo}`;
      if (kPaymentFor) kPaymentFor.value = `${prefix} — ${itemDesc}`;
      if (kShowStamp) kShowStamp.checked = Boolean(fShowStamp?.checked);

      renderKwitansiPreview();
    }

    function renderKwitansiPreview() {
      const setK = (id: string, val: string, fallback = '-') => {
        const el = document.getElementById(id);
        if (el) el.textContent = val.trim() || fallback;
      };
      setK('pv-k-no', kNo?.value || '', 'KWT-FG-001');
      setK('pv-k-ref', kRefInvoice?.value || '', 'INV-FG-001');
      setK('pv-k-received-from', kReceivedFrom?.value || '', '[Nama Pemesan]');
      setK('pv-k-terbilang', kTerbilang?.value || '', 'Nol Rupiah');
      setK('pv-k-payment-for', kPaymentFor?.value || '', '[Keterangan Pembayaran]');
      setK('pv-k-amount', formatRupiah(Number(kAmount?.value) || 0));

      const dateFormatted = kDate?.value
        ? new Date(`${kDate.value}T00:00:00`).toLocaleDateString('id-ID', {
            day: '2-digit',
            month: 'long',
            year: 'numeric',
          })
        : '-';
      setK('pv-k-date', dateFormatted);

      const chkTransfer = document.getElementById('pv-k-chk-transfer');
      const chkQris = document.getElementById('pv-k-chk-qris');
      const chkTunai = document.getElementById('pv-k-chk-tunai');
      if (chkTransfer) chkTransfer.textContent = kPaymentMethod === 'Transfer Bank' ? '✓' : '';
      if (chkQris) chkQris.textContent = kPaymentMethod === 'QRIS' ? '✓' : '';
      if (chkTunai) chkTunai.textContent = kPaymentMethod === 'Tunai' ? '✓' : '';

      const kStampImg = document.getElementById('pv-k-stamp-img');
      if (kStampImg) {
        kStampImg.classList.toggle('hidden', !kShowStamp?.checked);
      }
    }

    function setDocMode(mode: 'invoice' | 'kwitansi') {
      activeDocMode = mode;
      const isKwitansi = mode === 'kwitansi';

      document.getElementById('invoice-editor-cards')?.classList.toggle('hidden', isKwitansi);
      document.getElementById('kwitansi-editor-panel')?.classList.toggle('hidden', !isKwitansi);
      document.getElementById('invoice-sheet')?.classList.toggle('hidden', isKwitansi);
      document.getElementById('kwitansi-sheet')?.classList.toggle('hidden', !isKwitansi);

      const btnKwitansi = document.getElementById('btn-create-kwitansi');
      if (btnKwitansi) {
        btnKwitansi.className = isKwitansi
          ? 'inline-flex items-center gap-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 px-3.5 py-2.5 text-xs font-bold text-white shadow-xs transition-colors cursor-pointer'
          : 'inline-flex items-center gap-1.5 rounded-xl border border-amber-300 bg-amber-50 hover:bg-amber-100 px-3.5 py-2.5 text-xs font-bold text-amber-900 transition-colors cursor-pointer';
        btnKwitansi.textContent = isKwitansi ? '← Kembali ke Invoice' : '🧾 Buat Kwitansi';
      }

      const sheetLabel = document.getElementById('preview-sheet-label');
      const sheetSub = document.getElementById('preview-sheet-sublabel');
      if (sheetLabel) sheetLabel.textContent = isKwitansi ? 'Pratinjau Kwitansi' : 'Pratinjau Lembar A4';
      if (sheetSub) sheetSub.textContent = isKwitansi ? 'Standar Cetak A5 Landscape' : 'Standar Cetak 210 x 297 mm';

      if (mobileEditBtn) mobileEditBtn.textContent = isKwitansi ? '✏️ 1. Isi Data Kwitansi' : '✏️ 1. Isi Data Invoice';
      if (mobilePreviewBtn) mobilePreviewBtn.textContent = isKwitansi ? '🧾 2. Lihat Kwitansi & PDF' : '📄 2. Lihat Invoice & PDF';

      if (isKwitansi) {
        syncKwitansiFromInvoice();
      }
      setTimeout(fitMobileSheet, 60);
    }

    document.getElementById('btn-create-kwitansi')?.addEventListener('click', () => {
      setDocMode(activeDocMode === 'invoice' ? 'kwitansi' : 'invoice');
    });
    document.getElementById('btn-sync-kwitansi-from-invoice')?.addEventListener('click', syncKwitansiFromInvoice);

    document.querySelectorAll('.k-method-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        kPaymentMethod = btn.getAttribute('data-k-method') || 'Transfer Bank';
        updateKwitansiMethodUI();
        renderKwitansiPreview();
      });
    });

    kAmount?.addEventListener('input', () => {
      if (kTerbilang) kTerbilang.value = terbilangRupiah(Number(kAmount.value) || 0);
      renderKwitansiPreview();
    });

    [kNo, kRefInvoice, kDate, kReceivedFrom, kTerbilang, kPaymentFor, kShowStamp].forEach((el) => {
      el?.addEventListener('input', renderKwitansiPreview);
      el?.addEventListener('change', renderKwitansiPreview);
    });

    function printCurrentDocument() {
      const isKwitansi = activeDocMode === 'kwitansi';
      document.body.classList.toggle('printing-kwitansi', isKwitansi);
      window.print();
      setTimeout(() => {
        document.body.classList.remove('printing-kwitansi');
      }, 300);
    }

    async function recordCurrentKwitansiToExcelLog(allowFilePrompt = true) {
      const rows = loadExcelLog();
      const nominal = Math.max(0, Number(kAmount?.value) || 0);
      const kwtNo = kNo?.value.trim() || `KWT-${fInvoiceNo.value.trim() || generateInvoiceNumber(currentSeq)}`;
      const refInv = kRefInvoice?.value.trim() || fInvoiceNo.value.trim() || '-';
      const dateVal = kDate?.value || todayISO;
      const receivedFrom = kReceivedFrom?.value.trim() || fClientName.value.trim() || '-';
      const terbilangVal = kTerbilang?.value.trim() || terbilangRupiah(nominal);
      const payFor = kPaymentFor?.value.trim() || '-';

      const entry: InvoiceExcelRow = {
        invoiceNo: kwtNo,
        poNumber: `Ref: ${refInv}`,
        issueDate: dateVal,
        dueDate: dateVal,
        statusLabel: `Kwitansi (${kPaymentMethod})`,
        paymentTerms: kPaymentMethod,
        clientName: receivedFrom,
        clientContact: fClientContact.value.trim() || '-',
        clientAddress: fClientAddress.value.trim() || 'Kab. Malang',
        recipientName: receivedFrom,
        deliveryDatetime: '-',
        deliveryAddress: '-',
        itemsSummary: `[KWITANSI] ${payFor} (Terbilang: ${terbilangVal})`,
        subtotal: nominal,
        shippingFee: 0,
        physicalInvoiceShipping: 0,
        grandTotal: nominal,
        dpAmount: 0,
        balanceDue: 0,
        accountsSummary: kPaymentMethod,
        digitalStamp: kShowStamp?.checked ? 'Ya' : 'Kosong (Manual)',
        recordedAt: new Date().toLocaleString('id-ID'),
      };

      const existingIdx = rows.findIndex((r) => r.invoiceNo === entry.invoiceNo);
      if (existingIdx >= 0) {
        rows[existingIdx] = entry;
      } else {
        rows.push(entry);
      }
      saveExcelLog(rows);
      renderExcelModalTable();
      await syncToLinkedExcelFile(rows, allowFilePrompt);
      syncRowToGoogleSheet(entry);
    }

    async function downloadPdf() {
      const isKwitansi = activeDocMode === 'kwitansi';
      if (isKwitansi) {
        recordCurrentKwitansiToExcelLog();
      } else {
        recordCurrentInvoiceToExcelLog();
      }
      const sheet = document.getElementById(isKwitansi ? 'kwitansi-sheet' : 'invoice-sheet');
      if (!sheet) return;

      const cleanDocNo = ((isKwitansi ? kNo?.value : fInvoiceNo.value) || (isKwitansi ? 'KWT-FLORAGATE' : 'INV-FLORAGATE')).replace(/[^\w\-]+/g, '_');
      const cleanClient = ((isKwitansi ? kReceivedFrom?.value : fClientName.value) || 'Pelanggan').replace(/[^\w\-]+/g, '_');
      const filename = `${cleanDocNo}_${cleanClient}.pdf`;

      const downloadBtns = [
        document.getElementById('btn-download-pdf'),
        document.getElementById('btn-mobile-download-pdf'),
      ].filter(Boolean) as HTMLButtonElement[];

      downloadBtns.forEach((btn) => {
        btn.disabled = true;
        btn.dataset.origHtml = btn.innerHTML;
        btn.innerHTML = `
          <svg class="animate-spin -ml-1 mr-1.5 h-3.5 w-3.5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg> Menyimpan...
        `;
      });

      const prevTransform = sheet.style.transform;
      const prevMarginBottom = sheet.style.marginBottom;
      const wasPreviewHidden = previewPanel?.classList.contains('hidden') ?? false;
      if (wasPreviewHidden && previewPanel) {
        previewPanel.classList.remove('hidden');
      }
      sheet.style.transform = 'none';
      sheet.style.marginBottom = '';

      try {
        if (wasPreviewHidden) {
          await new Promise((r) => setTimeout(r, 60));
        }
        // @ts-ignore html2pdf loaded globally via html2pdf.bundle.min.js
        if (typeof html2pdf !== 'undefined') {
          const opt = {
            margin: 0,
            filename,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: {
              scale: 2,
              useCORS: true,
              letterRendering: true,
              logging: false,
              scrollY: 0,
              scrollX: 0,
            },
            jsPDF: {
              unit: 'mm',
              format: isKwitansi ? 'a5' : 'a4',
              orientation: isKwitansi ? 'landscape' : 'portrait',
            },
          };
          // @ts-ignore
          await html2pdf().set(opt).from(sheet).save();
        } else {
          printCurrentDocument();
        }
      } catch (err) {
        console.error('Download PDF error:', err);
        printCurrentDocument();
      } finally {
        sheet.style.transform = prevTransform;
        sheet.style.marginBottom = prevMarginBottom;
        if (wasPreviewHidden && previewPanel) {
          previewPanel.classList.add('hidden');
        }
        downloadBtns.forEach((btn) => {
          btn.disabled = false;
          if (btn.dataset.origHtml) btn.innerHTML = btn.dataset.origHtml;
        });
      }
    }

    document.getElementById('btn-download-pdf')?.addEventListener('click', downloadPdf);
    document.getElementById('btn-mobile-download-pdf')?.addEventListener('click', downloadPdf);

    document.getElementById('btn-print-invoice')?.addEventListener('click', () => {
      if (activeDocMode === 'invoice') recordCurrentInvoiceToExcelLog();
      else recordCurrentKwitansiToExcelLog();
      printCurrentDocument();
    });

    updateExcelBadge();
    restoreLinkedHandle();
    updateStatusButtonsUI();
    updateKwitansiMethodUI();
    renderItemsEditor();
    renderPreview();
    syncKwitansiFromInvoice();
    if (getSavedSession()) {
      pullFromGoogleSheet(false);
    }
  }

  initInvoicePage();
</script>

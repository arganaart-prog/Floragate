---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';
import { withBase } from '../utils/paths';
import { getProductDisplayName } from '../utils/productHelpers';

const title = 'Invoice Generator Internal | Floragate';
const description = 'Halaman internal pembuatan invoice pesanan Floragate Malang.';

const catalogItems = PRODUCTS.map((p) => ({
  slug: p.slug,
  name: getProductDisplayName(p),
  category: p.categoryName,
  price: p.priceFrom,
}));
---

<Layout
  title={title}
  description={description}
  robots="noindex, nofollow"
  showTestimonials={false}
  showGallery={false}
>
  <div class="invoice-page-wrap max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- ==================== LOGIN GATE ==================== -->
    <section
      id="invoice-login-gate"
      class="no-print max-w-md mx-auto my-8 sm:my-14 rounded-2xl border border-soft-cream bg-white p-7 sm:p-9 shadow-[0_20px_50px_rgba(63,75,55,0.08)]"
      aria-labelledby="login-heading"
    >
      <div class="text-center mb-7">
        <div class="mx-auto mb-4 flex h-20 w-16 items-center justify-center rounded-t-full rounded-b-md border border-secondary/70 bg-accent-bg p-2 shadow-xs">
          <img
            src={withBase('/images/logo/logo.webp')}
            alt="Logo Floragate"
            class="h-12 w-auto object-contain"
            width="64"
            height="62"
          />
        </div>
        <span class="text-[11px] font-bold uppercase tracking-[0.22em] text-secondary-dark">Admin Floragate</span>
        <h1 id="login-heading" class="mt-1.5 font-serif text-2xl sm:text-3xl font-bold text-primary-dark">
          Login Pembuat Invoice
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-slate-500">
          Masuk dengan akun admin untuk membuat, mengatur status bayar, dan mencetak invoice pelanggan.
        </p>
      </div>

      <form id="invoice-login-form" class="space-y-4" novalidate>
        <div>
          <label for="login-email" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Email Admin
          </label>
          <input
            id="login-email"
            type="email"
            required
            autocomplete="username"
            placeholder="nama@gmail.com"
            class="w-full rounded-xl border border-soft-cream bg-clean-ivory/40 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
        </div>

        <div>
          <label for="login-password" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
            Kata Sandi
          </label>
          <div class="relative">
            <input
              id="login-password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="Masukkan kata sandi"
              class="w-full rounded-xl border border-soft-cream bg-clean-ivory/40 px-4 py-3 pr-11 text-sm text-slate-800 placeholder:text-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
            <button
              type="button"
              id="toggle-password-btn"
              class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 text-slate-400 hover:text-primary cursor-pointer"
              aria-label="Tampilkan atau sembunyikan kata sandi"
            >
              <svg id="eye-open-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <svg id="eye-closed-icon" class="hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
              </svg>
            </button>
          </div>
        </div>

        <label class="flex items-center gap-2.5 text-xs text-slate-600 cursor-pointer select-none">
          <input
            id="login-remember"
            type="checkbox"
            checked
            class="h-4 w-4 rounded border-soft-cream text-primary focus:ring-primary/30"
          />
          <span>Tetap masuk di browser ini</span>
        </label>

        <p id="login-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-medium text-red-700" role="alert"></p>

        <button
          type="submit"
          class="w-full rounded-xl bg-primary hover:bg-primary-dark px-5 py-3.5 text-sm font-bold text-white shadow-md transition-colors cursor-pointer"
        >
          Masuk ke Invoice Builder
        </button>
      </form>
    </section>

    <!-- ==================== INVOICE BUILDER WORKSPACE ==================== -->
    <section id="invoice-workspace" class="hidden" aria-label="Workspace Pembuat Invoice">
      <!-- Top Action Bar -->
      <div class="no-print mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border border-soft-cream bg-white p-4 sm:px-6 shadow-xs">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-secondary-dark">Floragate Billing</span>
          <h1 class="font-serif text-xl sm:text-2xl font-bold text-primary-dark">Pembuat Invoice Pelanggan</h1>
          <p id="active-user-label" class="text-xs text-slate-500 mt-0.5"></p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <button
            type="button"
            id="btn-new-invoice"
            class="inline-flex items-center gap-1.5 rounded-xl border border-soft-cream bg-accent-bg px-3.5 py-2.5 text-xs font-bold text-primary-dark hover:border-secondary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Invoice Baru
          </button>

          <button
            type="button"
            id="btn-print-invoice"
            class="inline-flex items-center gap-2 rounded-xl bg-primary hover:bg-primary-dark px-4 py-2.5 text-xs font-bold text-white shadow-sm transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Cetak / Simpan PDF
          </button>

          <button
            type="button"
            id="btn-logout"
            class="inline-flex items-center gap-1.5 rounded-xl border border-red-200 bg-red-50/70 hover:bg-red-100 px-3.5 py-2.5 text-xs font-bold text-red-700 transition-colors cursor-pointer"
          >
            Keluar
          </button>
        </div>
      </div>

      <!-- Mobile Tab Switcher (Edit Form vs Preview) -->
      <div class="no-print xl:hidden grid grid-cols-2 gap-2 mb-5 rounded-xl border border-soft-cream bg-white p-1.5">
        <button
          type="button"
          id="mobile-tab-edit"
          class="rounded-lg py-2.5 text-xs font-bold bg-primary text-white transition-colors cursor-pointer"
        >
          1. Isi Data Invoice
        </button>
        <button
          type="button"
          id="mobile-tab-preview"
          class="rounded-lg py-2.5 text-xs font-bold text-slate-600 hover:text-primary transition-colors cursor-pointer"
        >
          2. Lihat Preview &amp; PDF
        </button>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-12 gap-7 items-start">
        <!-- ========== LEFT COLUMN: EDITOR FORM ========== -->
        <aside id="editor-panel" class="no-print xl:col-span-5 space-y-5">
          <!-- Card 1: Info Invoice & Status Pembayaran -->
          <div class="rounded-2xl border border-soft-cream bg-white p-5 shadow-xs space-y-4">
            <h2 class="font-serif text-base font-bold text-primary-dark border-b border-soft-cream/70 pb-2.5">
              1. Nomor &amp; Status Pembayaran
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="sm:col-span-2">
                <label for="f-invoice-no" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Invoice No.</label>
                <input id="f-invoice-no" type="text" class="inv-input" />
              </div>
              <div>
                <label for="f-issue-date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Issue Date</label>
                <input id="f-issue-date" type="date" class="inv-input" />
              </div>
              <div>
                <label for="f-due-date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Due Date</label>
                <input id="f-due-date" type="date" class="inv-input" />
              </div>
            </div>

            <!-- Status Pembayaran: Sudah Dibayar / DP / Belum Dibayar -->
            <div>
              <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Status Pembayaran</span>
              <div class="grid grid-cols-3 gap-2" role="radiogroup" aria-label="Pilih status pembayaran">
                <button
                  type="button"
                  data-status-btn="paid"
                  class="status-choice-btn rounded-xl border border-soft-cream bg-clean-ivory/40 px-2.5 py-2.5 text-center text-xs font-bold text-slate-700 transition-all cursor-pointer"
                >
                  Sudah Dibayar
                </button>
                <button
                  type="button"
                  data-status-btn="dp"
                  class="status-choice-btn rounded-xl border border-soft-cream bg-clean-ivory/40 px-2.5 py-2.5 text-center text-xs font-bold text-slate-700 transition-all cursor-pointer"
                >
                  DP (Uang Muka)
                </button>
                <button
                  type="button"
                  data-status-btn="unpaid"
                  class="status-choice-btn rounded-xl border border-soft-cream bg-clean-ivory/40 px-2.5 py-2.5 text-center text-xs font-bold text-slate-700 transition-all cursor-pointer"
                >
                  Belum Dibayar
                </button>
              </div>
            </div>

            <!-- DP Nominal Input (hanya muncul jika status DP dipilih) -->
            <div id="dp-input-wrap" class="hidden rounded-xl border border-secondary/50 bg-accent-bg/70 p-3.5 space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <label for="f-dp-amount" class="text-xs font-bold text-secondary-dark">Nominal DP Diterima (Rp)</label>
                <div class="flex items-center gap-1.5">
                  <button type="button" data-dp-percent="30" class="dp-preset-btn rounded-md bg-white px-2 py-1 text-[10px] font-bold text-primary-dark border border-soft-cream hover:border-primary cursor-pointer">DP 30%</button>
                  <button type="button" data-dp-percent="50" class="dp-preset-btn rounded-md bg-white px-2 py-1 text-[10px] font-bold text-primary-dark border border-soft-cream hover:border-primary cursor-pointer">DP 50%</button>
                </div>
              </div>
              <input id="f-dp-amount" type="number" min="0" step="5000" placeholder="Contoh: 350000" class="inv-input bg-white" />
              <p class="text-[11px] text-slate-500">Sisa tagihan otomatis dihitung di rincian invoice.</p>
            </div>
          </div>

          <!-- Card 2: Data Pemesan (Billed To) & Pengiriman (Delivery Details) -->
          <div class="rounded-2xl border border-soft-cream bg-white p-5 shadow-xs space-y-4">
            <h2 class="font-serif text-base font-bold text-primary-dark border-b border-soft-cream/70 pb-2.5">
              2. Data Pemesan &amp; Pengiriman
            </h2>

            <div class="space-y-3">
              <p class="text-[11px] font-bold uppercase tracking-widest text-primary">Billed To (Pemesan)</p>
              <input id="f-client-name" type="text" placeholder="Nama pemesan / perusahaan" class="inv-input" />
              <input id="f-client-contact" type="text" placeholder="No. WhatsApp / Email pemesan" class="inv-input" />
              <input id="f-client-address" type="text" placeholder="Alamat pemesan / kota" class="inv-input" />
            </div>

            <div class="pt-2 border-t border-soft-cream/50 space-y-3">
              <p class="text-[11px] font-bold uppercase tracking-widest text-primary">Delivery Details (Pengiriman)</p>
              <input id="f-recipient-name" type="text" placeholder="Nama penerima / keluarga / instansi" class="inv-input" />
              <input id="f-delivery-datetime" type="text" placeholder="Tanggal & jam kirim (mis: 28 Nov 2026, 09.00 WIB)" class="inv-input" />
              <input id="f-delivery-address" type="text" placeholder="Alamat lengkap pengiriman di Malang" class="inv-input" />
            </div>
          </div>

          <!-- Card 3: Daftar Produk (Nama Produk, Harga, Jumlah) -->
          <div class="rounded-2xl border border-soft-cream bg-white p-5 shadow-xs space-y-4">
            <div class="flex items-center justify-between gap-2 border-b border-soft-cream/70 pb-2.5">
              <h2 class="font-serif text-base font-bold text-primary-dark">
                3. Produk &amp; Ongkir
              </h2>
              <button
                type="button"
                id="btn-add-item"
                class="inline-flex items-center gap-1 rounded-lg bg-primary hover:bg-primary-dark px-3 py-1.5 text-xs font-bold text-white transition-colors cursor-pointer"
              >
                + Tambah Produk
              </button>
            </div>

            <!-- Quick Pick from Catalog -->
            <div class="rounded-xl border border-soft-cream/80 bg-accent-bg/50 p-3 space-y-2">
              <label for="catalog-quick-select" class="block text-[11px] font-bold text-secondary-dark">
                Pilih Cepat dari Katalog (Opsional)
              </label>
              <div class="flex gap-2">
                <select id="catalog-quick-select" class="inv-input bg-white text-xs">
                  <option value="">-- Pilih produk katalog --</option>
                  {catalogItems.map((item) => (
                    <option value={item.slug} data-name={item.name} data-price={item.price}>
                      {item.name} — Rp {item.price.toLocaleString('id-ID')}
                    </option>
                  ))}
                </select>
                <button
                  type="button"
                  id="btn-insert-catalog"
                  class="shrink-0 rounded-lg border border-primary bg-white px-3 py-2 text-xs font-bold text-primary hover:bg-primary hover:text-white transition-colors cursor-pointer"
                >
                  Tambah
                </button>
              </div>
            </div>

            <!-- Dynamic Items Editor List -->
            <div id="items-editor-list" class="space-y-3"></div>

            <!-- Ongkir -->
            <div class="pt-2 border-t border-soft-cream/60">
              <label for="f-shipping-fee" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
                Biaya Pengiriman / Shipping Fee (Rp) — 0 = Gratis Ongkir
              </label>
              <input id="f-shipping-fee" type="number" min="0" step="5000" value="0" class="inv-input" />
            </div>
          </div>

          <!-- Card 4: Pembayaran & Stempel -->
          <div class="rounded-2xl border border-soft-cream bg-white p-5 shadow-xs space-y-4">
            <h2 class="font-serif text-base font-bold text-primary-dark border-b border-soft-cream/70 pb-2.5">
              4. Pembayaran &amp; Stempel Digital
            </h2>

            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-widest text-primary">Bank Transfer</span>
                <label class="inline-flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer">
                  <input id="f-show-bank" type="checkbox" checked class="h-3.5 w-3.5 rounded text-primary" />
                  Tampilkan
                </label>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <input id="f-bank-name" type="text" placeholder="Nama Bank (mis: BCA / Mandiri)" class="inv-input" />
                <input id="f-bank-acc" type="text" placeholder="No. Rekening" class="inv-input" />
              </div>
              <input id="f-bank-holder" type="text" placeholder="Atas Nama Rekening" class="inv-input" />
            </div>

            <div class="pt-2 border-t border-soft-cream/50 space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-widest text-primary">QRIS Payment</span>
                <label class="inline-flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer">
                  <input id="f-show-qris" type="checkbox" checked class="h-3.5 w-3.5 rounded text-primary" />
                  Tampilkan
                </label>
              </div>
              <input id="f-qris-nmid" type="text" placeholder="Merchant ID / NMID QRIS" class="inv-input" />
            </div>

            <div class="pt-2 border-t border-soft-cream/50 flex flex-wrap items-center justify-between gap-3">
              <label class="inline-flex items-center gap-2 text-xs font-bold text-primary-dark cursor-pointer">
                <input id="f-show-stamp" type="checkbox" checked class="h-4 w-4 rounded text-primary" />
                Tampilkan Stempel Digital Floragate
              </label>

              <label class="inline-flex items-center gap-2 text-xs text-slate-600">
                <span>Teks Stempel:</span>
                <select id="f-stamp-rotation" class="rounded-lg border border-soft-cream bg-clean-ivory/40 px-2 py-1 text-xs">
                  <option value="-6">Miring Natural</option>
                  <option value="0">Lurus (0°)</option>
                  <option value="-12">Miring Dinamis</option>
                </select>
              </label>
            </div>
          </div>
        </aside>

        <!-- ========== RIGHT COLUMN: LIVE A4 INVOICE SHEET ========== -->
        <div id="preview-panel" class="hidden xl:block xl:col-span-7">
          <div class="overflow-x-auto pb-4">
            <div
              id="invoice-sheet"
              class="mx-auto w-[794px] min-h-[1123px] bg-[#FAF7F0] text-[#222922] px-11 py-10 shadow-[0_24px_60px_rgba(15,23,42,0.12)] border border-[#E6DEC8] flex flex-col justify-between"
            >
              <div>
                <!-- TOP HEADER -->
                <header class="flex items-start justify-between gap-6 pb-6 border-b-[1.5px] border-[#BFA77A]">
                  <div class="flex items-start gap-5">
                    <!-- Orchid & Arch Logo Box -->
                    <div class="shrink-0 w-[68px] h-[82px] rounded-t-full rounded-b-sm border border-dashed border-[#BFA77A] bg-[#F3EDE0] flex flex-col items-center justify-center p-2">
                      <img
                        src={withBase('/images/logo/logo.webp')}
                        alt="Logo Floragate"
                        class="w-11 h-11 object-contain"
                        width="64"
                        height="62"
                      />
                    </div>
                    <div>
                      <h2 class="font-serif text-[32px] font-normal tracking-[0.22em] text-[#1F271E] leading-none">
                        FLORAGATE
                      </h2>
                      <p class="mt-2 font-serif italic text-[14px] text-[#3F4B37]">
                        The Gateway to Meaningful Moments
                      </p>
                      <p class="mt-2 text-[11.5px] text-[#4A5248] leading-snug">
                        Website: tokobungamurahmalang.web.id<br />
                        Location: Malang, Indonesia
                      </p>
                    </div>
                  </div>

                  <div class="text-right min-w-[235px]">
                    <p class="font-serif text-[30px] font-normal tracking-[0.22em] text-[#1F271E] leading-none">
                      INVOICE
                    </p>
                    <div class="mt-2.5 flex justify-end">
                      <span
                        id="pv-status-badge"
                        class="inline-block border px-3.5 py-1 text-[11px] font-bold uppercase tracking-[0.18em]"
                      >
                        BELUM DIBAYAR
                      </span>
                    </div>

                    <div class="mt-3.5 space-y-1 text-[11.5px]">
                      <div class="grid grid-cols-[100px_1fr] gap-2 items-baseline">
                        <span class="text-left font-bold tracking-[0.1em] text-[#6A7168] uppercase text-[10.5px]">INVOICE NO.</span>
                        <span id="pv-invoice-no" class="font-medium text-[#222922]">INV-FG-001</span>
                      </div>
                      <div class="grid grid-cols-[100px_1fr] gap-2 items-baseline">
                        <span class="text-left font-bold tracking-[0.1em] text-[#6A7168] uppercase text-[10.5px]">ISSUE DATE</span>
                        <span id="pv-issue-date" class="font-medium text-[#222922]">-</span>
                      </div>
                      <div class="grid grid-cols-[100px_1fr] gap-2 items-baseline">
                        <span class="text-left font-bold tracking-[0.1em] text-[#6A7168] uppercase text-[10.5px]">DUE DATE</span>
                        <span id="pv-due-date" class="font-medium text-[#222922]">-</span>
                      </div>
                    </div>
                  </div>
                </header>

                <!-- BILLED TO & DELIVERY DETAILS -->
                <section class="grid grid-cols-2 gap-8 py-6">
                  <div class="pr-4 border-r border-[#D9CEB8]">
                    <h3 class="text-[10.5px] font-bold uppercase tracking-[0.16em] text-[#6A7168] mb-2.5">
                      BILLED TO
                    </h3>
                    <p id="pv-client-name" class="text-[14px] font-semibold text-[#1F271E] leading-snug">-</p>
                    <p id="pv-client-contact" class="mt-1 text-[12.5px] text-[#4A5248] leading-snug">-</p>
                    <p id="pv-client-address" class="mt-1 text-[12.5px] text-[#4A5248] leading-snug">-</p>
                  </div>

                  <div class="pl-1">
                    <h3 class="text-[10.5px] font-bold uppercase tracking-[0.16em] text-[#6A7168] mb-2.5">
                      DELIVERY DETAILS
                    </h3>
                    <p id="pv-recipient-name" class="text-[14px] font-semibold text-[#1F271E] leading-snug">-</p>
                    <p id="pv-delivery-datetime" class="mt-1 text-[12.5px] text-[#4A5248] leading-snug">-</p>
                    <p id="pv-delivery-address" class="mt-1 text-[12.5px] text-[#4A5248] leading-snug">-</p>
                  </div>
                </section>

                <!-- ITEMS TABLE -->
                <section class="mt-1">
                  <table class="w-full border-collapse">
                    <thead>
                      <tr class="bg-[#88937E] text-white">
                        <th class="py-2.5 px-4 text-left text-[10.5px] font-bold uppercase tracking-[0.14em] w-[50%]">
                          ITEM DESCRIPTION
                        </th>
                        <th class="py-2.5 px-3 text-center text-[10.5px] font-bold uppercase tracking-[0.14em] w-[10%]">
                          QTY
                        </th>
                        <th class="py-2.5 px-3 text-right text-[10.5px] font-bold uppercase tracking-[0.14em] w-[20%]">
                          UNIT PRICE
                        </th>
                        <th class="py-2.5 px-4 text-right text-[10.5px] font-bold uppercase tracking-[0.14em] w-[20%]">
                          TOTAL
                        </th>
                      </tr>
                    </thead>
                    <tbody id="pv-items-tbody" class="text-[12.5px] text-[#222922]"></tbody>
                  </table>
                </section>

                <!-- PAYMENT INSTRUCTIONS & TOTALS -->
                <section class="mt-8 pt-6 border-t-[1.5px] border-[#BFA77A] grid grid-cols-12 gap-8 items-start">
                  <!-- Left: Payment Method -->
                  <div class="col-span-6">
                    <h3 class="text-[10.5px] font-bold uppercase tracking-[0.15em] text-[#6A7168] mb-3">
                      PAYMENT METHOD &amp; INSTRUCTIONS
                    </h3>

                    <div id="pv-payment-box" class="border-l-2 border-[#6A7B5F] pl-4 space-y-4 text-[12px] text-[#353D34]">
                      <div id="pv-bank-block">
                        <p class="text-[10.5px] font-bold uppercase tracking-[0.12em] text-[#6A7168] mb-1">
                          BANK TRANSFER
                        </p>
                        <p><strong class="font-semibold text-[#1F271E]">Bank:</strong> <span id="pv-bank-name">-</span></p>
                        <p><strong class="font-semibold text-[#1F271E]">Account No.:</strong> <span id="pv-bank-acc">-</span></p>
                        <p><strong class="font-semibold text-[#1F271E]">Account Name:</strong> <span id="pv-bank-holder">-</span></p>
                      </div>

                      <div id="pv-qris-block">
                        <p class="text-[10.5px] font-bold uppercase tracking-[0.12em] text-[#6A7168] mb-1">
                          QRIS PAYMENT
                        </p>
                        <p><strong class="font-semibold text-[#1F271E]">Merchant ID / NMID:</strong> <span id="pv-qris-nmid">-</span></p>
                      </div>
                    </div>
                  </div>

                  <!-- Right: Totals -->
                  <div class="col-span-6 pl-4">
                    <div class="space-y-2.5 text-[12.5px]">
                      <div class="flex items-center justify-between">
                        <span class="font-bold uppercase tracking-[0.1em] text-[#6A7168] text-[11px]">SUBTOTAL</span>
                        <span id="pv-subtotal" class="font-medium text-[#222922]">Rp 0</span>
                      </div>
                      <div class="flex items-center justify-between">
                        <span class="font-bold uppercase tracking-[0.1em] text-[#6A7168] text-[11px]">SHIPPING FEE</span>
                        <span id="pv-shipping-fee" class="font-medium text-[#222922]">Rp 0</span>
                      </div>
                    </div>

                    <div class="mt-3 pt-3 border-t border-[#222922] flex items-baseline justify-between">
                      <span class="font-serif font-bold tracking-[0.06em] text-[#1F271E] text-[14px]">GRAND TOTAL</span>
                      <span id="pv-grand-total" class="font-serif font-bold text-[#1F271E] text-[20px]">Rp 0</span>
                    </div>

                    <!-- DP & Remaining Breakdown -->
                    <div id="pv-dp-breakdown" class="hidden mt-3 pt-2.5 border-t border-dashed border-[#BFA77A] space-y-1.5 text-[12px]">
                      <div class="flex items-center justify-between text-[#7C5C24]">
                        <span class="font-bold uppercase tracking-[0.08em] text-[10.5px]">DP / UANG MUKA</span>
                        <span id="pv-dp-amount" class="font-bold">- Rp 0</span>
                      </div>
                      <div class="flex items-center justify-between text-[#1F271E] pt-1">
                        <span class="font-bold uppercase tracking-[0.08em] text-[11px]">SISA PEMBAYARAN</span>
                        <span id="pv-balance-due" class="font-serif font-bold text-[15px]">Rp 0</span>
                      </div>
                    </div>
                  </div>
                </section>
              </div>

              <!-- BOTTOM SIGNATURE, STAMP & FOOTER -->
              <footer class="mt-14 pt-4">
                <div class="flex items-end justify-between gap-8 pb-6">
                  <div class="max-w-[340px]">
                    <p class="font-serif italic text-[13px] text-[#353D34] leading-relaxed">
                      Thank you for entrusting FLORAGATE with your floral arrangements.<br />
                      Every bloom is curated with care for your meaningful moments.
                    </p>
                  </div>

                  <div class="w-[240px] text-center relative">
                    <div id="pv-stamp-wrap" class="mx-auto mb-1 flex h-[108px] items-center justify-center pointer-events-none select-none">
                      <img
                        id="pv-stamp-img"
                        src={withBase('/images/invoice/stempel-floragate.webp')}
                        alt="Stempel Digital Floragate"
                        class="h-[106px] w-[106px] object-contain opacity-90 -rotate-6 mix-blend-multiply"
                        width="106"
                        height="106"
                      />
                    </div>
                    <div class="border-t border-[#222922] pt-2">
                      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-[#4A5248] leading-snug">
                        AUTHORIZED SIGNATURE &bull;<br />
                        FLORAGATE
                      </p>
                    </div>
                  </div>
                </div>

                <div class="border-t border-[#D9CEB8] pt-3 flex items-center justify-between text-[11px] text-[#6A7168]">
                  <span>FLORAGATE — tokobungamurahmalang.web.id &bull; Malang, Indonesia</span>
                  <span>Page 1 of 1</span>
                </div>
              </footer>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>

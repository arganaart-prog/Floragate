<script>
  const AUTH_SESSION_KEY = 'fg_invoice_auth_v1';
  const PREFS_KEY = 'fg_invoice_prefs_v1';
  const EXPECTED_CRED_HASH = 'f6279a1caffbb9b2da7089512c9a12f806d0c63cb66f3eee046e21692b0dc08d';

  // Pure-JS SHA-256 fallback for non-HTTPS contexts
  function sha256Fallback(ascii: string): string {
    const rightRotate = (value: number, amount: number) => (value >>> amount) | (value << (32 - amount));
    const mathPow = Math.pow;
    const maxWord = mathPow(2, 32);
    let result = '';
    const words: number[] = [];
    const asciiBitLength = ascii.length * 8;
    const hash: number[] = [];
    const k: number[] = [];
    let primeCounter = 0;

    const isComposite: Record<number, boolean> = {};
    for (let candidate = 2; primeCounter < 64; candidate++) {
      if (!isComposite[candidate]) {
        for (let i = 0; i < 313; i += candidate) isComposite[i] = true;
        hash[primeCounter] = (mathPow(candidate, 0.5) * maxWord) | 0;
        k[primeCounter++] = (mathPow(candidate, 1 / 3) * maxWord) | 0;
      }
    }

    ascii += '\x80';
    while ((ascii.length % 64) - 56) ascii += '\x00';
    for (let i = 0; i < ascii.length; i++) {
      const j = ascii.charCodeAt(i);
      if (j >> 8) return '';
      words[i >> 2] |= j << (((3 - i) % 4) * 8);
    }
    words[words.length] = (asciiBitLength / maxWord) | 0;
    words[words.length] = asciiBitLength;

    for (let j = 0; j < words.length; ) {
      const w = words.slice(j, (j += 16));
      const oldHash = hash.slice(0);
      for (let i = 0; i < 64; i++) {
        const w15 = w[i - 15];
        const w2 = w[i - 2];
        const a = hash[0];
        const e = hash[4];
        const temp1 =
          hash[7] +
          (rightRotate(e, 6) ^ rightRotate(e, 11) ^ rightRotate(e, 25)) +
          ((e & hash[5]) ^ (~e & hash[6])) +
          k[i] +
          (w[i] =
            i < 16
              ? w[i]
              : (w[i - 16] +
                  (rightRotate(w15, 7) ^ rightRotate(w15, 18) ^ (w15 >>> 3)) +
                  w[i - 7] +
                  (rightRotate(w2, 17) ^ rightRotate(w2, 19) ^ (w2 >>> 10))) |
                0);
        const temp2 =
          (rightRotate(a, 2) ^ rightRotate(a, 13) ^ rightRotate(a, 22)) +
          ((a & hash[1]) ^ (a & hash[2]) ^ (hash[1] & hash[2]));
        hash.unshift((temp1 + temp2) | 0);
        hash[4] = (hash[4] + temp1) | 0;
        hash.pop();
      }
      for (let i = 0; i < 8; i++) hash[i] = (hash[i] + oldHash[i]) | 0;
    }

    for (let i = 0; i < 8; i++) {
      for (let j = 3; j + 1; j--) {
        const b = (hash[i] >> (j * 8)) & 255;
        result += (b < 16 ? '0' : '') + b.toString(16);
      }
    }
    return result;
  }

  async function hashCredential(email: string, password: string): Promise<string> {
    const normalized = `${email.trim().toLowerCase()}::${password}`;
    if (typeof window !== 'undefined' && window.crypto?.subtle) {
      const data = new TextEncoder().encode(normalized);
      const digest = await window.crypto.subtle.digest('SHA-256', data);
      return Array.from(new Uint8Array(digest))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }
    return sha256Fallback(normalized);
  }

  function formatRupiah(num: number): string {
    const safe = Number.isFinite(num) ? Math.max(0, Math.round(num)) : 0;
    return `Rp ${safe.toLocaleString('id-ID')}`;
  }

  function formatDateID(isoDate: string): string {
    if (!isoDate) return '-';
    const d = new Date(`${isoDate}T00:00:00`);
    if (Number.isNaN(d.getTime())) return isoDate;
    return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function generateInvoiceNumber(seq = 1): string {
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth() + 1).padStart(2, '0');
    const d = String(now.getDate()).padStart(2, '0');
    return `INV-FG-${y}${m}${d}-${String(seq).padStart(3, '0')}`;
  }

  interface LineItem {
    name: string;
    note: string;
    price: number;
    qty: number;
  }

  type PaymentStatus = 'paid' | 'dp' | 'unpaid';

  function initInvoicePage() {
    const gate = document.getElementById('invoice-login-gate');
    const workspace = document.getElementById('invoice-workspace');
    const loginForm = document.getElementById('invoice-login-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('login-email') as HTMLInputElement | null;
    const passInput = document.getElementById('login-password') as HTMLInputElement | null;
    const rememberInput = document.getElementById('login-remember') as HTMLInputElement | null;
    const loginError = document.getElementById('login-error');
    const activeUserLabel = document.getElementById('active-user-label');
    const togglePassBtn = document.getElementById('toggle-password-btn');
    const eyeOpen = document.getElementById('eye-open-icon');
    const eyeClosed = document.getElementById('eye-closed-icon');

    if (!gate || !workspace || !loginForm || !emailInput || !passInput) return;

    function getSavedSession(): string | null {
      try {
        return localStorage.getItem(AUTH_SESSION_KEY) || sessionStorage.getItem(AUTH_SESSION_KEY);
      } catch {
        return null;
      }
    }

    function setAuthenticated(email: string, persist: boolean) {
      try {
        if (persist) {
          localStorage.setItem(AUTH_SESSION_KEY, email);
          sessionStorage.removeItem(AUTH_SESSION_KEY);
        } else {
          sessionStorage.setItem(AUTH_SESSION_KEY, email);
          localStorage.removeItem(AUTH_SESSION_KEY);
        }
      } catch {
        // Ignore storage errors in private mode
      }
      showWorkspace(email);
    }

    function showWorkspace(email: string) {
      gate!.classList.add('hidden');
      workspace!.classList.remove('hidden');
      if (activeUserLabel) activeUserLabel.textContent = `Masuk sebagai ${email}`;
    }

    function showLoginGate() {
      workspace!.classList.add('hidden');
      gate!.classList.remove('hidden');
      if (loginError) loginError.classList.add('hidden');
    }

    const existingUser = getSavedSession();
    if (existingUser) {
      showWorkspace(existingUser);
    }

    togglePassBtn?.addEventListener('click', () => {
      const showing = passInput.type === 'text';
      passInput.type = showing ? 'password' : 'text';
      eyeOpen?.classList.toggle('hidden', !showing);
      eyeClosed?.classList.toggle('hidden', showing);
    });

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      const pass = passInput.value;
      const hashed = await hashCredential(email, pass);

      if (hashed === EXPECTED_CRED_HASH) {
        if (loginError) loginError.classList.add('hidden');
        setAuthenticated(email.toLowerCase(), Boolean(rememberInput?.checked));
        passInput.value = '';
      } else if (loginError) {
        loginError.textContent = 'Email atau kata sandi tidak sesuai.';
        loginError.classList.remove('hidden');
      }
    });

    document.getElementById('btn-logout')?.addEventListener('click', () => {
      try {
        localStorage.removeItem(AUTH_SESSION_KEY);
        sessionStorage.removeItem(AUTH_SESSION_KEY);
      } catch {
        // Ignore
      }
      showLoginGate();
    });

    // Mobile tab switching
    const mobileEditBtn = document.getElementById('mobile-tab-edit');
    const mobilePreviewBtn = document.getElementById('mobile-tab-preview');
    const editorPanel = document.getElementById('editor-panel');
    const previewPanel = document.getElementById('preview-panel');

    function setMobileTab(mode: 'edit' | 'preview') {
      if (!editorPanel || !previewPanel || !mobileEditBtn || !mobilePreviewBtn) return;
      const isEdit = mode === 'edit';
      editorPanel.classList.toggle('hidden', !isEdit);
      previewPanel.classList.toggle('hidden', isEdit);
      mobileEditBtn.classList.toggle('bg-primary', isEdit);
      mobileEditBtn.classList.toggle('text-white', isEdit);
      mobileEditBtn.classList.toggle('text-slate-600', !isEdit);
      mobilePreviewBtn.classList.toggle('bg-primary', !isEdit);
      mobilePreviewBtn.classList.toggle('text-white', !isEdit);
      mobilePreviewBtn.classList.toggle('text-slate-600', isEdit);
    }

    mobileEditBtn?.addEventListener('click', () => setMobileTab('edit'));
    mobilePreviewBtn?.addEventListener('click', () => setMobileTab('preview'));

    // ========== INVOICE STATE & RENDERER ==========
    let prefs: Record<string, any> = {};
    try {
      prefs = JSON.parse(localStorage.getItem(PREFS_KEY) || '{}') || {};
    } catch {
      prefs = {};
    }

    const todayISO = new Date().toISOString().slice(0, 10);
    let currentSeq = Number(prefs.seq) || 1;
    let status: PaymentStatus = 'unpaid';
    let items: LineItem[] = [
      {
        name: 'Bunga Papan Duka Cita Malang 001',
        note: '',
        price: 675000,
        qty: 1,
      },
    ];

    const fInvoiceNo = document.getElementById('f-invoice-no') as HTMLInputElement;
    const fIssueDate = document.getElementById('f-issue-date') as HTMLInputElement;
    const fDueDate = document.getElementById('f-due-date') as HTMLInputElement;
    const fDpAmount = document.getElementById('f-dp-amount') as HTMLInputElement;
    const fClientName = document.getElementById('f-client-name') as HTMLInputElement;
    const fClientContact = document.getElementById('f-client-contact') as HTMLInputElement;
    const fClientAddress = document.getElementById('f-client-address') as HTMLInputElement;
    const fRecipientName = document.getElementById('f-recipient-name') as HTMLInputElement;
    const fDeliveryDatetime = document.getElementById('f-delivery-datetime') as HTMLInputElement;
    const fDeliveryAddress = document.getElementById('f-delivery-address') as HTMLInputElement;
    const fShippingFee = document.getElementById('f-shipping-fee') as HTMLInputElement;
    const fBankName = document.getElementById('f-bank-name') as HTMLInputElement;
    const fBankAcc = document.getElementById('f-bank-acc') as HTMLInputElement;
    const fBankHolder = document.getElementById('f-bank-holder') as HTMLInputElement;
    const fQrisNmid = document.getElementById('f-qris-nmid') as HTMLInputElement;
    const fShowBank = document.getElementById('f-show-bank') as HTMLInputElement;
    const fShowQris = document.getElementById('f-show-qris') as HTMLInputElement;
    const fShowStamp = document.getElementById('f-show-stamp') as HTMLInputElement;
    const fStampRotation = document.getElementById('f-stamp-rotation') as HTMLSelectElement;

    // Seed defaults
    fInvoiceNo.value = generateInvoiceNumber(currentSeq);
    fIssueDate.value = todayISO;
    fDueDate.value = todayISO;
    fBankName.value = prefs.bankName || 'BCA';
    fBankAcc.value = prefs.bankAcc || '';
    fBankHolder.value = prefs.bankHolder || 'Floragate Florist';
    fQrisNmid.value = prefs.qrisNmid || '';
    fShowBank.checked = prefs.showBank !== false;
    fShowQris.checked = prefs.showQris !== false;

    function savePaymentPrefs() {
      try {
        localStorage.setItem(
          PREFS_KEY,
          JSON.stringify({
            seq: currentSeq,
            bankName: fBankName.value,
            bankAcc: fBankAcc.value,
            bankHolder: fBankHolder.value,
            qrisNmid: fQrisNmid.value,
            showBank: fShowBank.checked,
            showQris: fShowQris.checked,
          })
        );
      } catch {
        // Ignore
      }
    }

    function getTotals() {
      const subtotal = items.reduce((sum, item) => sum + (Number(item.price) || 0) * (Number(item.qty) || 0), 0);
      const shipping = Math.max(0, Number(fShippingFee.value) || 0);
      const grandTotal = subtotal + shipping;
      const dpAmount = status === 'dp' ? Math.min(grandTotal, Math.max(0, Number(fDpAmount.value) || 0)) : 0;
      const balanceDue = Math.max(0, grandTotal - dpAmount);
      return { subtotal, shipping, grandTotal, dpAmount, balanceDue };
    }

    function renderItemsEditor() {
      const container = document.getElementById('items-editor-list');
      if (!container) return;

      container.innerHTML = '';
      items.forEach((item, idx) => {
        const card = document.createElement('div');
        card.className = 'rounded-xl border border-soft-cream bg-clean-ivory/35 p-3 space-y-2.5';

        const topRow = document.createElement('div');
        topRow.className = 'flex items-center justify-between gap-2';

        const label = document.createElement('span');
        label.className = 'text-[11px] font-bold uppercase tracking-wider text-primary-dark';
        label.textContent = `Item #${idx + 1}`;
        topRow.appendChild(label);

        if (items.length > 1) {
          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'text-xs font-bold text-red-600 hover:text-red-800 px-2 py-0.5 rounded cursor-pointer';
          delBtn.textContent = 'Hapus';
          delBtn.addEventListener('click', () => {
            items.splice(idx, 1);
            renderItemsEditor();
            renderPreview();
          });
          topRow.appendChild(delBtn);
        }

        const nameInput = document.createElement('input');
        nameInput.type = 'text';
        nameInput.placeholder = 'Nama produk (mis: Bunga Papan Wedding Malang 001)';
        nameInput.className = 'inv-input bg-white';
        nameInput.value = item.name;
        nameInput.addEventListener('input', () => {
          items[idx].name = nameInput.value;
          renderPreview();
        });

        const noteInput = document.createElement('input');
        noteInput.type = 'text';
        noteInput.placeholder = 'Keterangan / ucapan singkat (opsional)';
        noteInput.className = 'inv-input bg-white text-xs';
        noteInput.value = item.note;
        noteInput.addEventListener('input', () => {
          items[idx].note = noteInput.value;
          renderPreview();
        });

        const gridRow = document.createElement('div');
        gridRow.className = 'grid grid-cols-2 gap-2.5';

        const priceWrap = document.createElement('div');
        const priceLbl = document.createElement('label');
        priceLbl.className = 'block text-[10px] font-bold uppercase text-slate-500 mb-1';
        priceLbl.textContent = 'Harga (Rp)';
        const priceInput = document.createElement('input');
        priceInput.type = 'number';
        priceInput.min = '0';
        priceInput.step = '5000';
        priceInput.className = 'inv-input bg-white';
        priceInput.value = String(item.price);
        priceInput.addEventListener('input', () => {
          items[idx].price = Math.max(0, Number(priceInput.value) || 0);
          renderPreview();
        });
        priceWrap.append(priceLbl, priceInput);

        const qtyWrap = document.createElement('div');
        const qtyLbl = document.createElement('label');
        qtyLbl.className = 'block text-[10px] font-bold uppercase text-slate-500 mb-1';
        qtyLbl.textContent = 'Jumlah (Qty)';
        const qtyInput = document.createElement('input');
        qtyInput.type = 'number';
        qtyInput.min = '1';
        qtyInput.step = '1';
        qtyInput.className = 'inv-input bg-white';
        qtyInput.value = String(item.qty);
        qtyInput.addEventListener('input', () => {
          items[idx].qty = Math.max(1, parseInt(qtyInput.value || '1', 10) || 1);
          renderPreview();
        });
        qtyWrap.append(qtyLbl, qtyInput);

        gridRow.append(priceWrap, qtyWrap);
        card.append(topRow, nameInput, noteInput, gridRow);
        container.appendChild(card);
      });
    }

    function updateStatusButtonsUI() {
      document.querySelectorAll('.status-choice-btn').forEach((btn) => {
        const val = btn.getAttribute('data-status-btn');
        const active = val === status;
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('shadow-xs', active);
        btn.classList.toggle('border-soft-cream', !active);
        btn.classList.toggle('bg-clean-ivory/40', !active);
        btn.classList.toggle('text-slate-700', !active);
      });
      document.getElementById('dp-input-wrap')?.classList.toggle('hidden', status !== 'dp');
    }

    function renderPreview() {
      const setText = (id: string, val: string, fallback = '-') => {
        const el = document.getElementById(id);
        if (el) el.textContent = val.trim() || fallback;
      };

      setText('pv-invoice-no', fInvoiceNo.value, 'INV-FG-001');
      setText('pv-issue-date', formatDateID(fIssueDate.value));
      setText('pv-due-date', formatDateID(fDueDate.value));

      setText('pv-client-name', fClientName.value, '[Nama Pemesan]');
      setText('pv-client-contact', fClientContact.value, '[No. WA / Email]');
      setText('pv-client-address', fClientAddress.value, '[Alamat Pemesan]');

      setText('pv-recipient-name', fRecipientName.value, '[Nama Penerima]');
      setText('pv-delivery-datetime', fDeliveryDatetime.value, '[Tanggal & Jam Kirim]');
      setText('pv-delivery-address', fDeliveryAddress.value, '[Alamat Pengiriman, Malang]');

      // Status badge on invoice
      const badge = document.getElementById('pv-status-badge');
      if (badge) {
        if (status === 'paid') {
          badge.textContent = 'SUDAH DIBAYAR / PAID';
          badge.className = 'inline-block border border-[#3F4B37] bg-[#E8EFE3] text-[#2F3B28] px-3.5 py-1 text-[10.5px] font-bold uppercase tracking-[0.16em]';
        } else if (status === 'dp') {
          badge.textContent = 'DP / DOWN PAYMENT';
          badge.className = 'inline-block border border-[#9E824D] bg-[#FAF1DE] text-[#6B5021] px-3.5 py-1 text-[10.5px] font-bold uppercase tracking-[0.16em]';
        } else {
          badge.textContent = 'BELUM DIBAYAR / UNPAID';
          badge.className = 'inline-block border border-[#9B2C2C] bg-[#FDECEC] text-[#8B1E1E] px-3.5 py-1 text-[10.5px] font-bold uppercase tracking-[0.16em]';
        }
      }

      // Line items table rows
      const tbody = document.getElementById('pv-items-tbody');
      if (tbody) {
        tbody.innerHTML = '';
        items.forEach((item) => {
          const rowTotal = (Number(item.price) || 0) * (Number(item.qty) || 0);
          const tr = document.createElement('tr');
          tr.className = 'border-b border-[#D9CEB8]';

          const tdDesc = document.createElement('td');
          tdDesc.className = 'py-3 px-4 align-top';
          const titleEl = document.createElement('p');
          titleEl.className = 'font-medium text-[#1F271E] leading-snug';
          titleEl.textContent = item.name.trim() || 'Item Produk';
          tdDesc.appendChild(titleEl);
          if (item.note.trim()) {
            const noteEl = document.createElement('p');
            noteEl.className = 'mt-0.5 text-[11px] text-[#6A7168] leading-snug';
            noteEl.textContent = item.note.trim();
            tdDesc.appendChild(noteEl);
          }

          const tdQty = document.createElement('td');
          tdQty.className = 'py-3 px-3 text-center align-top';
          tdQty.textContent = String(item.qty || 0);

          const tdPrice = document.createElement('td');
          tdPrice.className = 'py-3 px-3 text-right align-top whitespace-nowrap';
          tdPrice.textContent = formatRupiah(item.price);

          const tdTotal = document.createElement('td');
          tdTotal.className = 'py-3 px-4 text-right align-top font-semibold text-[#1F271E] whitespace-nowrap';
          tdTotal.textContent = formatRupiah(rowTotal);

          tr.append(tdDesc, tdQty, tdPrice, tdTotal);
          tbody.appendChild(tr);
        });

        // Pad empty ruled lines up to 5 rows total to preserve airy template elegance
        const emptyRows = Math.max(0, 5 - items.length);
        for (let i = 0; i < emptyRows; i++) {
          const trEmpty = document.createElement('tr');
          trEmpty.className = 'border-b border-[#D9CEB8]';
          trEmpty.innerHTML = '<td class="py-4 px-4">&nbsp;</td><td></td><td></td><td></td>';
          tbody.appendChild(trEmpty);
        }
      }

      // Totals
      const { subtotal, shipping, grandTotal, dpAmount, balanceDue } = getTotals();
      setText('pv-subtotal', formatRupiah(subtotal));
      setText('pv-shipping-fee', shipping === 0 ? 'Rp 0 (Gratis Ongkir)' : formatRupiah(shipping));
      setText('pv-grand-total', formatRupiah(grandTotal));

      const dpBreakdown = document.getElementById('pv-dp-breakdown');
      if (dpBreakdown) {
        dpBreakdown.classList.toggle('hidden', status !== 'dp');
        setText('pv-dp-amount', `- ${formatRupiah(dpAmount)}`);
        setText('pv-balance-due', formatRupiah(balanceDue));
      }

      // Payment info
      const showBank = fShowBank.checked;
      const showQris = fShowQris.checked;
      document.getElementById('pv-bank-block')?.classList.toggle('hidden', !showBank);
      document.getElementById('pv-qris-block')?.classList.toggle('hidden', !showQris);
      document.getElementById('pv-payment-box')?.classList.toggle('hidden', !showBank && !showQris);

      setText('pv-bank-name', fBankName.value, '[Nama Bank]');
      setText('pv-bank-acc', fBankAcc.value, '[No. Rekening]');
      setText('pv-bank-holder', fBankHolder.value, '[Atas Nama]');
      setText('pv-qris-nmid', fQrisNmid.value, '[NMID QRIS]');

      // Digital stamp
      const stampWrap = document.getElementById('pv-stamp-wrap');
      const stampImg = document.getElementById('pv-stamp-img');
      if (stampWrap) stampWrap.classList.toggle('opacity-0', !fShowStamp.checked);
      if (stampImg) {
        stampImg.style.transform = `rotate(${fStampRotation.value}deg)`;
      }

      // Document title when saving PDF
      const cleanInv = (fInvoiceNo.value || 'Invoice').replace(/[^\w\-]+/g, '_');
      const cleanClient = (fClientName.value || 'Floragate').replace(/[^\w\-]+/g, '_');
      document.title = `${cleanInv}_${cleanClient}`;
    }

    // Attach listeners
    document.querySelectorAll('.status-choice-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        status = (btn.getAttribute('data-status-btn') as PaymentStatus) || 'unpaid';
        if (status === 'dp' && (!fDpAmount.value || Number(fDpAmount.value) === 0)) {
          const { grandTotal } = getTotals();
          fDpAmount.value = String(Math.round(grandTotal * 0.5));
        }
        updateStatusButtonsUI();
        renderPreview();
      });
    });

    document.querySelectorAll('.dp-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pct = Number(btn.getAttribute('data-dp-percent') || '50');
        const { grandTotal } = getTotals();
        fDpAmount.value = String(Math.round((grandTotal * pct) / 100));
        renderPreview();
      });
    });

    document.getElementById('btn-add-item')?.addEventListener('click', () => {
      items.push({ name: '', note: '', price: 0, qty: 1 });
      renderItemsEditor();
      renderPreview();
    });

    document.getElementById('btn-insert-catalog')?.addEventListener('click', () => {
      const select = document.getElementById('catalog-quick-select') as HTMLSelectElement | null;
      if (!select || !select.value) return;
      const opt = select.selectedOptions[0];
      const name = opt?.getAttribute('data-name') || '';
      const price = Number(opt?.getAttribute('data-price') || '0');
      if (name) {
        // Replace single blank item if untouched, else push new row
        if (items.length === 1 && !items[0].name.trim() && items[0].price === 0) {
          items[0] = { name, note: '', price, qty: 1 };
        } else {
          items.push({ name, note: '', price, qty: 1 });
        }
        renderItemsEditor();
        renderPreview();
        select.value = '';
      }
    });

    [
      fInvoiceNo,
      fIssueDate,
      fDueDate,
      fDpAmount,
      fClientName,
      fClientContact,
      fClientAddress,
      fRecipientName,
      fDeliveryDatetime,
      fDeliveryAddress,
      fShippingFee,
      fBankName,
      fBankAcc,
      fBankHolder,
      fQrisNmid,
      fShowBank,
      fShowQris,
      fShowStamp,
      fStampRotation,
    ].forEach((el) => {
      el?.addEventListener('input', () => {
        savePaymentPrefs();
        renderPreview();
      });
      el?.addEventListener('change', () => {
        savePaymentPrefs();
        renderPreview();
      });
    });

    document.getElementById('btn-new-invoice')?.addEventListener('click', () => {
      currentSeq += 1;
      savePaymentPrefs();
      fInvoiceNo.value = generateInvoiceNumber(currentSeq);
      fClientName.value = '';
      fClientContact.value = '';
      fClientAddress.value = '';
      fRecipientName.value = '';
      fDeliveryDatetime.value = '';
      fDeliveryAddress.value = '';
      fShippingFee.value = '0';
      fDpAmount.value = '';
      status = 'unpaid';
      items = [{ name: '', note: '', price: 0, qty: 1 }];
      updateStatusButtonsUI();
      renderItemsEditor();
      renderPreview();
    });

    document.getElementById('btn-print-invoice')?.addEventListener('click', () => {
      window.print();
    });

    updateStatusButtonsUI();
    renderItemsEditor();
    renderPreview();
  }

  initInvoicePage();
</script>

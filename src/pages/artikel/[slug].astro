---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { ARTICLES, getArticleBySlug, getRelatedArticles, type Article } from '../../data/articles';
import { withBase } from '../../utils/paths';
import { WHATSAPP_NUMBER } from '../../data/constants';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const relatedArticles = getRelatedArticles(article.slug, 3);

const title = `${article.title} | Floragate Malang`;
const description = article.excerpt;
---

<Layout title={title} description={description} image={withBase(article.image)}>
  <article class="bg-clean-ivory min-h-screen py-8 md:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <div class="mb-6">
        <Breadcrumb items={[
          { label: 'Artikel & Panduan', href: '/artikel/' },
          { label: article.title }
        ]} />
      </div>

      <!-- Article Header -->
      <header class="mb-8 md:mb-10 text-left">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-white bg-primary">
            {article.category}
          </span>
          <span class="text-xs text-slate-400 font-medium">{article.date}</span>
          <span class="w-1 h-1 rounded-full bg-slate-300"></span>
          <span class="inline-flex items-center gap-1 text-xs text-slate-500 font-medium">
            <svg class="w-3.5 h-3.5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {article.readTime}
          </span>
        </div>

        <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-slate-800 tracking-tight leading-tight mb-6">
          {article.title}
        </h1>

        <!-- Author Strip -->
        <div class="flex items-center gap-3.5 py-4 border-y border-cream/80">
          <div class="w-10 h-10 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center text-primary font-bold font-serif text-sm">
            {article.author.charAt(0)}
          </div>
          <div>
            <div class="text-sm font-bold text-slate-800">{article.author}</div>
            <div class="text-xs text-slate-500">{article.authorRole}</div>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      <div class="rounded-2xl overflow-hidden shadow-lg border border-cream/90 mb-10 bg-accent-bg aspect-[16/9] relative">
        <img
          src={withBase(article.image)}
          alt={article.title}
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Article Content Body -->
      <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-8 text-base md:text-lg">
        <!-- Lead Paragraph -->
        <p class="font-serif text-lg md:text-xl text-slate-800 font-medium leading-relaxed italic bg-white p-6 rounded-2xl border-l-4 border-secondary shadow-sm">
          "{article.content.lead}"
        </p>

        <!-- Sections -->
        {article.content.sections.map((section) => (
          <div class="space-y-4 pt-2">
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-800 tracking-tight mt-6 mb-3">
              {section.heading}
            </h2>
            {section.body.map((para) => (
              <p class="text-slate-600 text-base leading-relaxed">
                {para}
              </p>
            ))}

            {section.tip && (
              <div class="my-4 p-4 sm:p-5 rounded-xl bg-accent-bg border border-secondary/40 flex items-start gap-3">
                <span class="inline-flex p-1 rounded-full bg-secondary text-white flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                  </svg>
                </span>
                <div class="text-xs sm:text-sm text-slate-700 font-medium leading-relaxed">
                  <strong class="text-primary font-bold">Tips Floragate:</strong> {section.tip}
                </div>
              </div>
            )}
          </div>
        ))}

        <!-- Conclusion -->
        <div class="pt-6 border-t border-slate-200">
          <p class="text-slate-700 text-base leading-relaxed font-medium">
            {article.content.conclusion}
          </p>
        </div>
      </div>

      <!-- Tags & Share -->
      <div class="mt-10 pt-6 border-t border-cream/90 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-slate-400">Tag:</span>
          {article.tags.map((tag) => (
            <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-xs text-slate-600 font-medium">
              #{tag}
            </span>
          ))}
        </div>

        <a
          href={`https://wa.me/?text=${encodeURIComponent(`Baca artikel bermanfaat dari Floragate: "${article.title}"`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-secondary transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/>
          </svg>
          Bagikan ke WhatsApp
        </a>
      </div>

      <!-- Action Card -->
      <div class="mt-12 bg-white rounded-2xl border border-secondary/40 p-6 sm:p-8 shadow-md flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="font-serif text-xl font-bold text-slate-800">Siap Pesan Karangan Bunga Impian Anda?</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Konsultasikan kebutuhan bunga papan, buket, standing flower, atau tanbulampot sekarang.</p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a
            href={withBase('/katalog/')}
            class="flex-1 sm:flex-initial text-center px-5 py-2.5 rounded-full bg-primary text-white text-xs font-bold hover:bg-primary-dark transition-all"
          >
            Lihat Katalog
          </a>
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=Halo%20Floragate,%20saya%20tertarik%20dengan%20artikel%20"${encodeURIComponent(article.title)}"%20dan%20ingin%20tanya%20pemesanan%20bunga.`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-initial text-center px-5 py-2.5 rounded-full bg-secondary text-white text-xs font-bold hover:bg-secondary-dark transition-all"
          >
            Chat WhatsApp
          </a>
        </div>
      </div>

      <!-- Related Articles -->
      {relatedArticles.length > 0 && (
        <div class="mt-16 pt-10 border-t border-slate-200">
          <h3 class="font-serif text-2xl font-bold text-slate-800 mb-6">Artikel Terkait Lainnya</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedArticles.map((rel) => (
              <a
                href={withBase(`/artikel/${rel.slug}/`)}
                class="bg-white rounded-xl border border-cream/90 p-4 shadow-sm hover:shadow-md hover:border-secondary/60 transition-all flex flex-col group"
              >
                <div class="aspect-[16/10] rounded-lg overflow-hidden bg-accent-bg mb-3">
                  <img
                    src={withBase(rel.image)}
                    alt={rel.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-secondary mb-1">
                  {rel.category}
                </span>
                <h4 class="font-serif text-sm font-bold text-slate-800 group-hover:text-primary transition-colors line-clamp-2 leading-snug flex-1">
                  {rel.title}
                </h4>
                <span class="text-[11px] text-slate-400 mt-2 font-medium">
                  {rel.readTime}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroBanner from '../components/HeroBanner.astro';
import CategoryCarousel from '../components/CategoryCarousel.astro';
import BungaPapanSection from '../components/BungaPapanSection.astro';
import HandBouquetSection from '../components/HandBouquetSection.astro';
import StandingFlowerSection from '../components/StandingFlowerSection.astro';
import PaperFlowerSection from '../components/PaperFlowerSection.astro';
import BungaMejaSection from '../components/BungaMejaSection.astro';
import TanbulampotSection from '../components/TanbulampotSection.astro';
import { PRODUCTS } from '../data/products';
import { WHATSAPP_NUMBER } from '../data/constants';
import { withBase } from '../utils/paths';
import { getRotatingHomeProducts } from '../utils/rotatingProducts';
import { getHomeDisplayProducts } from '../utils/productHelpers';

// Batasi 8 produk unggulan; bunga papan max 8/subkategori; rotasi setiap 3 hari
const { candidateProducts, activeIndices } = getRotatingHomeProducts(getHomeDisplayProducts(PRODUCTS), 8);
const activeIndicesSet = new Set(activeIndices);

// SEO Meta
const title = "Toko Bunga Malang Murah & Berkualitas - Florist Cepat";
const description = "Floragate adalah toko bunga Malang murah dan berkualitas untuk bunga papan, wedding, duka cita, standing flower, hand bouquet, paper flower, bunga meja, dan tanbulampot pohon ucapan. Harga bersahabat, bunga segar, pengerjaan cepat 3 jam.";
---

<Layout title={title} description={description}>
  
  <!-- Hero Section — Cinematic Malang Edition -->
  <HeroBanner />

  <!-- Categories Section -->
  <section class="category-transition-section relative py-20 bg-white">
    <svg class="section-transition-curve section-transition-curve--category" viewBox="0 0 1440 120" fill="none" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="category-transition-curve-gradient" x1="0" y1="0" x2="0" y2="120" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.72" />
          <stop offset="100%" stop-color="#ffffff" />
        </linearGradient>
      </defs>
      <path d="M0 120 L0 60 Q360 0 720 40 T1440 20 L1440 120Z" fill="url(#category-transition-curve-gradient)" />
    </svg>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Kategori Bunga Pilihan</h2>
        <p class="text-slate-500 text-sm mt-3 leading-relaxed">Temukan karangan bunga yang tepat untuk mendampingi setiap momen penting Anda, dari rasa duka hingga ungkapan sukacita.</p>
      </div>
      
      <CategoryCarousel />
    </div>
  </section>

  <!-- Featured Products Section -->
  <section class="featured-products-section py-20 bg-white border-y border-soft-cream/60">
    <div class="featured-products-mobile-band" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="featured-products-header flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div class="max-w-xl">
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Produk Unggulan Terpopuler</h2>
          <p class="text-slate-500 text-sm mt-3 leading-relaxed">Kumpulan desain karangan bunga yang paling sering dipesan oleh pelanggan kami di Malang untuk berbagai keperluan.</p>
        </div>
        <a 
          href={withBase('/katalog/')} 
          class="mt-4 hidden md:mt-0 md:inline-flex items-center text-sm font-semibold text-primary hover:text-secondary transition-colors group"
        >
          Lihat Semua Produk
          <svg class="h-4 w-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      
      <!-- 8 Featured Products Grid (Rotasi Setiap 3 Hari) -->
      <div id="featured-products-slider" data-featured-products-slider class="featured-products-slider grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {candidateProducts.map((product, index) => {
          const isActive = activeIndicesSet.has(index);
          const activePos = activeIndices.indexOf(index);
          const priority = isActive && activePos < 4;
          return (
            <ProductCard
              product={product}
              variant="classic"
              priority={priority}
              class={isActive ? '' : 'hidden'}
              hidden={!isActive}
              data-featured-product-index={index}
            />
          );
        })}
      </div>
    </div>
  </section>


  <style is:global>
    .quality-transition-section,
    .category-transition-section {
      --transition-curve-height: clamp(4.5rem, 9vw, 7rem);
      overflow: visible;
      isolation: isolate;
    }

    .section-transition-curve {
      position: absolute;
      top: calc(-1 * var(--transition-curve-height) + 1px);
      left: 0;
      right: 0;
      z-index: 1;
      display: block;
      width: 100%;
      height: var(--transition-curve-height);
      pointer-events: none;
    }



    .featured-products-mobile-band {
      display: none;
    }

    @media (min-width: 768px) {
      .featured-products-slider .classic-product-image {
        aspect-ratio: 20 / 22;
      }
    }

    @media (max-width: 767px) {
      .category-transition-section {
        padding-top: 2.75rem;
        padding-bottom: 2.75rem;
      }

      .category-transition-section .text-center {
        margin-bottom: 2rem;
      }
      .featured-products-section {
        padding-top: 2.5rem;
        padding-bottom: 2.75rem;
        background: #f8f5ef;
        border-color: rgba(234, 219, 198, 0.55);
      }

      .featured-products-mobile-band {
        display: block;
        width: 100%;
        height: 2rem;
        margin-bottom: 1rem;
        background: var(--color-primary);
        opacity: 0.05;
      }

      .featured-products-header {
        display: block;
        margin-bottom: 2rem;
        text-align: center;
      }

      .featured-products-header h2 {
        font-size: clamp(1.7rem, 7.2vw, 2.1rem);
        line-height: 1.08;
      }

      .featured-products-header p {
        max-width: 21rem;
        margin-inline: auto;
        font-size: 0.86rem;
      }

      .featured-products-slider {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-inline: -1rem;
        padding: 0.5rem 1rem 0.75rem;
        overflow-x: auto;
        overflow-y: visible;
        scroll-behavior: smooth;
        scroll-padding-inline: 1rem;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
      }

      .featured-products-slider::-webkit-scrollbar {
        display: none;
      }

      .featured-products-slider .classic-product-card.hidden,
      .featured-products-slider .classic-product-card[hidden],
      .classic-product-card.hidden,
      .classic-product-card[hidden] {
        display: none !important;
      }

      .featured-products-slider .classic-product-card {
        flex: 0 0 calc((100% - 24px) / 3);
        min-width: calc((100% - 24px) / 3);
        display: flex;
        flex-direction: column;
        align-self: flex-start;
        height: auto;
        min-height: 0;
        content-visibility: visible;
        contain-intrinsic-size: none;
        border: 2px solid #e7dcc5;
        border-radius: 12px;
        box-shadow: 0 5px 16px rgba(15, 23, 42, 0.06);
        scroll-snap-align: start;
      }

      .featured-products-slider .classic-product-card:hover {
        transform: none;
      }

      .featured-products-slider .classic-product-image {
        flex: 0 0 auto;
        aspect-ratio: 1 / 1.08;
        border-bottom: 1px solid #efe4cf;
      }

      .featured-products-slider .classic-product-badges {
        top: 6px;
        right: 6px;
        left: 6px;
        max-width: none;
        justify-content: space-between;
        gap: 4px;
      }

      .featured-products-slider .classic-product-badges span {
        max-width: 48%;
        overflow: hidden;
        padding: 2px 5px;
        border-radius: 999px;
        font-size: 8px;
        line-height: 1.05;
        letter-spacing: 0.02em;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .featured-products-slider .classic-product-info {
        flex: 0 0 auto;
        height: auto;
        min-height: 0;
        padding: 0.38rem 0.45rem 0.55rem;
        text-align: center;
      }

      .featured-products-slider .classic-product-category,
      .featured-products-slider .classic-product-price-label {
        display: none;
      }

      .featured-products-slider .classic-product-title {
        display: -webkit-box;
        height: 2.55em;
        min-height: 2.5em;
        max-height: 2.55em;
        overflow: hidden;
        overflow-wrap: anywhere;
        font-family: var(--font-sans), system-ui, sans-serif;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.15;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      .featured-products-slider .classic-product-price-wrap {
        padding-top: 0.4rem;
      }

      .featured-products-slider .classic-product-price-box {
        margin-top: 0;
        padding: 0;
        border: 0;
        background: transparent;
      }

      .featured-products-slider .classic-product-price-row {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.45rem;
      }

      .featured-products-slider .classic-product-price {
        overflow: hidden;
        color: var(--color-primary);
        font-size: 12px;
        line-height: 1.1;
        text-align: center;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .featured-products-slider .classic-product-detail {
        width: 100%;
        min-height: 42px;
        padding: 0.65rem 0.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        box-shadow: none;
        font-size: 11px;
        line-height: 1;
      }
    }

    @media (max-width: 380px) {
      .featured-products-slider .classic-product-title {
        font-size: 10.5px;
      }

      .featured-products-slider .classic-product-price,
      .featured-products-slider .classic-product-detail {
        font-size: 10.5px;
      }
    }
  </style>

  <script>
    function updateRotatingFeaturedProducts(slider) {
      var cards = slider.querySelectorAll('[data-featured-product-index]');
      var total = cards.length;
      if (total <= 8) return;

      var WIB_OFFSET_MS = 7 * 60 * 60 * 1000;
      var dayNumber = Math.floor((Date.now() + WIB_OFFSET_MS) / (24 * 60 * 60 * 1000));
      var cycleIndex = Math.floor(dayNumber / 3);
      var start = (cycleIndex * 8) % total;

      var activeIndices = [];
      for (var i = 0; i < 8; i++) {
        activeIndices.push((start + i) % total);
      }

      cards.forEach(function(card) {
        var idx = parseInt(card.getAttribute('data-featured-product-index') || '-1', 10);
        var shouldShow = activeIndices.indexOf(idx) !== -1;
        if (shouldShow) {
          card.classList.remove('hidden');
          card.removeAttribute('hidden');
        } else {
          card.classList.add('hidden');
          card.setAttribute('hidden', '');
        }
      });
    }

    function initFeaturedProductsSlider() {
      document.querySelectorAll('[data-featured-products-slider]').forEach(function(slider) {
        updateRotatingFeaturedProducts(slider);

        if (slider.dataset.featuredSliderReady === 'true') return;
        slider.dataset.featuredSliderReady = 'true';

        var mobileQuery = window.matchMedia('(max-width: 767px)');
        var reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        var intervalId = 0;

        function stopAutoSlide() {
          if (!intervalId) return;
          window.clearInterval(intervalId);
          intervalId = 0;
        }

        function startAutoSlide() {
          stopAutoSlide();
          if (!mobileQuery.matches || reduceMotionQuery.matches) return;

          intervalId = window.setInterval(function() {
            var visibleCards = Array.from(slider.querySelectorAll('.classic-product-card')).filter(function(card) {
              return !card.classList.contains('hidden') && !card.hasAttribute('hidden') && card.style.display !== 'none';
            });
            var card = visibleCards[0];
            if (!card) return;

            var gap = parseFloat(window.getComputedStyle(slider).gap) || 12;
            var step = card.getBoundingClientRect().width + gap;
            slider.scrollBy({ left: step, behavior: 'smooth' });

            window.setTimeout(function() {
              if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 15) {
                slider.scrollLeft = 0;
              }
            }, 600);
          }, 2600);
        }

        slider.addEventListener('mouseenter', stopAutoSlide);
        slider.addEventListener('mouseleave', startAutoSlide);
        slider.addEventListener('focusin', stopAutoSlide);
        slider.addEventListener('focusout', startAutoSlide);
        slider.addEventListener('touchstart', stopAutoSlide, { passive: true });
        slider.addEventListener('touchend', startAutoSlide, { passive: true });
        mobileQuery.addEventListener('change', startAutoSlide);
        reduceMotionQuery.addEventListener('change', startAutoSlide);
        document.addEventListener('visibilitychange', function() {
          if (document.hidden) {
            stopAutoSlide();
          } else {
            startAutoSlide();
          }
        });

        startAutoSlide();
      });
    }

    initFeaturedProductsSlider();
    document.addEventListener('astro:page-load', initFeaturedProductsSlider);

    function getWIBDayNumberClient() {
      var WIB_OFFSET_MS = 7 * 60 * 60 * 1000;
      return Math.floor((Date.now() + WIB_OFFSET_MS) / (24 * 60 * 60 * 1000));
    }

    function getCategoryDaySeedClient(categorySlug, dayNumber) {
      var hash = 0;
      for (var i = 0; i < categorySlug.length; i++) {
        hash = (hash << 5) - hash + categorySlug.charCodeAt(i);
        hash |= 0;
      }
      return Math.abs(hash ^ (dayNumber * 2654435761));
    }

    function mulberry32Client(seed) {
      return function() {
        var t = (seed += 0x6d2b79f5);
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function initDailyCategoryRotation() {
      var containers = document.querySelectorAll('[data-daily-rotate-category]');
      if (!containers.length) return;

      var dayNumber = getWIBDayNumberClient();

      containers.forEach(function(container) {
        var categorySlug = container.getAttribute('data-daily-rotate-category');
        if (!categorySlug) return;

        if (container.getAttribute('data-daily-rotate-day') === String(dayNumber)) return;
        container.setAttribute('data-daily-rotate-day', String(dayNumber));

        var items = Array.from(container.querySelectorAll('[data-product-slug]'));
        if (items.length <= 1) return;

        var slugs = items.map(function(el) { return el.getAttribute('data-product-slug'); });
        var seed = getCategoryDaySeedClient(categorySlug, dayNumber);
        var rng = mulberry32Client(seed);

        var shuffledSlugs = slugs.slice();
        for (var i = shuffledSlugs.length - 1; i > 0; i--) {
          var j = Math.floor(rng() * (i + 1));
          var temp = shuffledSlugs[i];
          shuffledSlugs[i] = shuffledSlugs[j];
          shuffledSlugs[j] = temp;
        }

        var itemMap = new Map();
        items.forEach(function(el) {
          itemMap.set(el.getAttribute('data-product-slug'), el);
        });

        shuffledSlugs.forEach(function(slug) {
          var el = itemMap.get(slug);
          if (el) {
            container.appendChild(el);
          }
        });
      });
    }

    initDailyCategoryRotation();
    document.addEventListener('astro:page-load', initDailyCategoryRotation);
  </script>
  <!-- Hand Bouquet Section -->
  <HandBouquetSection />

  <!-- Bunga Papan Section -->
  <BungaPapanSection />

  <!-- Standing Flower Section -->
  <StandingFlowerSection />

  <!-- Paper Flower Section -->
  <PaperFlowerSection />

  <!-- Bunga Meja Section -->
  <BungaMejaSection />

  <!-- Tanbulampot Section -->
  <TanbulampotSection />

  <!-- Service Area Section -->
  <section class="py-20 bg-primary text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-secondary text-xs font-semibold uppercase tracking-widest block mb-2">Area Layanan Florist</span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold leading-tight">Pengiriman Karangan Bunga Area Malang Raya & Batu</h2>
          <p class="text-slate-300 text-sm mt-4 leading-relaxed">
            Floragate melayani pemesanan dan pengantaran bunga untuk wilayah Malang Raya secara menyeluruh. Dengan kurir lokal berpengalaman, kami memastikan karangan bunga Anda tiba tepat waktu dan dalam kondisi prima di lokasi tujuan.
          </p>
          <div class="grid grid-cols-2 gap-4 mt-8">
            <div class="flex items-center space-x-2 text-sm text-slate-200">
              <svg class="h-5 w-5 text-secondary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Kota Malang (Gratis Ongkir)</span>
            </div>
            <div class="flex items-center space-x-2 text-sm text-slate-200">
              <svg class="h-5 w-5 text-secondary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Kota Batu</span>
            </div>
            <div class="flex items-center space-x-2 text-sm text-slate-200">
              <svg class="h-5 w-5 text-secondary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Malang Utara (Singosari, Lawang)</span>
            </div>
            <div class="flex items-center space-x-2 text-sm text-slate-200">
              <svg class="h-5 w-5 text-secondary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Malang Selatan (Kepanjen, Bululawang)</span>
            </div>
          </div>
        </div>
        
        <!-- Interactive Service Area Map Visual Placeholder -->
        <div class="relative bg-primary-light border border-secondary/20 rounded-xl p-8 shadow-2xl flex flex-col justify-center space-y-6">
          <div class="text-center space-y-2">
            <div class="inline-flex p-3 bg-secondary/10 rounded-full text-secondary">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="font-serif text-xl font-bold">Punya Pertanyaan Khusus?</h3>
            <p class="text-xs text-slate-300 max-w-sm mx-auto">Tanyakan pada admin apakah alamat tujuan pengiriman Anda masuk dalam jangkauan gratis ongkos kirim kami.</p>
          </div>
          <a 
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=Halo%20Floragate,%20apakah%20pengiriman%20bunga%20ke%20alamat%20[Ketik%20Alamat]%20masuk%20gratis%20ongkir?`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full flex items-center justify-center px-4 py-3 bg-secondary text-primary font-semibold text-sm rounded-md hover:bg-secondary-light transition-colors duration-300"
          >
            Cek Ongkir via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

